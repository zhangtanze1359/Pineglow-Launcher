<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>VerifyHost</AssemblyName>
    <RootNamespace>VerifyHost</RootNamespace>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <!-- VerifyHost 用 <Compile Include> 直接编译 Pineglow.Launcher.Services 全部源文件，
         其中 ContentIconService.cs / NewsImageProxyService.cs 需要 SkiaSharp 命名空间。
         VerifyHost 只引用 Avalonia 核心包（不含 Avalonia.Desktop -> Avalonia.Skia 传递链），
         故需显式引用。版本与 dev/PineglowLauncher/packages.lock.json 中 Avalonia 解析出的
         SkiaSharp 3.119.4 保持一致，避免版本漂移。 -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Pineglow.Launcher.Models\**\*.cs" Link="Models\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Pineglow.Launcher.Services\**\*.cs" Link="Services\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
