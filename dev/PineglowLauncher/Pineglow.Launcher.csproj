<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <AssemblyName>Pineglow.Launcher</AssemblyName>
    <RootNamespace></RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- MSBuild Version 是程序集、文件和发布产物的唯一版本来源。 -->
    <!-- 2026-11-20：主线长期停在 1.0.0，而发布线已到 v1.0.5。发布要打 tag 并切分支，
         但主线版本号落后会让「照主线版本号推理」再次踩坑（v1.0.4 就踩过：计划写 1.0.0→1.0.4，
         基座其实是 1.0.3）。这里对齐到已发布的最新版本，release-notes 也补齐到 v1.0.5。 -->
    <!-- 2026-11-23：v1.0.6 候选。自 v1.0.5 起交付的新功能与修复见 release-notes/v1.0.6.md。 -->
    <!-- 2026-11-24：v1.0.8。用户反馈三连修 + S1/S2 数据安全 + 二次元 UI 焕新。
         详见 release-notes/v1.0.8.md。 -->
    <Version>1.0.8</Version>
    <!-- 保留现有可空注解并消除 CS8632；逐模块启用流分析。 -->
    <Nullable>annotations</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="VerifyHost\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <!-- R01：单文件发行必须自足。
       原生库（libSkiaSharp/libHarfBuzzSharp/av_libglesv2 等）默认**不会**进入 PublishSingleFile
       产物，它们会留在 publish 目录里，于是「只上传 EXE」的发布包缺少运行时依赖；
       实测单独 EXE 冷启动会以 DllNotFoundException 崩溃在 Skia 初始化。
       IncludeNativeLibrariesForSelfExtract 让这些原生库随单文件打包并在启动时自解压。 -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <!-- 发布目录只应有可执行文件：原生符号（libSkiaSharp.pdb 等）体积很大且不是运行依赖。
         **2026-10-06 实测更正**：即使 PublishSingleFile=true 且设了下面这个开关，
         发布目录里**仍然**会出现 libSkiaSharp.pdb(84MB) / libHarfBuzzSharp.pdb(20MB)。
         真正让发行物干净的是 release.yml「Assert artifact is a self-contained single EXE」
         里的 `Get-ChildItem dist -Filter *.pdb -File | Remove-Item`。
         所以：**手工 dotnet publish 会带出这 ~104MB 的 PDB**，别以为这个开关就够了。
         （本次实测同时确认这不是 DebugSymbols/DebugType 造成的：带与不带 /p:Version 的两次发布
          都带 PDB；而带不带 PDB 与 EXE 体积差异无关。） -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- R01：UI 静态资源嵌入程序集，单文件发行时由 UiBundle 按内容指纹解包后提供服务。 -->
    <EmbeddedResource Include="..\..\ui\**\*" Exclude="..\..\ui\tests\**\*" LogicalName="Pineglow.Launcher.Ui.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- 目录包 / 开发树：仍把 UI 复制到输出目录（单文件发行时由嵌入资源取代，避免发布目录里
         同时存在一个 EXE 和一份外置 UI/，那正是 R01 里「交付范围与运行依赖不一致」的来源）。 -->
    <Content Condition="'$(PublishSingleFile)' != 'true'" Include="..\..\ui\**\*" Exclude="..\..\ui\tests\**\*" Link="UI\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.0.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <Target Name="VerifySkinViewerResources" AfterTargets="Build" Condition="'$(PublishSingleFile)' != 'true'">
    <Error Condition="!Exists('$(TargetDir)UI\vendor\three.min.js')" Text="Missing Three.js in build output." />
    <Error Condition="!Exists('$(TargetDir)UI\vendor\THREE-LICENSE.txt')" Text="Missing Three.js license in build output." />
    <Error Condition="!Exists('$(TargetDir)UI\js\skin3d-core.js')" Text="Missing skin3d-core.js in build output." />
    <Error Condition="!Exists('$(TargetDir)UI\js\skin3d.js')" Text="Missing skin3d.js in build output." />
  </Target>
  <!-- 单文件发行没有外置 UI/ 目录：资源完整性由 EmbeddedResource 非空断言 + UiBundleTests 覆盖。
       UiBundleTests 会逐项断言入口 HTML/CSS/SVG/vendor 确实在嵌入清单里，并且嵌入的
       index.html 引用闭包可从包内解析——比在 MSBuild 里做字符串比较更可靠。 -->
  <Target Name="VerifyEmbeddedUiResources" AfterTargets="Build" Condition="'$(PublishSingleFile)' == 'true'">
    <Error Condition="'@(EmbeddedResource)' == ''" Text="单文件发行要求把 UI 嵌入程序集，但 EmbeddedResource 为空。" />
    <Message Importance="high" Text="R01: 单文件发行已嵌入 @(EmbeddedResource->Count()) 项 UI 资源（由 UiBundle 解包）。" />
  </Target>

  <!-- CurseForge API Key：构建期注入（OPEN-08，2026-11-24）
       ============================================================
       由来：此前 Key 以字面量硬编码在 CurseForgeKeyDefaults.cs，随源码公开分发。
       编排方要求「移除内嵌 Key」但不轮换、且不能让 CurseForge 下载失效。

       社区通例（已核对 Prism / basalt-launcher / OneLauncher 的源码）：
         - Prism：默认值写死在 CMakeLists.txt，编译进 BuildConfig，运行时可被用户覆盖
         - basalt-launcher：构建期从环境变量 BASALT_CURSEFORGE_API_KEY 读，cargo 注入
         - OneLauncher：编译期常量
       三家都把 Key 编进二进制（用户零配置），**没有一家改用代理服务**。
       其中 basalt 的做法最干净：**源码树里没有字面量，Key 只在构建环境里**。

       本项目采用 basalt 模式：
         - Key 来源：构建机环境变量 PINEGLOW_CURSEFORGE_BUILD_KEY（CI 在 Secrets 里配置）
         - 生成位置：$(IntermediateOutputPath) —— 即 obj/，不进源码树、不进版本库
         - Key 缺失时仍可编译：生成的常量为空串，运行期走"缺 Key 引导"

       代价（如实记录，不隐藏）：
         - 未配置该环境变量的本地构建，产物没有内置 Key，CurseForge 需用户自行配置
         - 正式发布必须在 CI 里配置该 secret，否则发布包同样缺 Key
       ============================================================ -->
  <PropertyGroup>
    <!-- 构建期 Key；空值合法（表示"这次构建不带内置 Key"）。
         直接读环境变量，而不是让 CI 再传 -p:，避免 Key 出现在进程命令行里（可被 ps/日志捕获）。 -->
    <CurseForgeBuildKey Condition="'$(CurseForgeBuildKey)' == ''">$(PINEGLOW_CURSEFORGE_BUILD_KEY)</CurseForgeBuildKey>
  </PropertyGroup>

  <!--
    把 Key 作为 AssemblyMetadata 注入程序集。

    为什么选这条路（而不是生成 .cs 文件）：
      WriteLinesToFile 在 .NET Framework 版 MSBuild 上不支持 WritingEncoding 参数，
      且它把分号当列表分隔符，生成 C# 时 `;` 会被吞掉（本轮实测踩过两次）。
      AssemblyMetadata 由 MSBuild 原生产生，字符串参数无需手工转义，也没有分号问题。

    读取方式见 CurseForgeKeyDefaults：通过 Assembly.GetCustomAttributes 取回。
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"
                       Condition="'$(CurseForgeBuildKey)' != ''">
      <_Parameter1>PineglowCurseForgeApiKey</_Parameter1>
      <_Parameter2>$(CurseForgeBuildKey)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="ReportCurseForgeKey" BeforeTargets="CoreCompile">
    <!-- 日志只说"有/无"，绝不打印 Key 本身。 -->
    <Message Importance="high" Condition="'$(CurseForgeBuildKey)' == ''"
             Text="[curseforge-key] 构建机未提供 PINEGLOW_CURSEFORGE_BUILD_KEY：产物不含内置 Key，CurseForge 需用户自行配置。" />
    <Message Importance="high" Condition="'$(CurseForgeBuildKey)' != ''"
             Text="[curseforge-key] 已注入构建期 Key（长度 $(CurseForgeBuildKey.Length)），作为 AssemblyMetadata 写入程序集。" />
  </Target>
</Project>
