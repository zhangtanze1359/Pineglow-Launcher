using System;
using System.Collections.Concurrent;
using System.Diagnostics;

namespace Pineglow.Launcher.Services;

/// <summary>
/// MR03 收尾：服务端"实例正在运行"的注册表。
///
/// 为什么需要它：MR03 的验收要求"运行中的实例不得从列表移除"，但当时全仓**不存在**任何运行态记录 ——
/// <c>HandleLaunchAsync</c> 派发进程后不保留状态，因此那一轮只实现了 Bisect 活动守卫，
/// 并在报告里如实记为未达成项。本类补上这一块。
///
/// 设计要点：
///   - **自愈**：进程已经退出时顺手清掉条目。否则一次异常的退出监听就会留下陈旧条目，
///     永久挡住"从列表移除"——那是比"漏挡"更糟的失败模式；
///   - 不持有 <see cref="Process"/> 的强生命周期依赖：没有进程对象时按 PID 复查；
///   - 无法判定时**保守地认为仍在运行**（宁可多挡一次，也不要在游戏运行时把实例移走）。
/// </summary>
public static class RunningInstanceRegistry
{
	private sealed record Entry(int Pid, DateTimeOffset StartedAt, Process? Process, bool Launching);

	private static readonly ConcurrentDictionary<string, Entry> Running =
		new ConcurrentDictionary<string, Entry>(StringComparer.OrdinalIgnoreCase);

	/// <summary>当前登记在册的运行中实例数（不触发自愈清理）。</summary>
	public static int Count => Running.Count;

	/// <summary>启动成功后登记。重复登记同一实例以最后一次为准。</summary>
	public static void MarkRunning(string instanceId, Process process)
	{
		if (string.IsNullOrWhiteSpace(instanceId) || process == null)
		{
			return;
		}

		Running[instanceId] = new Entry(process.Id, DateTimeOffset.Now, process, Launching: false);
	}

	/// <summary>按 PID 登记（用于没有进程对象的路径与测试）。</summary>
	public static void MarkRunningPid(string instanceId, int pid)
	{
		if (string.IsNullOrWhiteSpace(instanceId) || pid <= 0)
		{
			return;
		}

		Running[instanceId] = new Entry(pid, DateTimeOffset.Now, null, Launching: false);
	}

	/// <summary>退出监听里调用：清掉条目。</summary>
	public static void MarkExited(string instanceId)
	{
		if (string.IsNullOrWhiteSpace(instanceId))
		{
			return;
		}

		Running.TryRemove(instanceId, out _);
	}

	/// <summary>
	/// 该实例是否正在运行。<paramref name="pid"/> 返回登记到的进程号（0 表示没有）。
	/// 进程已消失时会顺手清理条目（自愈）。
	/// </summary>
	public static bool IsRunning(string instanceId, out int pid)
	{
		pid = 0;
		if (string.IsNullOrWhiteSpace(instanceId))
		{
			return false;
		}

		if (!Running.TryGetValue(instanceId, out Entry? entry))
		{
			return false;
		}

		// 预约中（已占位但进程还没起来）：同样视为占用，否则第二次启动会挤进来。
		if (entry.Launching)
		{
			pid = 0;
			return true;
		}

		try
		{
			if (entry.Process != null)
			{
				if (entry.Process.HasExited)
				{
					Running.TryRemove(instanceId, out _);
					return false;
				}
			}
			else
			{
				using Process probe = Process.GetProcessById(entry.Pid);
				if (probe.HasExited)
				{
					Running.TryRemove(instanceId, out _);
					return false;
				}
			}
		}
		catch (ArgumentException)
		{
			// 进程不存在（PID 已回收或从未存在）→ 自愈
			Running.TryRemove(instanceId, out _);
			return false;
		}
		catch
		{
			// 无法判定（权限等）→ 保守地认为仍在运行，不放开守卫
		}

		pid = entry.Pid;
		return true;
	}

		/// <summary>
	/// 原子预约：把「检查该实例是否在运行」与「登记一个启动中占位」合并成一次原子操作。
	/// 原先 HandleLaunchAsync 是「先 IsRunning 再 MarkRunning」，两次并发请求之间存在窗口，
	/// 可能都通过检查 → 同一实例起两个游戏进程同时写同一份存档。现在只有一个请求能 TryAdd 成功。
	/// 返回 false 时 existingPid 给出占用者 PID（0 表示正在启动中、还没有 PID）。
	/// 调用方必须在启动失败时调用 AbortLaunch，否则该实例会被永久挡住。
	/// </summary>
	public static bool TryBeginLaunch(string instanceId, out int existingPid)
	{
		existingPid = 0;
		if (string.IsNullOrWhiteSpace(instanceId))
		{
			return false;
		}

		// 先自愈：进程已退出时 IsRunning 会顺手清掉条目，避免陈旧条目永久挡住启动
		if (IsRunning(instanceId, out existingPid))
		{
			return false;
		}

		// TryAdd 是原子的：只有当前没有条目才写入成功
		if (!Running.TryAdd(instanceId, new Entry(0, DateTimeOffset.Now, null, Launching: true)))
		{
			IsRunning(instanceId, out existingPid);
			return false;
		}

		return true;
	}

	/// <summary>
	/// 启动失败时释放预约。只释放「预约中」的条目：若已升级成真实进程登记，则不动它。
	/// </summary>
	public static void AbortLaunch(string instanceId)
	{
		if (string.IsNullOrWhiteSpace(instanceId))
		{
			return;
		}

		if (Running.TryGetValue(instanceId, out Entry? entry) && entry.Launching)
		{
			Running.TryRemove(instanceId, out _);
		}
	}
public static bool IsRunning(string instanceId) => IsRunning(instanceId, out _);

	/// <summary>测试缝：直接登记一个 PID（通常用测试进程自己的 PID，保证"活着"）。</summary>
	internal static void MarkRunningForTest(string instanceId, int pid) => MarkRunningPid(instanceId, pid);

	/// <summary>测试缝：清空注册表。</summary>
	internal static void ResetForTest() => Running.Clear();
}
