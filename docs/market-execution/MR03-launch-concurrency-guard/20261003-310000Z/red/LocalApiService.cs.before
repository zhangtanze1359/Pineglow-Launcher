	private static async Task HandleUploadSkinAsync(HttpListenerRequest request, HttpListenerResponse response)
	{
		JsonDocument body = await ReadBodyAsync(request);
		string pngBase64 = JsonUtil.GetString(body.RootElement, "pngBase64")?.Trim() ?? string.Empty;
		bool slim = body.RootElement.TryGetProperty("slim", out JsonElement slimEl) && slimEl.ValueKind == JsonValueKind.True;
		string accountId = JsonUtil.GetString(body.RootElement, "accountId")?.Trim() ?? string.Empty;
		if (string.IsNullOrWhiteSpace(pngBase64))
		{
			throw new InvalidOperationException("pngBase64 不能为空");
		}

		AppConfig config = LoadConfig();
		LauncherAccount account = string.IsNullOrWhiteSpace(accountId)
			? AccountService.GetSelected(config)
			: config.Accounts.FirstOrDefault(x => x.Id == accountId);
		if (account == null)
		{
			throw new InvalidOperationException("请先登录一个账号");
		}

		if (!account.IsMicrosoft)
		{
			throw new InvalidOperationException("皮肤上传仅支持 Microsoft 正版账号");
		}

		string clientId = !string.IsNullOrWhiteSpace(account.ClientId) ? account.ClientId : AuthClientOptions.ResolveMicrosoftClientId();
		string refreshToken = SecretStore.Load(SecretStore.AccountToken(account.Id));
		if (string.IsNullOrWhiteSpace(refreshToken))
		{
			refreshToken = SecretStore.Load(SecretStore.MicrosoftAccountToken(account.Id));
		}

		if (string.IsNullOrWhiteSpace(refreshToken))
		{
			throw new InvalidOperationException("账号刷新凭据缺失，请重新登录 Microsoft 账号");
		}

		MicrosoftAuthService authService = new MicrosoftAuthService(ApiHttp);
		using CancellationTokenSource cts = new CancellationTokenSource(TimeSpan.FromSeconds(60));
		MinecraftAccount mc = await authService.LoginWithRefreshTokenAsync(clientId, refreshToken, cts.Token);

		string tempDir = Path.Combine(Path.GetTempPath(), "pineglow-skin-" + Guid.NewGuid().ToString("N"));
		Directory.CreateDirectory(tempDir);
		string pngPath = Path.Combine(tempDir, "skin.png");
		try
		{
			byte[] bytes;
			try
			{
				bytes = Convert.FromBase64String(pngBase64);
			}
			catch (FormatException)
			{
				throw new InvalidOperationException("皮肤文件不是有效的 base64 数据");
			}
			if (bytes.Length > SkinImageProxyService.MaxBytes) throw new InvalidOperationException("皮肤图片超过 1 MiB 上限");
			if (!SkinImageProxyService.TryReadPngDimensions(bytes, out _, out _)) throw new InvalidOperationException("皮肤图片必须是 64×64 或 64×32 PNG");

			await File.WriteAllBytesAsync(pngPath, bytes);
			MinecraftAppearance appearance = await authService.UploadSkinAsync(mc.AccessToken, pngPath, slim, cts.Token);
			account.SkinUrl = appearance.SkinUrl;
			account.SkinModel = appearance.IsSlim || slim ? "slim" : "classic";
			account.SkinCount = appearance.SkinCount;
			account.CapeCount = appearance.CapeCount;
			account.Capes = appearance.Capes;
			SaveConfig(config);
			await WriteJsonAsync(response, 200, new { ok = true, account = BuildAccountSummary(account) });
		}
		finally
		{
			if (Directory.Exists(tempDir))
			{
				Directory.Delete(tempDir, recursive: true);
			}
		}
	}

	private static async Task HandleListModsAsync(HttpListenerResponse response, string instanceId)
	{
		AppConfig config = LoadConfig();
		GameInstance instance = RequireInstance(config, instanceId);
		string gameDir = ResolveGameDirectory(config, instance);
		List<ModFile> mods = await new ModService(gameDir).GetModsAsync(instance);
		await WriteJsonAsync(response, 200, new { instanceId, mods = mods.Select(BuildModSummary) });
	}

	private static object BuildModSummary(ModFile m)
	{
		return new
		{
			m.FileName,
			m.FullPath,
			m.SizeBytes,
			m.SizeText,
			m.IsEnabled,
			m.LastModifiedTime,
			m.DisplayName,
			m.ModId,
			m.Version,
			m.LoaderHint,
			m.Summary,
			m.OnlineSource,
			m.ProjectId,
			m.VersionId,
			m.OnlineVersionNumber,
			m.HasOnlineMetadata,
			dependencies = m.Dependencies?.Select(d => new { d.ModId, d.VersionRange, isRequired = d.IsRequired })
		};
	}

	private static async Task HandleToggleModAsync(HttpListenerResponse response, string instanceId, string fileName)
	{
		RejectManualModEditDuringBisect(instanceId);
		AppConfig config = LoadConfig();
		GameInstance instance = RequireInstance(config, instanceId);
		string gameDir = ResolveGameDirectory(config, instance);
		ModService service = new ModService(gameDir);
		ModFile mod = (await service.GetModsAsync(instance)).FirstOrDefault(x => x.FileName == fileName)
			?? throw new InvalidOperationException("Mod 不存在：" + fileName);
		if (mod.IsEnabled)
		{
			service.DisableMod(mod);
		}
		else
		{
			service.EnableMod(mod);
		}

		await WriteJsonAsync(response, 200, new { ok = true, fileName, isEnabled = !mod.IsEnabled });
	}

	/// <summary>
	/// MR04：删除 Mod 改为「移入恢复区」。jar 与 <c>.mcmini.json</c> 侧车作为同一次操作隔离，
	/// 返回 operationId 供用户在恢复区还原。此实现路径**不存在任何 File.Delete**。
	/// 逐项失败会被如实抛出，不会把"没删掉"报成成功。
	/// </summary>
	private static async Task HandleDeleteModAsync(HttpListenerResponse response, string instanceId, string fileName)
	{
		RejectManualModEditDuringBisect(instanceId);
		AppConfig config = LoadConfig();
		GameInstance instance = RequireInstance(config, instanceId);
		string gameDir = ResolveGameDirectory(config, instance);
		ModService service = new ModService(gameDir);
		ModFile mod = (await service.GetModsAsync(instance)).FirstOrDefault(x => x.FileName == fileName)
			?? throw new InvalidOperationException("Mod 不存在：" + fileName);

		var targets = new List<string> { mod.FullPath };
		string sidecar = mod.FullPath + ".mcmini.json";
		if (File.Exists(sidecar))
		{
			targets.Add(sidecar);
		}

		FileRecoveryRecord record = await CreateRecoveryService()
			.QuarantineAsync(instanceId, gameDir, "mod-delete", targets);

		FileRecoveryEntry[] failed = record.Files.Where(x => x.State == "failed").ToArray();
		if (failed.Length > 0 || !record.Files.Any(x => x.State == "quarantined"))
		{
			throw new InvalidOperationException(
				"删除未能完全隔离，文件仍保留在原处：" +
				string.Join("；", record.Files.Select(x => x.RelativePath + " → " + (x.Error ?? x.State))));
		}

		await WriteJsonAsync(response, 200, new
		{
			ok = true,
			fileName,
			operationId = record.OperationId,
			recoverable = true,
			status = record.Status,
			files = record.Files.Select(x => new { x.RelativePath, x.State, x.Sha256, x.SizeBytes })
		});
	}

	/// <summary>MR04：列出该实例恢复区的记录（只读，不触碰游戏文件）。</summary>
	private static async Task HandleListRecoveryAsync(HttpListenerResponse response, string instanceId)
	{
		AppConfig config = LoadConfig();
		RequireInstance(config, instanceId);

		List<FileRecoveryRecord> records = await CreateRecoveryService().ListAsync(instanceId);
		await WriteJsonAsync(response, 200, new
		{
			instanceId,
			retentionDays = FileRecoveryService.DefaultRetentionDays,
			recoveries = records.Select(r => new
			{
				r.OperationId,
				r.Reason,
				r.Status,
				r.CreatedAt,
				expiresAt = FileRecoveryService.GetExpiresAt(r),
				totalBytes = r.Files.Sum(f => f.SizeBytes),
				files = r.Files.Select(f => new { f.RelativePath, f.State, f.Sha256, f.SizeBytes, f.Error })
			})
		});
	}

	/// <summary>
	/// MR04 / MR05：把一次隔离操作的文件恢复到原位置。
	/// 默认**不覆盖**同名现有文件；撤销一次替换（MR05）时客户端显式传 <c>{"overwrite":true}</c>。
	/// </summary>
	private static async Task HandleRestoreRecoveryAsync(HttpListenerRequest request, HttpListenerResponse response, string instanceId, string operationId)
	{
		AppConfig config = LoadConfig();
		RequireInstance(config, instanceId);

		FileRecoveryService service = CreateRecoveryService();
		FileRecoveryRecord? record = await service.LoadAsync(instanceId, operationId);
		if (record == null)
		{
			throw new InvalidOperationException("恢复记录不存在或不可读：" + operationId);
		}

		bool overwrite = false;
		if (request.HasEntityBody)
		{
			try
			{
				JsonDocument body = await ReadBodyAsync(request);
				overwrite = body.RootElement.TryGetProperty("overwrite", out JsonElement el)
					&& el.ValueKind == JsonValueKind.True;
			}
			catch
			{
				// 空 body 或非 JSON 时按默认（不覆盖）处理，不因为解析失败就放行覆盖。
			}
		}

		FileRecoveryRecord restored = await service.RestoreAsync(record, overwrite);
		bool allOk = restored.Files.All(f => f.State == "restored" || f.State == "already_restored");

		await WriteJsonAsync(response, 200, new
		{
			ok = allOk,
			operationId = restored.OperationId,
			status = restored.Status,
			overwrite,
			conflicts = restored.Files.Count(f => f.State == "conflict"),
			files = restored.Files.Select(f => new { f.RelativePath, f.State, f.Sha256, f.Error })
		});
	}

	/// <summary>
	/// MR05：替换/更新一个 Mod。新包以 base64 传入，先落到 staging 并核对 SHA256，
	/// 校验通过后才进入事务（隔离旧包 → 写新包 → 写元数据），任何一步失败都回滚到旧版本。
	/// 旧文件若处于禁用态（<c>.jar.disabled</c>），新版本同样保持禁用。
	/// </summary>
	private static async Task HandleReplaceModAsync(HttpListenerRequest request, HttpListenerResponse response, string instanceId, string fileName)
	{
		RejectManualModEditDuringBisect(instanceId);
		JsonDocument body = await ReadBodyAsync(request);
		string newFileBase64 = JsonUtil.GetString(body.RootElement, "newFileBase64")?.Trim() ?? string.Empty;
		string expectedSha256 = JsonUtil.GetString(body.RootElement, "expectedSha256")?.Trim() ?? string.Empty;
		if (string.IsNullOrWhiteSpace(newFileBase64))
		{
			throw new InvalidOperationException("newFileBase64 不能为空");
		}

		AppConfig config = LoadConfig();
		GameInstance instance = RequireInstance(config, instanceId);
		string gameDir = ResolveGameDirectory(config, instance);

		byte[] bytes;
		try
		{
			bytes = Convert.FromBase64String(newFileBase64);
		}
		catch (FormatException)
		{
			throw new InvalidOperationException("newFileBase64 不是合法的 base64");
		}

		string stagingDir = Path.Combine(Path.GetTempPath(), "pineglow-replace-" + Guid.NewGuid().ToString("N"));
		Directory.CreateDirectory(stagingDir);
		string stagedPath = Path.Combine(stagingDir, "staged.jar");
		try
		{
			await File.WriteAllBytesAsync(stagedPath, bytes);

			ModService modService = new ModService(gameDir);
			var replacement = new ModReplacementService(CreateRecoveryService());
			ModReplacementResult result = await replacement.ReplaceAsync(
				instance, modService, fileName, stagedPath,
				string.IsNullOrWhiteSpace(expectedSha256) ? null : expectedSha256);

			if (!result.Ok)
			{
				throw new InvalidOperationException($"[{result.Status}] {result.Error}");
			}

			await WriteJsonAsync(response, 200, new
			{
				ok = true,
				fileName = result.FileName,
				operationId = result.OperationId,
				status = result.Status,
				wasEnabled = result.WasEnabled,
				oldSha256 = result.OldSha256,
				newSha256 = result.NewSha256,
				undoHint = "如需撤销本次更新，对 operationId 调用 restore 并传 overwrite=true"
			});
		}
		finally
		{
			try
			{
				if (Directory.Exists(stagingDir))
				{
					Directory.Delete(stagingDir, recursive: true);
				}
			}
			catch
			{
			}
		}
	}


	/// <summary>MR06：同一实例的二分定位请求串行化——上一次还在处理时直接拒绝，而不是排队。</summary>
	private static readonly System.Collections.Concurrent.ConcurrentDictionary<string, byte> BisectInFlight =
		new System.Collections.Concurrent.ConcurrentDictionary<string, byte>(StringComparer.OrdinalIgnoreCase);

	private static bool TryBeginBisectOperation(string instanceId) => BisectInFlight.TryAdd(instanceId, 0);

	private static void EndBisectOperation(string instanceId) => BisectInFlight.TryRemove(instanceId, out _);

	internal static bool IsBisectOperationInFlightForTest(string instanceId) => BisectInFlight.ContainsKey(instanceId);

	internal static bool TryBeginBisectOperationForTest(string instanceId) => TryBeginBisectOperation(instanceId);

	internal static void EndBisectOperationForTest(string instanceId) => EndBisectOperation(instanceId);

	/// <summary>
	/// MR06：二分定位进行中时禁止对该实例手动改 Mod —— 两套写操作同时改名会让候选集合与磁盘不一致。
	/// </summary>
	private static void RejectManualModEditDuringBisect(string instanceId)
	{
		ModBisectSession? session = ModBisectService.Get(instanceId);
		if (session != null && !session.Finished)
		{
			throw new InvalidOperationException("该实例正在进行 Mod 二分定位，请先结束或放弃定位，再手动修改 Mod。");
		}
	}

	private static async Task HandleBisectStartAsync(HttpListenerResponse response, string instanceId)
	{
		if (!TryBeginBisectOperation(instanceId))
		{
			await WriteJsonAsync(response, 409, new { ok = false, error = "该实例正在处理上一个二分定位请求，请稍后再试。" });
			return;
		}

		try
		{
			AppConfig config = LoadConfig();
			GameInstance instance = RequireInstance(config, instanceId);
			string gameDir = ResolveGameDirectory(config, instance);
			string modsDir = Path.Combine(gameDir, "mods");
			ModService service = new ModService(gameDir);
			List<ModFile> allMods = await service.GetModsAsync(instance);
			List<ModFile> enabled = allMods.Where(x => x.IsEnabled).ToList();
			if (enabled.Count == 0)
			{
				throw new InvalidOperationException("当前没有启用的 Mod，无法开始二分定位。");
			}

			// MR07：有未完成的落盘记录时先恢复/继续，不允许直接开新一轮把它覆盖掉。
			BisectRecoveryRecord? pending = await CreateBisectStore().LoadAsync(instanceId);
			if (pending != null)
			{
				await WriteJsonAsync(response, 409, new
				{
					ok = false,
					error = "该实例有未完成的二分定位会话，请先选择「恢复原状态」或「继续上一有效轮」。",
					pending = true,
					sessionId = pending.SessionId,
					status = pending.Status
				});
				return;
			}

			// MR06：上一轮的文件操作没恢复完就不许开新一轮，否则会把未恢复的文件当成"新基线"。
			ModBisectSession? existing = ModBisectService.Get(instanceId);
			if (existing != null && existing.NeedsRecovery)
			{
				await WriteJsonAsync(response, 409, new
				{
					ok = false,
					error = "上一次定位的文件操作尚未恢复完成，请先「放弃」并确认恢复。",
					needsRecovery = true,
					recoveryError = existing.RecoveryError,
					files = existing.LastResults.Select(r => new { r.FileName, r.State, r.Error })
				});
				return;
			}

			ModBisectSession session = ModBisectService.GetOrStart(instanceId, enabled.Select(x => x.FileName));

			// MR07：先评估依赖有效性，再落盘禁用集合——依赖被破坏的一轮是无效测试。
			IReadOnlyList<string> half = session.DisableHalfForNextTest();
			(string validity, List<string> issues) = EvaluateRoundValidity(allMods, half);
			session.SetRoundValidity(validity, issues);
			if (session.RoundInvalid)
			{
				await PersistBisectAsync(instanceId, session, gameDir, modsDir);
				await WriteJsonAsync(response, 409, new
				{
					ok = false,
					roundInvalid = true,
					roundValidity = validity,
					issues,
					error = "本轮会禁用仍然启用的 Mod 的前置，属于无效测试，已中止。"
				});
				return;
			}

			List<ModBisectFileResult> results = ApplyBisectStep(service, session, modsDir, half);
			session.RecordStepResults(results);
			await PersistBisectAsync(instanceId, session, gameDir, modsDir);
			await RecordAppliedRoundAsync(instanceId, session.Step, half, null, session.RoundValidity, session.RoundIssues);

			if (session.NeedsRecovery)
			{
				await WriteBisectFailureAsync(response, session, "禁用半区失败，本轮未就绪。");
				return;
			}

			await WriteBisectSessionAsync(response, session);
		}
		finally
		{
			EndBisectOperation(instanceId);
		}
	}

	private static async Task HandleBisectTestAsync(HttpListenerRequest request, HttpListenerResponse response, string instanceId)
	{
		if (!TryBeginBisectOperation(instanceId))
		{
			await WriteJsonAsync(response, 409, new { ok = false, error = "该实例正在处理上一个二分定位请求，请稍后再试。" });
			return;
		}

		try
		{
			AppConfig config = LoadConfig();
			GameInstance instance = RequireInstance(config, instanceId);
			string gameDir = ResolveGameDirectory(config, instance);
			ModService service = new ModService(gameDir);
			string modsDir = Path.Combine(gameDir, "mods");
			List<ModFile> allMods = await service.GetModsAsync(instance);
			ModBisectSession session = ModBisectService.Get(instanceId)
				?? throw new InvalidOperationException("当前没有进行中的二分定位会话，请先开始。");

			JsonDocument body = await ReadBodyAsync(request);
			bool crashed = body.RootElement.TryGetProperty("crashed", out JsonElement crashedEl) && crashedEl.ValueKind == JsonValueKind.True;
			// MR07：先记下"这一轮问的是哪一轮"，反馈要落到对应轮次上。
			int answeredStep = session.Step;
			List<string> answeredHalf = session.DisabledHalf.ToList();

			// MR06：客户端应当带上它所回答的轮次；轮次对不上说明该轮已被推进（例如双击提交），
			// 直接拒绝而不是把它当成下一轮的答案——否则会错误收窄候选。
			if (body.RootElement.TryGetProperty("step", out JsonElement stepEl)
				&& stepEl.ValueKind == JsonValueKind.Number
				&& stepEl.TryGetInt32(out int clientStep)
				&& clientStep != session.Step)
			{
				await WriteJsonAsync(response, 409, new
				{
					ok = false,
					error = "该轮已经推进，请用最新一轮的状态重新提交。",
					step = session.Step,
					version = session.Version,
					waitingForReport = session.WaitingForReport,
					finished = session.Finished
				});
				return;
			}

			if (!session.TryReportTest(crashed, out string? rejected))
			{
				await WriteJsonAsync(response, 409, new
				{
					ok = false,
					error = rejected,
					needsRecovery = session.NeedsRecovery,
					recoveryError = session.RecoveryError,
					step = session.Step,
					waitingForReport = session.WaitingForReport,
					finished = session.Finished
				});
				return;
			}

			await RecordAppliedRoundAsync(instanceId, answeredStep, answeredHalf, crashed, session.RoundValidity, session.RoundIssues);

			if (!session.Finished)
			{
				IReadOnlyList<string> half = session.DisableHalfForNextTest();
				(string validity, List<string> issues) = EvaluateRoundValidity(allMods, half);
				session.SetRoundValidity(validity, issues);
				if (session.RoundInvalid)
				{
					await PersistBisectAsync(instanceId, session, gameDir, modsDir);
					await WriteJsonAsync(response, 409, new
					{
						ok = false,
						roundInvalid = true,
						roundValidity = validity,
						issues,
						error = "下一轮会禁用仍然启用的 Mod 的前置，属于无效测试，已中止。"
					});
					return;
				}

				List<ModBisectFileResult> results = ApplyBisectStep(service, session, modsDir, half);
				session.RecordStepResults(results);
				await PersistBisectAsync(instanceId, session, gameDir, modsDir);
				await RecordAppliedRoundAsync(instanceId, session.Step, half, null, session.RoundValidity, session.RoundIssues);
				if (session.NeedsRecovery)
				{
					await WriteBisectFailureAsync(response, session, "禁用半区失败，本轮未就绪。");
					return;
				}
			}
			else
			{
				List<ModBisectFileResult> restoreResults = RestoreBisectMods(service, modsDir, session);
				session.RecordRestoreResults(restoreResults);
				await PersistBisectAsync(instanceId, session, gameDir, modsDir);
				if (session.NeedsRecovery)
				{
					// 恢复没核对通过：保留会话与落盘记录，不把"完成"当成结束。
					await WriteBisectFailureAsync(response, session, "定位结束但恢复未完成，会话已保留。");
					return;
				}

				ModBisectService.Remove(instanceId);
				await CreateBisectStore().ClearAsync(instanceId);
			}

			await WriteBisectSessionAsync(response, session);
		}
		finally
		{
			EndBisectOperation(instanceId);
		}
	}

	private static async Task HandleBisectGiveUpAsync(HttpListenerResponse response, string instanceId)
	{
		if (!TryBeginBisectOperation(instanceId))
		{
			await WriteJsonAsync(response, 409, new { ok = false, error = "该实例正在处理上一个二分定位请求，请稍后再试。" });
			return;
		}

		try
		{
			AppConfig config = LoadConfig();
			GameInstance instance = RequireInstance(config, instanceId);
			string gameDir = ResolveGameDirectory(config, instance);
			ModService service = new ModService(gameDir);
			ModBisectSession session = ModBisectService.Get(instanceId)
				?? throw new InvalidOperationException("当前没有进行中的二分定位会话，请先开始。");

			string modsDir = Path.Combine(gameDir, "mods");
			session.GiveUp();
			List<ModBisectFileResult> results = RestoreBisectMods(service, modsDir, session);
			session.RecordRestoreResults(results);
			// MR07：恢复结果落盘——即使恢复失败，重启后也能从记录里继续恢复。
			await PersistBisectAsync(instanceId, session, gameDir, modsDir);

			if (session.NeedsRecovery)
			{
				// 恢复失败必须保留会话与落盘记录：否则恢复依据随会话一起消失，用户再也看不到哪些文件没回来。
				await WriteBisectFailureAsync(response, session, "恢复未完成，会话已保留以便重试。");
				return;
			}

			ModBisectService.Remove(instanceId);
			await CreateBisectStore().ClearAsync(instanceId);
			await WriteBisectSessionAsync(response, session);
		}
		finally
		{
			EndBisectOperation(instanceId);
		}
	}

	private static async Task WriteBisectFailureAsync(HttpListenerResponse response, ModBisectSession session, string message)
	{
		await WriteJsonAsync(response, 409, new
		{
			ok = false,
			error = string.IsNullOrWhiteSpace(session.RecoveryError) ? message : message + " " + session.RecoveryError,
			needsRecovery = session.NeedsRecovery,
			recoveryError = session.RecoveryError,
			finished = session.Finished,
			version = session.Version,
			step = session.Step,
			waitingForReport = session.WaitingForReport,
			files = session.LastResults.Select(r => new { r.FileName, r.State, r.Error })
		});
	}

	/// <summary>
	/// MR06：按会话指令禁用指定 Mod 半区，返回**逐文件结果**（applied/unchanged/failed）。
	/// 不再吞掉异常：失败带原因返回，由调用方决定是否冻结推进。
	/// </summary>
	private static List<ModBisectFileResult> ApplyBisectStep(ModService service, ModBisectSession session, string modsDir, IReadOnlyList<string> disableNames)
	{
		var results = new List<ModBisectFileResult>();
		if (session.Finished || disableNames.Count == 0)
		{
			return results;
		}

		foreach (string name in disableNames)
		{
			var result = new ModBisectFileResult { FileName = name };
			try
			{
				// 会话存的是 .jar 基准名；当前盘上可能已是 .jar.disabled
				string jarPath = Path.Combine(modsDir, name);
				string disabledPath = jarPath + ".disabled";
				if (File.Exists(jarPath))
				{
					service.DisableMod(new ModFile { FullPath = jarPath, FileName = name, IsEnabled = true });
					if (File.Exists(disabledPath) && !File.Exists(jarPath))
					{
						result.State = "applied";
					}
					else
					{
						result.State = "failed";
						result.Error = "禁用后文件未按预期改名";
					}
				}
				else if (File.Exists(disabledPath))
				{
					result.State = "unchanged"; // 已是禁用态，幂等
				}
				else
				{
					result.State = "failed";
					result.Error = "文件既不在启用态也不在禁用态";
				}
			}
			catch (Exception ex)
			{
				result.State = "failed";
				result.Error = ex.Message;
				LauncherLog.Error("[Bisect] disable " + name + " failed: " + ex.Message, ex);
			}

			results.Add(result);
		}

		return results;
	}

	/// <summary>
	/// MR06：把**本次会话禁用过**的 Mod 恢复为启用态，返回逐文件结果。
	/// 只遍历 <see cref="ModBisectSession.EnabledAtStart"/>，因此用户原本就禁用的 Mod 不会被误启用。
	/// </summary>
	private static List<ModBisectFileResult> RestoreBisectMods(ModService service, string modsDir, ModBisectSession session)
	{
		var results = new List<ModBisectFileResult>();
		foreach (string name in session.EnabledAtStart)
		{
			var result = new ModBisectFileResult { FileName = name };
			try
			{
				string jarPath = Path.Combine(modsDir, name);
				string disabledPath = jarPath + ".disabled";
				if (File.Exists(jarPath) && !File.Exists(disabledPath))
				{
					result.State = "unchanged"; // 本来就是启用态
				}
				else if (File.Exists(disabledPath) && !File.Exists(jarPath))
				{
					service.EnableMod(new ModFile { FullPath = disabledPath, FileName = name + ".disabled", IsEnabled = false });
					if (File.Exists(jarPath) && !File.Exists(disabledPath))
					{
						result.State = "applied";
					}
					else
					{
						result.State = "failed";
						result.Error = "启用后文件未按预期改名";
					}
				}
				else if (File.Exists(jarPath) && File.Exists(disabledPath))
				{
					result.State = "failed";
					result.Error = "启用态与禁用态文件同时存在，无法确定原状";
				}
				else
				{
					result.State = "failed";
					result.Error = "文件既不在启用态也不在禁用态";
				}
			}
			catch (Exception ex)
			{
				result.State = "failed";
				result.Error = ex.Message;
				LauncherLog.Error("[Bisect] restore " + name + " failed: " + ex.Message, ex);
			}

			results.Add(result);
		}

		return results;
	}

	/* ================= MR07：二分定位的落盘、恢复与依赖校验 ================= */

	/// <summary>
	/// MR07：把当前会话落盘（原子写入）。首次落盘记录基线 SHA 与启用状态；
	/// 之后只更新可变字段，保持"会话开始时"的事实不变。
	/// </summary>
	private static async Task<BisectRecoveryRecord> PersistBisectAsync(
		string instanceId, ModBisectSession session, string gameDir, string modsDir)
	{
		BisectRecoveryStore store = CreateBisectStore();
		BisectRecoveryRecord? record = await store.LoadAsync(instanceId);
		if (record == null || !string.Equals(record.SessionId, session.SessionId, StringComparison.OrdinalIgnoreCase))
		{
			record = new BisectRecoveryRecord
			{
				SessionId = session.SessionId,
				InstanceId = instanceId,
				GameDirectory = Path.GetFullPath(gameDir),
				CreatedAt = DateTimeOffset.UtcNow,
				EnabledAtStart = session.EnabledAtStart.ToList(),
				Baseline = new List<BisectBaselineFile>()
			};

			foreach (string name in session.EnabledAtStart)
			{
				string jarPath = Path.Combine(modsDir, name);
				bool exists = File.Exists(jarPath);
				record.Baseline.Add(new BisectBaselineFile
				{
					FileName = name,
					Enabled = true,
					Sha256 = exists ? FileRecoveryService.HashFile(jarPath) : string.Empty,
					SizeBytes = exists ? new FileInfo(jarPath).Length : 0
				});
			}
		}

		record.Status = session.NeedsRecovery ? "needsRecovery" : (session.Finished ? "finished" : "active");
		record.Candidates = session.Candidates.ToList();
		record.Step = session.Step;
		record.LastResults = session.LastResults
			.Select(r => new BisectFileResultRecord { FileName = r.FileName, State = r.State, Error = r.Error })
			.ToList();
		await store.SaveAsync(record);
		return record;
	}

	/// <summary>把一轮禁用集合与用户反馈追加到落盘记录（同一步只保留一条）。</summary>
	private static async Task RecordAppliedRoundAsync(
		string instanceId, int step, IReadOnlyList<string> disabled, bool? crashed, string validity, IReadOnlyList<string> issues)
	{
		BisectRecoveryStore store = CreateBisectStore();
		BisectRecoveryRecord? record = await store.LoadAsync(instanceId);
		if (record == null)
		{
			return;
		}

		BisectAppliedRound? round = record.Rounds.FirstOrDefault(r => r.Step == step);
		if (round == null)
		{
			round = new BisectAppliedRound { Step = step, Disabled = disabled.ToList(), Validity = validity, Issues = issues.ToList() };
			record.Rounds.Add(round);
		}

		if (crashed.HasValue)
		{
			round.Crashed = crashed;
		}

		await store.SaveAsync(record);
	}

	/// <summary>
	/// MR07：禁用某一半区之前的依赖检查。
	/// 如果某个**仍然启用**的 Mod 依赖了本轮要禁用的 Mod（按 jar manifest 的 mod id 映射），
	/// 那么这一轮禁用的后果是"缺前置崩溃"，与原始崩溃不是同一件事 → 本轮无效。
	/// </summary>
	private static (string Validity, List<string> Issues) EvaluateRoundValidity(
		IReadOnlyList<ModFile> allMods, IReadOnlyList<string> disableNames)
	{
		var issues = new List<string>();
		if (disableNames.Count == 0)
		{
			return ("ok", issues);
		}

		var idToFile = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
		foreach (ModFile mod in allMods)
		{
			if (!string.IsNullOrWhiteSpace(mod.ModId) && !idToFile.ContainsKey(mod.ModId))
			{
				idToFile[mod.ModId] = mod.FileName;
			}
		}

		var disabling = new HashSet<string>(disableNames, StringComparer.OrdinalIgnoreCase);
		bool dependencyBroken = false;
		bool unverifiable = false;

		foreach (ModFile mod in allMods)
		{
			if (disabling.Contains(mod.FileName))
			{
				continue; // 本轮被禁用的文件不构成"仍然启用的前提"
			}

			if (string.IsNullOrWhiteSpace(mod.ModId))
			{
				unverifiable = true;
				continue;
			}

			foreach (ModManifestDependency dep in mod.Dependencies.Where(d => d.IsRequired))
			{
				if (idToFile.TryGetValue(dep.ModId, out string? provider) && disabling.Contains(provider))
				{
					dependencyBroken = true;
					issues.Add($"{mod.FileName} 依赖前置 {dep.ModId}（{provider}），但本轮会禁用后者");
				}
			}
		}

		if (unverifiable)
		{
			issues.Add("部分仍然启用的 Mod 缺少 manifest 元数据，无法完整核对依赖");
		}

		if (dependencyBroken)
		{
			return ("invalid", issues);
		}

		return (issues.Count > 0 ? "limited" : "ok", issues);
	}

	/// <summary>
	/// MR07：把落盘记录与磁盘现状逐项比对。
	/// 只看**本会话管理过的文件**，不从文件名猜状态，也不碰用户后来加入的文件。
	/// </summary>
	private static List<object> BuildBisectConflicts(BisectRecoveryRecord record, string modsDir)
	{
		var conflicts = new List<object>();
		var expectedDisabled = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
		foreach (BisectAppliedRound round in record.Rounds)
		{
			foreach (string name in round.Disabled)
			{
				expectedDisabled.Add(name);
			}
		}

		bool expectRestored = string.Equals(record.Status, "finished", StringComparison.OrdinalIgnoreCase);

		foreach (string name in record.EnabledAtStart)
		{
			string jarPath = Path.Combine(modsDir, name);
			string disabledPath = jarPath + ".disabled";
			bool hasEnabled = File.Exists(jarPath);
			bool hasDisabled = File.Exists(disabledPath);

			string actual = (hasEnabled && hasDisabled) ? "ambiguous"
				: hasEnabled ? "enabled"
				: hasDisabled ? "disabled"
				: "missing";
			string expected = (!expectRestored && expectedDisabled.Contains(name)) ? "disabled" : "enabled";

			if (!string.Equals(actual, expected, StringComparison.OrdinalIgnoreCase))
			{
				conflicts.Add(new
				{
					fileName = name,
					expected,
					actual,
					detail = actual == "ambiguous"
						? "启用态与禁用态文件同时存在，无法确定原状"
						: $"期望 {expected}，实际 {actual}"
				});
			}
		}

		return conflicts;
	}

	/// <summary>MR07：查询该实例是否有未完成的二分定位会话（只读）。</summary>
	private static async Task HandleBisectPendingAsync(HttpListenerResponse response, string instanceId)
	{
		AppConfig config = LoadConfig();
		GameInstance instance = RequireInstance(config, instanceId);
		string gameDir = ResolveGameDirectory(config, instance);

		BisectRecoveryRecord? record = await CreateBisectStore().LoadAsync(instanceId);
		if (record == null)
		{
			await WriteJsonAsync(response, 200, new { ok = true, pending = false });
			return;
		}

		bool dirChanged = !string.Equals(
			Path.GetFullPath(record.GameDirectory), Path.GetFullPath(gameDir), StringComparison.OrdinalIgnoreCase);
		List<object> conflicts = dirChanged
			? new List<object>
			{
				new { fileName = "(实例目录)", expected = record.GameDirectory, actual = gameDir, detail = "实例的游戏目录与会话开始时不一致，拒绝按该记录恢复" }
			}
			: BuildBisectConflicts(record, Path.Combine(gameDir, "mods"));

		await WriteJsonAsync(response, 200, new
		{
			ok = true,
			pending = true,
			sessionId = record.SessionId,
			status = record.Status,
			gameDirectory = record.GameDirectory,
			createdAt = record.CreatedAt,
			updatedAt = record.UpdatedAt,
			step = record.Step,
			enabledAtStart = record.EnabledAtStart,
			candidates = record.Candidates,
			rounds = record.Rounds.Select(r => new { r.Step, r.Disabled, r.Crashed, r.Validity, r.Issues }),
			lastResults = record.LastResults.Select(r => new { r.FileName, r.State, r.Error }),
			conflicts,
			canRestore = !dirChanged,
			canContinue = !dirChanged && conflicts.Count == 0
				&& !string.Equals(record.Status, "finished", StringComparison.OrdinalIgnoreCase)
		});
	}

	/// <summary>
	/// MR07：重启后处理未完成的会话。
	///   restore  —— 只把本会话开始时启用的文件恢复为启用态（不启用用户原本禁用的 Mod、不删除新加入的文件）；
	///   continue —— 磁盘与记录逐项一致时才按记录重建会话，从上一有效轮继续。
	/// </summary>
	private static async Task HandleBisectResumeAsync(HttpListenerRequest request, HttpListenerResponse response, string instanceId)
	{
		JsonDocument body = await ReadBodyAsync(request);
		string action = (JsonUtil.GetString(body.RootElement, "action") ?? "restore").Trim().ToLowerInvariant();

		AppConfig config = LoadConfig();
		GameInstance instance = RequireInstance(config, instanceId);
		string gameDir = ResolveGameDirectory(config, instance);
		string modsDir = Path.Combine(gameDir, "mods");

		BisectRecoveryStore store = CreateBisectStore();
		BisectRecoveryRecord? record = await store.LoadAsync(instanceId);
		if (record == null)
		{
			throw new InvalidOperationException("没有未完成的二分定位记录。");
		}

		if (!string.Equals(Path.GetFullPath(record.GameDirectory), Path.GetFullPath(gameDir), StringComparison.OrdinalIgnoreCase))
		{
			await WriteJsonAsync(response, 409, new
			{
				ok = false,
				error = "实例的游戏目录与会话记录不一致，拒绝按该记录操作。",
				recordedDirectory = record.GameDirectory,
				currentDirectory = gameDir
			});
			return;
		}

		List<object> conflicts = BuildBisectConflicts(record, modsDir);

		if (action == "restore")
		{
			// 只处理 EnabledAtStart 里的文件：用户原本禁用的 Mod 保持禁用，后来加入的文件原样不动。
			ModService service = new ModService(gameDir);
			var results = new List<ModBisectFileResult>();
			foreach (string name in record.EnabledAtStart)
			{
				var result = new ModBisectFileResult { FileName = name };
				string jarPath = Path.Combine(modsDir, name);
				string disabledPath = jarPath + ".disabled";
				try
				{
					if (File.Exists(jarPath) && !File.Exists(disabledPath))
					{
						result.State = "unchanged";
					}
					else if (File.Exists(disabledPath) && !File.Exists(jarPath))
					{
						service.EnableMod(new ModFile { FullPath = disabledPath, FileName = name + ".disabled", IsEnabled = false });
						if (File.Exists(jarPath) && !File.Exists(disabledPath))
						{
							result.State = "applied";
						}
						else
						{
							result.State = "failed";
							result.Error = "启用后文件未按预期改名";
						}
					}
					else if (File.Exists(jarPath) && File.Exists(disabledPath))
					{
						result.State = "failed";
						result.Error = "启用态与禁用态文件同时存在";
					}
					else
					{
						result.State = "failed";
						result.Error = "文件既不在启用态也不在禁用态";
					}
				}
				catch (Exception ex)
				{
					result.State = "failed";
					result.Error = ex.Message;
				}

				results.Add(result);
			}

			bool ok = results.All(r => r.State != "failed");
			if (ok)
			{
				await store.ClearAsync(instanceId);
			}
			else
			{
				record.Status = "needsRecovery";
				record.LastResults = results
					.Select(r => new BisectFileResultRecord { FileName = r.FileName, State = r.State, Error = r.Error })
					.ToList();
				await store.SaveAsync(record);
			}

			await WriteJsonAsync(response, ok ? 200 : 409, new
			{
				ok,
				action,
				status = ok ? "restored" : "needsRecovery",
				files = results.Select(r => new { r.FileName, r.State, r.Error }),
				conflicts
			});
			return;
		}

		if (action == "continue")
		{
			if (conflicts.Count > 0)
			{
				await WriteJsonAsync(response, 409, new
				{
					ok = false,
					error = "磁盘状态与会话记录不一致，不能直接继续；请先按记录恢复。",
					conflicts
				});
				return;
			}

			BisectAppliedRound? last = record.Rounds.LastOrDefault();
			if (last == null)
			{
				await WriteJsonAsync(response, 409, new { ok = false, error = "记录里没有已应用的轮次，无法继续；请按记录恢复。" });
				return;
			}

			ModBisectSession restored = ModBisectSession.Restore(
				record.SessionId, instanceId, record.EnabledAtStart, record.Candidates, record.Step, last.Disabled);
			ModBisectService.Put(instanceId, restored);
			await WriteBisectSessionAsync(response, restored);
			return;
		}

		throw new InvalidOperationException("未知的恢复动作：" + action);
	}

	private static async Task WriteBisectSessionAsync(HttpListenerResponse response, ModBisectSession session)
	{
		await WriteJsonAsync(response, 200, new
		{
			ok = true,
			version = session.Version,
			sessionId = session.SessionId,
			roundInvalid = session.RoundInvalid,
			roundValidity = session.RoundValidity,
			roundIssues = session.RoundIssues,
			needsRecovery = session.NeedsRecovery,
			recoveryError = session.RecoveryError,
			lastResults = session.LastResults.Select(r => new { r.FileName, r.State, r.Error }),
			enabledAtStart = session.EnabledAtStart,
			candidates = session.Candidates,
			step = session.Step,
			waitingForReport = session.WaitingForReport,
			disabledHalf = session.DisabledHalf,
			culprit = session.Culprit,
			finished = session.Finished,
			finishReason = session.FinishReason
		});
	}
	private static async Task HandleListResourcePacksAsync(HttpListenerResponse response, string instanceId)
	{
		AppConfig config = LoadConfig();
		GameInstance instance = RequireInstance(config, instanceId);
		string gameDir = ResolveGameDirectory(config, instance);
		List<ResourcePackInfo> packs = new ResourcePackService(gameDir).GetResourcePacks(instance);
		await WriteJsonAsync(response, 200, new
		{
			instanceId,
			packs = packs.Select(p => new
			{
				p.FileName,
				p.FullPath,
				p.DisplayName,
				p.Description,
				p.PackFormat,
				p.SizeText,
				p.HasCover,
				cover = p.HasCover && p.CoverBytes != null ? "data:image/png;base64," + Convert.ToBase64String(p.CoverBytes) : null
			})
		});
	}

	private static async Task HandleListShaderPacksAsync(HttpListenerResponse response, string instanceId)
	{
		AppConfig config = LoadConfig();
		GameInstance instance = RequireInstance(config, instanceId);
		string gameDir = ResolveGameDirectory(config, instance);
		List<ShaderPackInfo> packs = new ShaderPackService(gameDir).GetPacks(instance);
		await WriteJsonAsync(response, 200, new { instanceId, packs = packs.Select(p => new { p.FileName, p.FullPath, p.SizeText }) });
	}

	private static object BuildAccountSummary(LauncherAccount a)
	{
		return new
		{
			a.Id,
			a.Type,
			a.UserName,
			a.Uuid,
			a.Xuid,
			a.AuthServerUrl,
			a.SkinUrl,
			a.SkinModel,
			a.SkinCount,
			a.CapeCount,
			a.Capes,
			a.AccessTokenExpiresAt,
			a.IsMicrosoft,
			a.IsThirdParty
		};
	}

	private static async Task HandleListAccountsAsync(HttpListenerResponse response)
	{
		AppConfig config = LoadConfig();
		await WriteJsonAsync(response, 200, new { accounts = config.Accounts.Select(BuildAccountSummary), selectedAccountId = config.SelectedAccountId });
	}

	private static async Task HandleAddOfflineAccountAsync(HttpListenerRequest request, HttpListenerResponse response)
	{
		JsonDocument body = await ReadBodyAsync(request);
		string userName = JsonUtil.GetString(body.RootElement, "userName")?.Trim();
		if (string.IsNullOrWhiteSpace(userName))
		{
			throw new InvalidOperationException("玩家名不能为空");
		}

		AppConfig config = LoadConfig();
		LauncherAccount account = AccountService.AddOffline(config, userName);
		AccountService.Select(config, account.Id);
		SaveConfig(config);
		await WriteJsonAsync(response, 200, new { ok = true, account = BuildAccountSummary(account) });
	}

	private static async Task HandleDeleteAccountAsync(HttpListenerResponse response, string accountId)
	{
		AppConfig config = LoadConfig();
		if (config.Accounts.Count <= 1)
		{
			throw new InvalidOperationException("至少保留一个账号。");
		}
		LauncherAccount account = config.Accounts.FirstOrDefault(x => x.Id == accountId);
		if (account == null)
		{
			throw new InvalidOperationException("账号不存在：" + accountId);
		}
		config.Accounts.Remove(account);
		if (config.SelectedAccountId == accountId)
		{
			config.SelectedAccountId = config.Accounts[0].Id;
		}
		SecretStore.Save(SecretStore.AccountToken(accountId), null);
		SecretStore.Save(SecretStore.MicrosoftAccountToken(accountId), null);
		SaveConfig(config);
		await WriteJsonAsync(response, 200, new { ok = true, selectedAccountId = config.SelectedAccountId, accounts = config.Accounts.Select(BuildAccountSummary) });
	}

	private static async Task HandleAccountSkinImageAsync(HttpListenerResponse response, string accountId)
	{
		AppConfig config = LoadConfig();
		LauncherAccount account = config.Accounts.FirstOrDefault(x => x.Id == accountId);
		if (account == null)
		{
			await WriteJsonAsync(response, 404, new { error = "账号不存在" });
			return;
		}

		string skinUrl = (account.SkinUrl ?? string.Empty).Trim();
		if (string.IsNullOrWhiteSpace(skinUrl))
		{
			await WriteJsonAsync(response, 404, new { error = "该账号没有皮肤" });
			return;
		}

		using CancellationTokenSource cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
		byte[] bytes = await SkinImageProxyService.FetchAsync(skinUrl, cts.Token);
		response.Headers["X-Content-Type-Options"] = "nosniff";
		response.Headers["Content-Security-Policy"] = "default-src 'none'";
		response.Headers["Cache-Control"] = "private, max-age=300";
		response.Headers["Referrer-Policy"] = "no-referrer";
		response.ContentType = "image/png";
		response.ContentLength64 = bytes.Length;
		await response.OutputStream.WriteAsync(bytes, 0, bytes.Length);
	}

	private static async Task HandleRefreshSkinAsync(HttpListenerRequest request, HttpListenerResponse response)
	{
		JsonDocument body = await ReadBodyAsync(request);
		string accountId = JsonUtil.GetString(body.RootElement, "accountId")?.Trim() ?? string.Empty;
		if (string.IsNullOrWhiteSpace(accountId))
		{
			throw new InvalidOperationException("accountId 不能为空");
		}

		AppConfig config = LoadConfig();
		LauncherAccount account = config.Accounts.FirstOrDefault(x => x.Id == accountId);
		if (account == null)
		{
			throw new InvalidOperationException("账号不存在：" + accountId);
		}
		if (!account.IsThirdParty)
		{
			throw new InvalidOperationException("仅外置登录（皮肤站）账号支持刷新皮肤");
		}
		if (string.IsNullOrWhiteSpace(account.AuthServerUrl) || string.IsNullOrWhiteSpace(account.Uuid))
		{
			throw new InvalidOperationException("该账号缺少认证服务地址或角色 UUID，无法刷新皮肤");
		}

		string accessToken = account.AccessToken;
		if (string.IsNullOrWhiteSpace(accessToken))
		{
			accessToken = SecretStore.Load(SecretStore.AccountToken(account.Id));
		}
		if (string.IsNullOrWhiteSpace(accessToken))
		{
			throw new InvalidOperationException("缺少外置登录令牌，请重新登录该账号");
		}

		// 从认证根地址推导 sessionserver profile 地址
		string baseUrl = account.AuthServerUrl.Trim().TrimEnd('/');
		string profileUrl = baseUrl + "/sessionserver/session/minecraft/profile/" + account.Uuid;

		string skinUrl = string.Empty;
		string capeUrl = string.Empty;
		bool isSlim = false;
		using (CancellationTokenSource cts = new CancellationTokenSource(TimeSpan.FromSeconds(30)))
		using (HttpRequestMessage req = new HttpRequestMessage(HttpMethod.Get, profileUrl))
		{
			req.Headers.TryAddWithoutValidation("Authorization", "Bearer " + accessToken);
			using (HttpResponseMessage resp = await ApiHttp.SendAsync(req, cts.Token))
			{
				string text = await resp.Content.ReadAsStringAsync(cts.Token);
				if (!resp.IsSuccessStatusCode)
				{
					throw new InvalidOperationException("拉取皮肤站 profile 失败：" + resp.StatusCode + " " + text.Substring(0, Math.Min(200, text.Length)));
				}
				using (JsonDocument doc = JsonDocument.Parse(text))
				{
					JsonElement root = doc.RootElement;
					if (root.TryGetProperty("properties", out JsonElement properties) && properties.ValueKind == JsonValueKind.Array)
					{
						foreach (JsonElement p in properties.EnumerateArray())
						{
							if (p.TryGetProperty("name", out JsonElement pName) && pName.GetString() == "textures" &&
								p.TryGetProperty("value", out JsonElement pValue))
							{
								try
								{
									string texturesJson = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(pValue.GetString() ?? string.Empty));
									using (JsonDocument texDoc = JsonDocument.Parse(texturesJson))
									{
										if (texDoc.RootElement.TryGetProperty("textures", out JsonElement texRoot))
										{
											if (texRoot.TryGetProperty("SKIN", out JsonElement skin) && skin.TryGetProperty("url", out JsonElement skinUrlEl))
											{
												skinUrl = skinUrlEl.GetString() ?? string.Empty;
											isSlim = skin.TryGetProperty("metadata", out JsonElement meta) && meta.TryGetProperty("model", out JsonElement modelEl) && modelEl.GetString() == "slim";
											}
											if (texRoot.TryGetProperty("CAPE", out JsonElement cape) && cape.TryGetProperty("url", out JsonElement capeUrlEl))
											{
												capeUrl = capeUrlEl.GetString() ?? string.Empty;
											}
										}
									}
								}
								catch
								{
									// textures 解析失败不影响整体刷新
								}
							}
						}
					}
				}
			}
		}

		account.SkinUrl = skinUrl;
		account.SkinModel = isSlim ? "slim" : "classic";
		account.SkinCount = string.IsNullOrWhiteSpace(skinUrl) ? 0 : 1;
		account.CapeCount = string.IsNullOrWhiteSpace(capeUrl) ? 0 : 1;
		account.Capes = new List<MinecraftCapeInfo>();
		if (!string.IsNullOrWhiteSpace(capeUrl))
		{
			account.Capes.Add(new MinecraftCapeInfo { Url = capeUrl, IsActive = false });
		}
		SaveConfig(config);
		// 回写令牌，避免下次启动丢失
		if (!string.IsNullOrWhiteSpace(accessToken))
		{
			SecretStore.Save(SecretStore.AccountToken(account.Id), accessToken);
		}
		await WriteJsonAsync(response, 200, new { ok = true, account = BuildAccountSummary(account) });
	}

	private static async Task HandleSelectAccountAsync(HttpListenerRequest request, HttpListenerResponse response)
	{
		JsonDocument body = await ReadBodyAsync(request);
		string accountId = JsonUtil.GetString(body.RootElement, "accountId");
		AppConfig config = LoadConfig();
		if (config.Accounts.All(x => x.Id != accountId))
		{
			throw new InvalidOperationException("账号不存在：" + accountId);
		}

		AccountService.Select(config, accountId);
		SaveConfig(config);
		await WriteJsonAsync(response, 200, new { ok = true, selectedAccountId = accountId });
	}

	private sealed class MicrosoftDeviceSession
	{
		public string ClientId = string.Empty;
		public DeviceCodeInfo DeviceCode = new DeviceCodeInfo();
		public DateTimeOffset CreatedAt = DateTimeOffset.Now;
		public bool Completed;
	}

	private static readonly object MicrosoftDeviceGate = new object();
	private static readonly Dictionary<string, MicrosoftDeviceSession> MicrosoftDeviceSessions = new Dictionary<string, MicrosoftDeviceSession>();

	private static async Task HandleMicrosoftLoginAsync(HttpListenerResponse response)
	{
		string clientId = AuthClientOptions.ResolveMicrosoftClientId();
		if (!AuthClientOptions.HasUsableMicrosoftClientId(clientId))
		{
			await WriteJsonAsync(response, 400, new { ok = false, message = "未配置 Microsoft Client ID，请设置环境变量 " + AuthClientOptions.ClientIdEnvironmentVariable + " 或配置文件 MicrosoftClientId。" });
			return;
		}

		MicrosoftAuthService authService = new MicrosoftAuthService(ApiHttp);
		try
		{
			// 兼容旧调用：直接创建设备码会话，返回用户代码
			DeviceCodeInfo deviceCode = await authService.CreateDeviceCodeAsync(clientId, CancellationToken.None);
			MicrosoftDeviceSession session = new MicrosoftDeviceSession
			{
				ClientId = clientId,
				DeviceCode = deviceCode,
				CreatedAt = DateTimeOffset.Now
			};
			lock (MicrosoftDeviceGate)
			{
				MicrosoftDeviceSessions[clientId] = session;
			}
			await WriteJsonAsync(response, 200, new
			{
				ok = true,
				userCode = deviceCode.UserCode,
				verificationUri = deviceCode.VerificationUri,
				verificationUriComplete = deviceCode.VerificationUriComplete,
				expiresIn = deviceCode.ExpiresIn,
				interval = deviceCode.Interval
			});
		}
		catch (MinecraftAppRegistrationRequiredException ex)
		{
			await WriteJsonAsync(response, 400, new { ok = false, message = ex.Message });
		}
		catch (OperationCanceledException)
		{
			await WriteJsonAsync(response, 400, new { ok = false, message = "登录已取消或超时，请重试。" });
		}
		catch (Exception ex)
		{
			await WriteJsonAsync(response, 500, new { ok = false, message = "微软登录失败：" + ex.Message });
		}
	}

	/// <summary>创建设备码登录会话：返回 user_code 供用户到 microsoft.com/link 输入。</summary>
	private static async Task HandleMicrosoftDeviceStartAsync(HttpListenerResponse response)
	{
		string clientId = AuthClientOptions.ResolveMicrosoftClientId();
		if (!AuthClientOptions.HasUsableMicrosoftClientId(clientId))
		{
			await WriteJsonAsync(response, 400, new { ok = false, message = "未配置 Microsoft Client ID，请设置环境变量 " + AuthClientOptions.ClientIdEnvironmentVariable + " 或配置文件 MicrosoftClientId。" });
			return;
		}

		try
		{
			MicrosoftAuthService authService = new MicrosoftAuthService(ApiHttp);
			DeviceCodeInfo deviceCode = await authService.CreateDeviceCodeAsync(clientId, CancellationToken.None);
			MicrosoftDeviceSession session = new MicrosoftDeviceSession
			{
				ClientId = clientId,
				DeviceCode = deviceCode,
				CreatedAt = DateTimeOffset.Now
			};
			lock (MicrosoftDeviceGate)
			{
				MicrosoftDeviceSessions[clientId] = session;
			}
			await WriteJsonAsync(response, 200, new
			{
				ok = true,
				userCode = deviceCode.UserCode,
				verificationUri = deviceCode.VerificationUri,
				verificationUriComplete = deviceCode.VerificationUriComplete,
				expiresIn = deviceCode.ExpiresIn,
				interval = deviceCode.Interval
			});
		}
		catch (Exception ex)
		{
			await WriteJsonAsync(response, 500, new { ok = false, message = "无法创建微软登录码：" + ex.Message });
		}
	}

	/// <summary>轮询设备码登录结果：pending 表示继续等待，成功返回账号信息。</summary>
	private static async Task HandleMicrosoftDevicePollAsync(HttpListenerResponse response)
	{
		string clientId = AuthClientOptions.ResolveMicrosoftClientId();
		if (!AuthClientOptions.HasUsableMicrosoftClientId(clientId))
		{
			await WriteJsonAsync(response, 400, new { ok = false, message = "未配置 Microsoft Client ID。" });
			return;
		}

		MicrosoftDeviceSession session;
		lock (MicrosoftDeviceGate)
		{
			MicrosoftDeviceSessions.TryGetValue(clientId, out session);
		}
		if (session == null)
		{
			await WriteJsonAsync(response, 400, new { ok = false, error = "no_session", message = "登录会话不存在或已过期，请重新开始登录。" });
			return;
		}
		if (session.Completed)
		{
			await WriteJsonAsync(response, 200, new { ok = true, status = "completed", account = (object?)null });
			return;
		}

		try
		{
			MicrosoftAuthService authService = new MicrosoftAuthService(ApiHttp);
			MicrosoftOAuthToken oauth = await authService.PollDeviceCodeOnceAsync(clientId, session.DeviceCode, CancellationToken.None);
			session.Completed = true;
			MinecraftAccount account = await authService.LoginMinecraftAsync(oauth, CancellationToken.None);

			AppConfig config = LoadConfig();
			LauncherAccount launcherAccount = AccountService.UpsertMicrosoft(config, account, clientId);
			AccountService.Select(config, launcherAccount.Id);
			SaveConfig(config);
			await WriteJsonAsync(response, 200, new { ok = true, status = "completed", account = BuildAccountSummary(launcherAccount) });
		}
		catch (OperationCanceledException)
		{
			await WriteJsonAsync(response, 200, new { ok = false, status = "pending" });
		}
		catch (Exception ex)
		{
			await WriteJsonAsync(response, 200, new { ok = false, status = "failed", message = ex.Message });
		}
	}

	private static async Task HandleAuthlibLoginAsync(HttpListenerRequest request, HttpListenerResponse response)
	{
		JsonDocument body = await ReadBodyAsync(request);
		string serverUrl = JsonUtil.GetString(body.RootElement, "serverUrl")?.Trim() ?? string.Empty;
		string userName = JsonUtil.GetString(body.RootElement, "userName")?.Trim() ?? string.Empty;
		string password = JsonUtil.GetString(body.RootElement, "password") ?? string.Empty;
		if (string.IsNullOrWhiteSpace(serverUrl) || string.IsNullOrWhiteSpace(userName) || string.IsNullOrWhiteSpace(password))
		{
			throw new InvalidOperationException("请填写认证服务地址、账号和密码。");
		}

		using CancellationTokenSource cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
		AuthlibInjectorService authService = new AuthlibInjectorService(ApiHttp);
		AuthlibAccount authAccount = await authService.LoginAsync(serverUrl, userName, password, cts.Token);

		AppConfig config = LoadConfig();
		LauncherAccount account = AccountService.UpsertThirdParty(config, authAccount);
		AccountService.Select(config, account.Id);
		SaveConfig(config);
		await WriteJsonAsync(response, 200, new { ok = true, account = BuildAccountSummary(account) });
	}

	private static void HandleOpenLogDirectory(HttpListenerResponse response)
	{
		string dir = LauncherLog.GetLogDirectory();
		if (string.IsNullOrWhiteSpace(dir) || !Directory.Exists(dir))
		{
			WriteJsonAsync(response, 400, new { ok = false, message = "日志目录不存在" }).GetAwaiter().GetResult();
			return;
		}

		try
		{
			if (OperatingSystem.IsWindows())
			{
				Process.Start(new ProcessStartInfo { FileName = "explorer.exe", Arguments = "\"" + dir + "\"", UseShellExecute = true });
			}
			else
			{
				Process.Start(new ProcessStartInfo { FileName = "xdg-open", Arguments = dir, UseShellExecute = true });
			}
			LauncherLog.Info("[logs] 已打开日志目录: " + dir);
			WriteJsonAsync(response, 200, new { ok = true, path = dir }).GetAwaiter().GetResult();
		}
		catch (Exception ex)
		{
			WriteJsonAsync(response, 500, new { ok = false, message = ex.Message }).GetAwaiter().GetResult();
		}
	}

	private static async Task HandleListVersionsAsync(HttpListenerResponse response)
	{
		AppConfig config = LoadConfig();
		string gameDir = ResolveGameDirectory(config, null);
		List<string> local = VersionResolver.ListLocalVersions(gameDir);
		await WriteJsonAsync(response, 200, new { gameDir, local });
	}

	private static async Task HandleListRemoteVersionsAsync(HttpListenerResponse response)
	{
		AppConfig config = LoadConfig();
		string gameDir = ResolveGameDirectory(config, null);
		using CancellationTokenSource cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
		List<VersionEntry> online = await new MinecraftDownloader(ApiHttp, _ => { }).FetchOnlineVersionsAsync(cts.Token);
		List<string> local = VersionResolver.ListLocalVersions(gameDir);
		await WriteJsonAsync(response, 200, new
		{
			gameDir,
			versions = online.Select(v => new { v.Id, v.Type, v.ReleaseTime, installed = local.Contains(v.Id) })
		});
	}

	private static async Task HandleDownloadVersionAsync(HttpListenerRequest request, HttpListenerResponse response)
	{
		JsonDocument body = await ReadBodyAsync(request);
		string versionId = JsonUtil.GetString(body.RootElement, "versionId")?.Trim();
		if (string.IsNullOrWhiteSpace(versionId))
		{
			throw new InvalidOperationException("versionId 不能为空");
		}

		AppConfig config = LoadConfig();
		string gameDir = ResolveGameDirectory(config, null);

		DownloadTaskEntry entry;
		lock (DownloadGate)
		{
			entry = new DownloadTaskEntry
			{
				Id = "dlv" + DateTimeOffset.Now.ToUnixTimeMilliseconds(),
				VersionId = versionId,
				Status = "queued",
				Message = "排队中",
				StartedAt = DateTimeOffset.Now
			};
			DownloadTasks.Add(entry);
		}

		_ = Task.Run(() => RunDownloadTaskAsync(entry, gameDir));
		await WriteJsonAsync(response, 200, new { ok = true, id = entry.Id, versionId, status = "queued" });
	}

	private static async Task RunDownloadTaskAsync(DownloadTaskEntry entry, string gameDir)
	{
		try
		{
			lock (DownloadGate)
			{
				entry.Status = "downloading";
				entry.Message = "正在获取版本元数据";
			}

			var downloader = new MinecraftDownloader(ApiHttp, msg =>
			{
				lock (DownloadGate)
				{
					entry.Message = msg;
				}
			}, progress =>
			{
				lock (DownloadGate)
				{
					entry.Progress = progress.Percentage;
					if (!string.IsNullOrWhiteSpace(progress.Message))
					{
						entry.Message = progress.Message;
					}
				}
			});

			await downloader.InstallVersionAsync(gameDir, entry.VersionId, CancellationToken.None);
			lock (DownloadGate)
			{
				entry.Status = "completed";
				entry.Progress = 1.0;
				entry.Message = "安装完成";
			}
		}
		catch (Exception ex)
		{
			lock (DownloadGate)
			{
				entry.Status = "failed";
				entry.Message = ex.Message;
			}
		}
	}

	private static async Task HandleListNewsAsync(HttpListenerRequest request, HttpListenerResponse response)
	{
		try
		{
			using CancellationTokenSource cts = new CancellationTokenSource(TimeSpan.FromSeconds(20));
			bool forceRefresh = string.Equals(request.QueryString["refresh"], "1", StringComparison.OrdinalIgnoreCase);
			NewsFetchResult result = await NewsService.FetchAsync(limit: 12, cts.Token, forceRefresh: forceRefresh);
			await WriteJsonAsync(response, 200, new
			{
				items = result.Items.Select(n => new
				{
					id = n.Id,
					title = n.Title,
					category = n.Category,
					date = n.Date,
					text = n.Text,
					imageId = RegisterNewsImage(n.ImageUrl),
					link = n.Link,
					linkOk = NewsEndpointPolicy.IsAllowedLink(n.Link),
					linkId = RegisterNewsLink(n.Link)
				}),
				meta = new
				{
					source = result.Source,
					state = NewsContentStateText.ToWire(result.State),
					validatedAt = result.ValidatedAt,
					fetchedAt = result.FetchedAt,
					isStale = result.IsStale,
					canRetry = result.CanRetry,
					errorKind = result.ErrorKind,
					error = result.Error
				}
			});
		}
		catch (Exception ex)
		{
			// 对外只暴露稳定错误元数据，不含堆栈与内部路径
			Debug.WriteLine("[LocalApi] news fetch error: " + ex.GetType().Name);
			await WriteJsonAsync(response, 200, new
			{
				items = new object[0],
				meta = new
				{
					source = LauncherContentNewsProvider.DefaultEndpoint.Replace("/news.json", string.Empty).Replace("https://", string.Empty),
					state = "error",
					validatedAt = DateTimeOffset.MinValue,
					fetchedAt = DateTimeOffset.MinValue,
					isStale = true,
					canRetry = true,
					errorKind = "internal",
					error = "news request failed"
				}
			});
		}
	}

	private static string? RegisterNewsImage(string imageUrl)
	{
		if (string.IsNullOrWhiteSpace(imageUrl))
		{
			return null;
		}

		return NewsImages.RegisterImageUrl(imageUrl);
	}

	/// <summary>
	/// R2-03：把新闻项的 link 注册到 NewsLinkService，返回稳定 linkId。
	/// 仅当 NewsEndpointPolicy.IsAllowedLink 放行时返回非空；非法/空链接返回 null。
	/// </summary>
	private static string? RegisterNewsLink(string? link)
	{
		if (string.IsNullOrWhiteSpace(link)) return null;
		// 二次门：仅在白名单内才生成 ID，与 /api/news 响应的 linkOk 保持一致
		if (!NewsEndpointPolicy.IsAllowedLink(link)) return null;
		return NewsLinks.RegisterLink(link);
	}

	/// <summary>
	/// R2-03：POST /api/news-open — 客户端只传 linkId；服务端取回 URL 后再次白名单校验，
	/// 通过才经受控 opener 打开已登记 URL。响应稳定 JSON，opener 失败 5xx 不泄露详情。
	/// </summary>
	private static async Task HandleNewsOpenAsync(HttpListenerRequest request, HttpListenerResponse response)
	{
		string body;
		try
		{
			using StreamReader reader = new StreamReader(request.InputStream, request.ContentEncoding ?? Encoding.UTF8);
			body = await reader.ReadToEndAsync();
		}
		catch (Exception ex)
		{
			Debug.WriteLine("[LocalApi] news-open read body error: " + ex.GetType().Name);
			await WriteJsonAsync(response, 400, new { error = "invalid_request" });
			return;
		}

		// 1) 严格 JSON 协议:body 必须是仅含精确 linkId 属性的对象
		//    协议要求(opener-failure-contract 返工 review-fix-2, 2026-09-10):
		//    - body 必须是对象
		//    - 仅允许一个属性 linkId(精确大小写)
		//    - linkId 必须是字符串且非空
		//    - 任何其他属性(包括 id / link_id / url / href / link / 重复 linkId / 大小写变体)
		//      或 linkId 非字符串/为空 → 400,opener 零调用
		string? linkId = null;
		try
		{
			using JsonDocument doc = JsonDocument.Parse(string.IsNullOrWhiteSpace(body) ? "{}" : body);
			JsonElement root = doc.RootElement;
			if (root.ValueKind != JsonValueKind.Object)
			{
				await WriteJsonAsync(response, 400, new { error = "invalid_body" });
				return;
			}
			int propertyCount = 0;
			foreach (JsonProperty prop in root.EnumerateObject())
			{
				propertyCount++;
				if (propertyCount > 1)
				{
					// 出现超过 1 个属性 → 直接 400(不区分具体多出来的属性)
					await WriteJsonAsync(response, 400, new { error = "invalid_body" });
					return;
				}
				if (!string.Equals(prop.Name, "linkId", StringComparison.Ordinal))
				{
					// 任何非精确 linkId 属性(包含 id / link_id / url / href / link / 任意其它)→ 400
					await WriteJsonAsync(response, 400, new { error = "invalid_body" });
					return;
				}
				if (prop.Value.ValueKind != JsonValueKind.String)
				{
					// linkId 必须是非空字符串
					await WriteJsonAsync(response, 400, new { error = "invalid_body" });
					return;
				}
				linkId = prop.Value.GetString();
			}
		}
		catch (JsonException)
		{
			await WriteJsonAsync(response, 400, new { error = "invalid_body" });
			return;
		}

		if (string.IsNullOrWhiteSpace(linkId))
		{
			await WriteJsonAsync(response, 400, new { error = "invalid_body" });
			return;
		}

		// 2) 业务级原子操作:单一调用覆盖 GetLinkUrl + 二次白名单 + opener
		//    (review-fix-3, 2026-09-10: 消除 LRU 淘汰/并发窗口的虚假 200)
		NewsLinkService.OpenOutcome outcome;
		try
		{
			outcome = NewsLinks.OpenOrFail(linkId);
		}
		catch (Exception ex)
		{
			Debug.WriteLine("[LocalApi] news-open opener error: " + ex.GetType().Name);
			// opener 异常 → 500,响应不暴露原始 URL / 异常堆栈 / 内部路径 / opener 消息文本
			await WriteJsonAsync(response, 500, new { error = "opener_failed" });
			return;
		}

		switch (outcome)
		{
			case NewsLinkService.OpenOutcome.Success:
				await WriteJsonAsync(response, 200, new { ok = true });
				return;
			case NewsLinkService.OpenOutcome.LinkNotFound:
				// 未知 / 篡改 / 过期 / 淘汰 / 竞态窗口 ID → 业务 404
				await WriteJsonAsync(response, 404, new { error = "link_not_found" });
				return;
			case NewsLinkService.OpenOutcome.LinkNoLongerAllowed:
				// 映射项不再通过白名单(策略被收紧):业务拒绝,映射项仍保留以利诊断
				await WriteJsonAsync(response, 400, new { error = "link_no_longer_allowed" });
				return;
		}
	}

	private static async Task HandleNewsImageAsync(HttpListenerRequest request, HttpListenerResponse response)
	{
		// Phase 3A：客户端只允许提交服务端注册的图片 ID，不再接受任意上游 URL
		string id = request.QueryString["id"] ?? string.Empty;
		if (string.IsNullOrWhiteSpace(id))
		{
			await WriteJsonAsync(response, 400, new { error = "imageId 不能为空" });
			return;
		}

		try
		{
			using CancellationTokenSource cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
			byte[] bytes = await NewsImages.FetchImageAsync(id, cts.Token);
			response.Headers["X-Content-Type-Options"] = "nosniff";
			response.Headers["Content-Security-Policy"] = "default-src 'none'";
			response.Headers["Cache-Control"] = "private, max-age=1800";
			response.Headers["Referrer-Policy"] = "no-referrer";
			response.ContentType = "application/octet-stream";
			response.ContentLength64 = bytes.Length;
			await response.OutputStream.WriteAsync(bytes, 0, bytes.Length);
		}
		catch (NewsImageException ex)
		{
			int status = ex.Kind switch
			{
				"unknown_image" => 404,
				"policy_rejected" or "dns_private" or "dns_mixed" or "dns_failed" or "mime_rejected" or "decode_rejected" or "size_rejected" or "redirect_limit" or "redirect_invalid" => 400,
				"timeout" => 504,
				_ => 502
			};
			await WriteJsonAsync(response, status, new { error = ex.Kind });
		}
		catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or TaskCanceledException)
		{
			await WriteJsonAsync(response, 502, new { error = "image fetch failed" });
		}
	}
	private static async Task HandleListDownloadsAsync(HttpListenerResponse response)
	{
		object[] snapshot;
		lock (DownloadGate)
		{
			snapshot = DownloadTasks.Select(t => new
			{
				t.Id,
				t.VersionId,
				name = "Minecraft " + t.VersionId + " 客户端",
				t.Status,
				t.Progress,
				t.Message,
				t.StartedAt
			}).ToArray();
		}

		await WriteJsonAsync(response, 200, new { tasks = snapshot });
	}

	/* ================= 自更新 ================= */

	private static async Task HandleCheckUpdateAsync(HttpListenerResponse response)
	{
		AppConfig config = LoadConfig();
		string url = config.UpdateUrl?.Trim() ?? string.Empty;
		if (string.IsNullOrWhiteSpace(url))
		{
			await WriteJsonAsync(response, 200, new { enabled = false, currentVersion = LauncherService.LauncherVersion, message = "未配置更新源（config.json 的 updateUrl）" });
			return;
		}

		try
		{
			UpdateManifest? manifest = await UpdateService.FetchManifestAsync(ApiHttp, url, CancellationToken.None);
			if (manifest == null || string.IsNullOrWhiteSpace(manifest.Version))
			{
				await WriteJsonAsync(response, 200, new { enabled = true, currentVersion = LauncherService.LauncherVersion, error = "更新服务器响应无效" });
				return;
			}
			bool available = UpdateService.IsNewerVersion(manifest.Version, LauncherService.LauncherVersion);
			LauncherLog.Info("[update] 检查更新：current=" + LauncherService.LauncherVersion + " latest=" + manifest.Version + " available=" + available);
			await WriteJsonAsync(response, 200, new
			{
				enabled = true,
				currentVersion = LauncherService.LauncherVersion,
				updateAvailable = available,
				latestVersion = manifest.Version,
				notes = manifest.Notes,
				mandatory = manifest.Mandatory,
				downloadUrl = manifest.Url
			});
		}
		catch (Exception ex)
		{
			LauncherLog.Error("[update] 检查更新失败: " + ex.Message, ex);
			await WriteJsonAsync(response, 200, new { enabled = true, currentVersion = LauncherService.LauncherVersion, error = ex.Message });
		}
	}

	private static async Task HandleStartUpdateDownloadAsync(HttpListenerResponse response)
	{
		bool alreadyDownloading;
		lock (UpdateGate)
		{
			alreadyDownloading = UpdateState == "downloading";
		}
		if (alreadyDownloading)
		{
			await WriteJsonAsync(response, 200, new { ok = true, state = "downloading" });
			return;
		}

		AppConfig config = LoadConfig();
		string url = config.UpdateUrl?.Trim() ?? string.Empty;
		if (string.IsNullOrWhiteSpace(url))
		{
			await WriteJsonAsync(response, 400, new { ok = false, message = "未配置更新源（config.json 的 updateUrl）" });
			return;
		}

		try
		{
			UpdateManifest? manifest = await UpdateService.FetchManifestAsync(ApiHttp, url, CancellationToken.None);
			if (manifest == null || string.IsNullOrWhiteSpace(manifest.Url))
			{
				await WriteJsonAsync(response, 400, new { ok = false, message = "更新服务器响应无效" });
				return;
			}
			lock (UpdateGate)
			{
				UpdateState = "downloading";
				UpdateProgress = 0.0;
				UpdateVersion = manifest.Version;
				UpdatePath = string.Empty;
				UpdateError = string.Empty;
				UpdateMandatory = manifest.Mandatory;
			}
			LauncherLog.Info("[update] 开始下载更新 v" + manifest.Version + " ← " + manifest.Url);
			_ = Task.Run(() => DownloadUpdateWorkerAsync(manifest));
			await WriteJsonAsync(response, 200, new { ok = true, state = "downloading", version = manifest.Version });
		}
		catch (Exception ex)
		{
			LauncherLog.Error("[update] 启动下载失败: " + ex.Message, ex);
			await WriteJsonAsync(response, 500, new { ok = false, message = ex.Message });
		}
	}

	private static async Task DownloadUpdateWorkerAsync(UpdateManifest manifest)
	{
		try
		{
			Progress<double> progress = new Progress<double>(value =>
			{
				lock (UpdateGate)
				{
					UpdateProgress = value;
				}
			});
			string path = await UpdateService.DownloadUpdateAsync(ApiHttp, manifest, progress, CancellationToken.None);
			lock (UpdateGate)
			{
				UpdateState = "completed";
				UpdatePath = path;
				UpdateProgress = 1.0;
			}
			LauncherLog.Info("[update] 下载完成: " + path);
		}
		catch (Exception ex)
		{
			LauncherLog.Error("[update] 下载失败: " + ex.Message, ex);
			lock (UpdateGate)
			{
				UpdateState = "failed";
				UpdateError = ex.Message;
			}
		}
	}

	private static async Task HandleUpdateStatusAsync(HttpListenerResponse response)
	{
		string state, version, path, error;
		double progress;
		bool mandatory;
		lock (UpdateGate)
		{
			state = UpdateState;
			version = UpdateVersion;
			path = UpdatePath;
			error = UpdateError;
			progress = UpdateProgress;
			mandatory = UpdateMandatory;
		}
		// MR20：把"上次替换脚本的结果"与信任链声明一并回给界面。
		// 界面**不能**因为"脚本已启动"就显示更新完成 —— 只有脚本写出 applied 才算替换成功。
		string updatesDir = Path.Combine(PlatformPaths.GetConfigDirectory(), "updates");
		UpdateService.ApplyResult? applyResult = UpdateService.ReadApplyResult(UpdateService.GetApplyStatePath(updatesDir));
		await WriteJsonAsync(response, 200, new
		{
			state,
			progress,
			version,
			path,
			error,
			mandatory,
			currentVersion = LauncherService.LauncherVersion,
			trustNote = UpdateService.TrustModelNote,
			lastApplyResult = applyResult == null ? null : new
			{
				result = applyResult.Result,
				applied = applyResult.Applied,
				version = applyResult.Version,
				writtenAtUtc = applyResult.WrittenAtUtc
			}
		});
	}

	private static async Task HandleApplyUpdateAsync(HttpListenerResponse response)
	{
		string path, version;
		lock (UpdateGate)
		{
			path = UpdatePath;
			version = UpdateVersion;
		}
		if (string.IsNullOrWhiteSpace(path) || !File.Exists(path))
		{
			await WriteJsonAsync(response, 400, new { ok = false, message = "更新包未就绪，请先下载。" });
			return;
		}

		try
		{
			UpdateService.ApplyUpdate(path, PlatformPaths.GetScriptExtension(), version);
			lock (UpdateGate)
			{
				UpdateState = "applying";
			}
			LauncherLog.Info("[update] 正在应用更新 v" + version + " → " + path);
			await WriteJsonAsync(response, 200, new { ok = true, message = "更新已启动，重启后生效。" });
			_ = Task.Run(async () =>
			{
				await Task.Delay(1200);
				Environment.Exit(0);
			});
		}
		catch (Exception ex)
		{
			LauncherLog.Error("[update] 应用更新失败: " + ex.Message, ex);
			await WriteJsonAsync(response, 500, new { ok = false, message = ex.Message });
		}
	}

	private static async Task HandleUpdateConfigAsync(HttpListenerRequest request, HttpListenerResponse response)
	{
		JsonDocument body = await ReadBodyAsync(request);
		JsonElement root = body.RootElement;
		AppConfig config = LoadConfig();
		PatchConfig(config, root);
		SaveConfig(config);
		await WriteJsonAsync(response, 200, new { ok = true });
	}

	private static void PatchConfig(AppConfig config, JsonElement root)
	{
		string GameDirectory = JsonUtil.GetString(root, "gameDirectory");
		if (GameDirectory != null) config.GameDirectory = GameDirectory;

		string javaPath = JsonUtil.GetString(root, "javaPath");
		if (javaPath != null) config.JavaPath = javaPath;

		string playerName = JsonUtil.GetString(root, "playerName");
		if (playerName != null) config.PlayerName = playerName;

		string selectedVersion = JsonUtil.GetString(root, "selectedVersion");
		if (selectedVersion != null) config.SelectedVersion = selectedVersion;

		string accountMode = JsonUtil.GetString(root, "accountMode");
		if (accountMode != null) config.AccountMode = accountMode;

		string serverHost = JsonUtil.GetString(root, "serverHost");
		if (serverHost != null) config.ServerHost = serverHost;

		string serverPort = JsonUtil.GetString(root, "serverPort");
		if (serverPort != null) config.ServerPort = serverPort;

		string curseForgeApiKey = JsonUtil.GetString(root, "curseForgeApiKey");
		if (curseForgeApiKey != null) config.CurseForgeApiKey = curseForgeApiKey;

		if (root.TryGetProperty("aiDiagnosisEnabled", out JsonElement aiEnabled) && aiEnabled.ValueKind == JsonValueKind.True)
		{
			config.AiDiagnosisEnabled = true;
		}
		else if (root.TryGetProperty("aiDiagnosisEnabled", out aiEnabled) && aiEnabled.ValueKind == JsonValueKind.False)
		{
			config.AiDiagnosisEnabled = false;
		}

		string selectedAiProviderId = JsonUtil.GetString(root, "selectedAiProviderId");
		if (selectedAiProviderId != null) config.SelectedAiProviderId = selectedAiProviderId;

		if (root.TryGetProperty("aiProviders", out JsonElement aiProvidersArr) && aiProvidersArr.ValueKind == JsonValueKind.Array)
		{
			PatchAiProviders(config, aiProvidersArr);
		}

		if (root.TryGetProperty("maxMemoryMb", out JsonElement maxMemory) && maxMemory.ValueKind == JsonValueKind.Number)
		{
			config.MaxMemoryMb = maxMemory.GetInt32();
		}

		if (root.TryGetProperty("useAutoMemory", out JsonElement useAuto) && useAuto.ValueKind == JsonValueKind.True)
		{
			config.UseAutoMemory = true;
		}
		else if (root.TryGetProperty("useAutoMemory", out useAuto) && useAuto.ValueKind == JsonValueKind.False)
		{
			config.UseAutoMemory = false;
		}

		if (root.TryGetProperty("windowWidth", out JsonElement width) && width.ValueKind == JsonValueKind.Number)
		{
			config.WindowWidth = width.GetInt32();
		}

		if (root.TryGetProperty("windowHeight", out JsonElement height) && height.ValueKind == JsonValueKind.Number)
		{
			config.WindowHeight = height.GetInt32();
		}

		if (root.TryGetProperty("useMirror", out JsonElement mirror) && mirror.ValueKind == JsonValueKind.True)
		{
			config.UseMirror = true;
		}
		else if (root.TryGetProperty("useMirror", out mirror) && mirror.ValueKind == JsonValueKind.False)
		{
			config.UseMirror = false;
		}

		// 代理设置
		string proxyHost = JsonUtil.GetString(root, "proxyHost");
		if (proxyHost != null) config.ProxyHost = proxyHost;

		string proxyUsername = JsonUtil.GetString(root, "proxyUsername");
		if (proxyUsername != null) config.ProxyUsername = proxyUsername;

		string proxyPassword = JsonUtil.GetString(root, "proxyPassword");
		if (!string.IsNullOrEmpty(proxyPassword)) config.ProxyPassword = proxyPassword;

		if (root.TryGetProperty("proxyPort", out JsonElement proxyPort) && proxyPort.ValueKind == JsonValueKind.Number)
		{
			config.ProxyPort = proxyPort.GetInt32();
		}

		if (root.TryGetProperty("proxyEnabled", out JsonElement proxyEnabled) && proxyEnabled.ValueKind == JsonValueKind.True)
		{
			config.ProxyEnabled = true;
		}
		else if (root.TryGetProperty("proxyEnabled", out proxyEnabled) && proxyEnabled.ValueKind == JsonValueKind.False)
		{
			config.ProxyEnabled = false;
		}

		// 快捷操作
		if (root.TryGetProperty("minimizeOnLaunch", out JsonElement minimizeOnLaunch) && minimizeOnLaunch.ValueKind == JsonValueKind.True)
		{
			config.MinimizeOnLaunch = true;
		}
		else if (root.TryGetProperty("minimizeOnLaunch", out minimizeOnLaunch) && minimizeOnLaunch.ValueKind == JsonValueKind.False)
		{
			config.MinimizeOnLaunch = false;
		}

		if (root.TryGetProperty("autoCloseOnExit", out JsonElement autoCloseOnExit) && autoCloseOnExit.ValueKind == JsonValueKind.True)
		{
			config.AutoCloseOnExit = true;
		}
		else if (root.TryGetProperty("autoCloseOnExit", out autoCloseOnExit) && autoCloseOnExit.ValueKind == JsonValueKind.False)
		{
			config.AutoCloseOnExit = false;
		}

		// R2-02：新闻图片 fake-ip 兼容开关。严格 bool 语义：
		//   - 字段为 true  → 开启
		//   - 字段为 false → 关闭
		//   - 字段缺失/字符串/数字/null → 不改变旧值（避免前端/旧数据误触发开启）
		if (root.TryGetProperty("newsFakeIpCompat", out JsonElement newsFakeIp) && newsFakeIp.ValueKind == JsonValueKind.True)
		{
			config.NewsFakeIpCompat = true;
		}
		else if (root.TryGetProperty("newsFakeIpCompat", out newsFakeIp) && newsFakeIp.ValueKind == JsonValueKind.False)
		{
			config.NewsFakeIpCompat = false;
		}
	}

	/// <summary>
	/// 整体替换 AI 提供商列表并按 id 合并密钥：
	/// 请求数组顺序即最终顺序；未带 apiKey 的项保留 SecretStore 已有值；请求中缺失的旧 id 视为删除并清理密钥。
	/// </summary>
	private static void PatchAiProviders(AppConfig config, JsonElement arr)
	{
		HashSet<string> incoming = new HashSet<string>();
		List<AiProviderProfile> next = new List<AiProviderProfile>();
		Dictionary<string, AiProviderProfile> existing = config.AiProviders.ToDictionary(p => p.Id, StringComparer.Ordinal);

		foreach (JsonElement item in arr.EnumerateArray())
		{
			string id = JsonUtil.GetString(item, "id");
			if (string.IsNullOrWhiteSpace(id))
			{
				id = Guid.NewGuid().ToString("N");
			}
			incoming.Add(id);

			string name = JsonUtil.GetString(item, "name");
			string baseUrl = JsonUtil.GetString(item, "baseUrl");
			string model = JsonUtil.GetString(item, "model");
			string apiKey = JsonUtil.GetString(item, "apiKey");

			AiProviderProfile profile;
			if (existing.TryGetValue(id, out AiProviderProfile found))
			{
				profile = found;
			}
			else
			{
				profile = new AiProviderProfile { Id = id };
			}
			if (name != null) profile.Name = name;
			if (baseUrl != null) profile.BaseUrl = baseUrl;
			if (model != null) profile.Model = model;
			if (apiKey != null)
			{
				profile.ApiKey = apiKey;
				SecretStore.Save("AiKey_" + id, apiKey);
			}
			next.Add(profile);
		}

		// 处理被删除的旧项：清理密钥
		foreach (AiProviderProfile old in config.AiProviders)
		{
			if (!incoming.Contains(old.Id))
			{
				SecretStore.Save("AiKey_" + old.Id, string.Empty);
			}
		}

		config.AiProviders = next;

		// 若当前选中项被删除，则置空
		if (!string.IsNullOrEmpty(config.SelectedAiProviderId) && !incoming.Contains(config.SelectedAiProviderId))
		{
			config.SelectedAiProviderId = string.Empty;
		}

		// 无选中项时自动选中第一个提供商，保证新增首个提供商后即为当前
		if (string.IsNullOrEmpty(config.SelectedAiProviderId) && next.Count > 0)
		{
			config.SelectedAiProviderId = next[0].Id;
		}
	}

	private static async Task HandleListWorldsAsync(HttpListenerResponse response)
	{
		AppConfig config = LoadConfig();
		List<object> worlds = new List<object>();
		foreach (GameInstance instance in config.Instances)
		{
			string gameDir = ResolveGameDirectory(config, instance);
			List<SaveInfo> saves;
			try
			{
				saves = new SaveService(gameDir).GetSaves(instance);
			}
			catch
			{
				continue;
			}

			worlds.AddRange(saves.Select(s => new
			{
				s.FolderName,
				s.DisplayName,
				s.LastPlayed,
				s.SizeText,
				s.HasIcon,
				instanceId = instance.Id,
				instanceName = instance.Name
			}));
		}

		await WriteJsonAsync(response, 200, new { worlds });
	}

	private static async Task HandleSearchContentAsync(HttpListenerRequest request, HttpListenerResponse response)
	{
		string query = request.QueryString["q"] ?? string.Empty;
		string category = request.QueryString["category"] ?? "mod";
		string gameVersion = request.QueryString["gameVersion"] ?? string.Empty;
		string loader = request.QueryString["loader"] ?? string.Empty;
		string source = request.QueryString["source"] ?? "modrinth";
		if (string.IsNullOrWhiteSpace(query))
		{
			await WriteJsonAsync(response, 200, new { results = new object[0] });
			return;
		}

		using CancellationTokenSource cts = new CancellationTokenSource(TimeSpan.FromSeconds(20));
		AppConfig config = LoadConfig();
		try
		{
			switch (category.ToLowerInvariant())
			{
				case "modpack":
				{
					List<ModpackProject> packs = await new ModrinthModpackService(ApiHttp).SearchAsync(query, cts.Token);
					// modpack 当前只走 Modrinth；保留 source 字段以便前端统一处理
					string packSource = "modrinth";
					foreach (ModpackProject p in packs)
					{
						// Phase 2：把上游 iconUrl 注册到 ContentIconService 可信映射。
						// 前端只看到 source/category/id 三元组，绝不直接拿到上游 URL。
						ContentIconService.Default.RegisterTrustedUrl(packSource, "modpack", p.ProjectId, p.IconUrl);
					}
					await WriteJsonAsync(response, 200, new
					{
						results = packs.Select(p => new
						{
							id = p.ProjectId,
							title = p.Title,
							desc = p.Description,
							author = p.Author,
							downloads = p.Downloads,
							category,
							source = packSource,
							versions = p.Categories,
							loaders = new string[0],
							websiteUrl = p.WebsiteUrl,
							// Phase 2：仅向前端暴露可信标识；上游 iconUrl 不再透传给 DOM。
							// 客户端只能从 id/source/category 构造 /api/content/icon 本地端点。
							iconUrl = (string.IsNullOrEmpty(p.IconUrl)) ? string.Empty : ("/api/content/icon?source=" + packSource + "&category=modpack&projectId=" + Uri.EscapeDataString(p.ProjectId)),
						})
					});
					return;
				}
				case "shader":
				case "resourcepack":
				{
					ResourceContentKind kind = category.Equals("shader", StringComparison.OrdinalIgnoreCase)
						? ResourceContentKind.Shader
						: ResourceContentKind.ResourcePack;
					List<ResourceContentProject> projects = await new ResourceContentService(ApiHttp).SearchAsync(query, gameVersion, kind, cts.Token);
					// 光影/资源包目前由 Modrinth 提供；保留 source 字段以便前端统一处理
					string resSource = "modrinth";
					foreach (ResourceContentProject p in projects)
					{
						ContentIconService.Default.RegisterTrustedUrl(resSource, category, p.ProjectId, p.IconUrl);
					}
					await WriteJsonAsync(response, 200, new
					{
						results = projects.Select(p => new
						{
							id = p.ProjectId,
							title = p.Title,
							desc = p.Description,
							author = p.Author,
							downloads = p.Downloads,
							category,
							source = resSource,
							versions = new string[0],
							loaders = new string[0],
							websiteUrl = p.WebsiteUrl,
							iconUrl = (string.IsNullOrEmpty(p.IconUrl)) ? string.Empty : ("/api/content/icon?source=" + resSource + "&category=" + category + "&projectId=" + Uri.EscapeDataString(p.ProjectId)),
						})
					});
					return;
				}
				default:
				{
					string modSource = source.Equals("curseforge", StringComparison.OrdinalIgnoreCase) ? "curseforge" : "modrinth";
					ModSearchRequest req = new ModSearchRequest
					{
						Source = modSource == "curseforge" ? ModSource.CurseForge : ModSource.Modrinth,
						Query = query,
						MinecraftVersion = gameVersion,
						Loader = loader,
						Limit = 24,
						CurseForgeApiKey = config?.CurseForgeApiKey ?? string.Empty
					};
					List<ModSearchResult> results = await new ModContentService(ApiHttp).SearchAsync(req, cts.Token);
					foreach (ModSearchResult m in results)
					{
						// Phase 2：注册上游 iconUrl 到可信映射（仅 modrinth 当前可达，
						// curseforge 主机未实测故即使注册了也只会在 IsAllowedHost 阶段被拒）。
						ContentIconService.Default.RegisterTrustedUrl(modSource, "mod", m.ProjectId, m.IconUrl);
					}
					await WriteJsonAsync(response, 200, new
					{
						results = results.Select(m => new
						{
							id = m.ProjectId,
							title = m.Title,
							desc = m.Description,
							author = m.Author,
							downloads = m.Downloads,
							category,
							source = modSource,
							versions = m.GameVersions,
							loaders = m.Categories.Where(c => ModLoaderInfo.SupportedKinds.Any(k => k.ToString().Equals(c, StringComparison.OrdinalIgnoreCase))).ToArray(),
							websiteUrl = m.WebsiteUrl,
							iconUrl = (string.IsNullOrEmpty(m.IconUrl)) ? string.Empty : ("/api/content/icon?source=" + modSource + "&category=mod&projectId=" + Uri.EscapeDataString(m.ProjectId)),
						})
					});
					return;
				}
			}
		}
		catch (Exception ex)
		{
			Debug.WriteLine($"[LocalApi] content search error: {ex.Message}");
			// 区分"无结果"与"上游故障"：错误时返回 error 字段与空 results，
			// 前端不再据此显示"假装成功"的 mock 数据。
			await WriteJsonAsync(response, 502, new { results = new object[0], error = ex.Message });
		}
	}

	private static async Task HandleContentIconAsync(HttpListenerRequest request, HttpListenerResponse response)
	{
		// Phase 2：受保护的本地资源图标端点。
		// 1) 不接受 url / host / redirect 等客户端可控上游地址参数；
		// 2) 只允许 source / category / projectId 三个身份字段；
		// 3) 验证 session token（由前置 HasValidSessionToken 守门）；
		// 4) Origin 验证已在外层 HandleAsync 完成；
		// 5) 身份三元组命中 ContentIconService 的可信映射（搜索阶段注册）才发起下载；
		// 6) 错误响应不泄漏上游 URL、token、内部错误信息。
		string source = (request.QueryString["source"] ?? string.Empty).Trim().ToLowerInvariant();
		string category = (request.QueryString["category"] ?? string.Empty).Trim().ToLowerInvariant();
		string projectId = (request.QueryString["projectId"] ?? string.Empty).Trim();

		// 拒绝任何额外未知查询参数（防止 url= 之类被偷偷加进来作为上游 URL 探针）
		foreach (string key in request.QueryString.AllKeys)
		{
			if (key is null) continue;
			if (key.Equals("source", StringComparison.OrdinalIgnoreCase)) continue;
			if (key.Equals("category", StringComparison.OrdinalIgnoreCase)) continue;
			if (key.Equals("projectId", StringComparison.OrdinalIgnoreCase)) continue;
			if (key.Equals("token", StringComparison.OrdinalIgnoreCase)) continue;
			await WriteJsonErrorAsync(response, 400, "图标身份参数非法");
			return;
		}

		if (!ContentIconService.IsValidSource(source)
			|| !ContentIconService.IsValidCategory(category)
			|| !ContentIconService.IsValidProjectId(projectId))
		{
			await WriteJsonErrorAsync(response, 400, "图标身份参数非法");
			return;
		}

		try
		{
			IconResult result = await ContentIconService.Default.GetAsync(source, category, projectId, CancellationToken.None).ConfigureAwait(false);
			switch (result.Status)
			{
				case IconStatus.NotFound:
					await WriteJsonErrorAsync(response, 404, "图标不存在");
					return;
				case IconStatus.TooLarge:
					await WriteJsonErrorAsync(response, 413, "图标超过大小上限");
					return;
				case IconStatus.BadContentType:
					await WriteJsonErrorAsync(response, 415, "图标 MIME 不允许");
					return;
				case IconStatus.BadImage:
					await WriteJsonErrorAsync(response, 415, "图标文件签名无效");
					return;
				case IconStatus.UpstreamError:
					await WriteJsonErrorAsync(response, 502, "上游不可用");
					return;
				case IconStatus.NetworkError:
					await WriteJsonErrorAsync(response, 504, "上游超时或不可达");
					return;
				case IconStatus.Ok:
				case IconStatus.FromCache:
				case IconStatus.Stale:
					// 成功路径：写图片字节 + 安全头
					response.StatusCode = 200;
					response.ContentType = result.Mime ?? "image/png";
					if (result.Bytes != null) response.ContentLength64 = result.Bytes.LongLength;
					response.Headers["X-Content-Type-Options"] = "nosniff";
					response.Headers["Referrer-Policy"] = "no-referrer";
					response.Headers["Cache-Control"] = "private, max-age=3600";
					if (result.Status == IconStatus.Stale) response.Headers["X-Pineglow-Cache"] = "stale";
					if (result.Bytes != null)
					{
						try
						{
							await response.OutputStream.WriteAsync(result.Bytes, 0, result.Bytes.Length).ConfigureAwait(false);
						}
						catch
						{
							// 客户端中途断开
						}
					}
					try { response.Close(); } catch { }
					return;
				default:
					await WriteJsonErrorAsync(response, 502, "图标不可用");
					return;
			}
		}
		catch (Exception ex)
		{
			// 任何意外都不向客户端泄漏内部信息
			LauncherLog.Error("[LocalApi] content icon error: " + ex.Message);
			await WriteJsonErrorAsync(response, 502, "图标不可用");
		}
	}

	private static async Task WriteJsonErrorAsync(HttpListenerResponse response, int status, string message)
	{
		try
		{
			await WriteJsonAsync(response, status, new { error = message });
		}
		catch
		{
			try { response.StatusCode = status; response.Close(); } catch { }
		}
	}

	private static async Task HandleContentInstallAsync(HttpListenerRequest request, HttpListenerResponse response)
	{
		JsonDocument body = await ReadBodyAsync(request);
		string category = (JsonUtil.GetString(body.RootElement, "category") ?? "mod").Trim().ToLowerInvariant();
		string projectId = JsonUtil.GetString(body.RootElement, "projectId")?.Trim() ?? string.Empty;
		string instanceId = JsonUtil.GetString(body.RootElement, "instanceId")?.Trim() ?? string.Empty;
		string source = (JsonUtil.GetString(body.RootElement, "source") ?? "modrinth").Trim().ToLowerInvariant();
		if (string.IsNullOrWhiteSpace(projectId))
		{
			throw new InvalidOperationException("projectId 不能为空");
		}

		AppConfig config = LoadConfig();
		if (category != "modpack")
		{
			if (string.IsNullOrWhiteSpace(instanceId))
			{
				instanceId = config.SelectedInstanceId;
			}

			if (string.IsNullOrWhiteSpace(instanceId))
			{
				throw new InvalidOperationException("请先选择一个实例再安装内容");
			}

			RequireInstance(config, instanceId);
		}

		ContentTaskEntry entry = new ContentTaskEntry
		{
			Id = "ct" + DateTimeOffset.Now.ToUnixTimeMilliseconds(),
			Category = category,
			ProjectId = projectId,
			InstanceId = instanceId,
			Source = source,
			Status = "queued",
			Message = "排队中",
			StartedAt = DateTimeOffset.Now
		};
		lock (ContentGate)
		{
			ContentTasks.Add(entry);
		}

		_ = Task.Run(() => RunContentInstallTaskAsync(entry));
		await WriteJsonAsync(response, 200, new { ok = true, id = entry.Id, category, status = "queued" });
	}

	private static async Task HandleListContentTasksAsync(HttpListenerResponse response)
	{
		object[] snapshot;
		lock (ContentGate)
		{
			snapshot = ContentTasks.Select(t => new
			{
				t.Id,
				t.Category,
				t.ProjectId,
				t.InstanceId,
				t.Title,
				t.Status,
				t.Progress,
				t.Message,
				t.ResultInstanceId,
				t.StartedAt
			}).ToArray();
		}

		await WriteJsonAsync(response, 200, new { tasks = snapshot });
	}

	private static async Task RunContentInstallTaskAsync(ContentTaskEntry entry)
	{
		try
		{
			lock (ContentGate)
			{
				entry.Status = "running";
				entry.Message = "正在准备安装";
			}

			AppConfig config = LoadConfig();
			switch (entry.Category)
			{
				case "modpack":
					entry.Title = "整合包";
					await InstallModpackContentAsync(entry, config);
					break;
				case "shader":
				case "resourcepack":
					entry.Title = entry.Category == "shader" ? "光影" : "资源包";
					await InstallResourceContentAsync(entry, config);
					break;
				default:
					entry.Title = "Mod";
					await InstallModContentAsync(entry, config);
					break;
			}

			lock (ContentGate)
			{
				entry.Status = "completed";
				entry.Progress = 1.0;
				entry.Message = "安装完成";
			}
		}
		catch (Exception ex)
		{
			lock (ContentGate)
			{
				entry.Status = "failed";
				entry.Message = ex.Message;
			}

			LauncherLog.Error($"[ContentInstall] {entry.Category} {entry.ProjectId} 失败: {ex.Message}");
		}
	}

	private static void UpdateContentTask(ContentTaskEntry entry, string message, double progress = -1)
	{
		lock (ContentGate)
		{
			if (!string.IsNullOrWhiteSpace(message))
			{
				entry.Message = message;
			}

			if (progress >= 0)
			{
				entry.Progress = progress;
			}
		}
	}

	private static async Task InstallModContentAsync(ContentTaskEntry entry, AppConfig config)
	{
		GameInstance instance = RequireInstance(config, entry.InstanceId);
		string gameDir = ResolveGameDirectory(config, instance);
		// MR05：带上恢复服务，已安装同一在线项目时走事务化替换而不是并列导入。
		ModContentService content = new ModContentService(ApiHttp, CreateRecoveryService());
		ModSource sourceKind = entry.Source.Equals("curseforge", StringComparison.OrdinalIgnoreCase) ? ModSource.CurseForge : ModSource.Modrinth;
		ModSearchResult project = new ModSearchResult
		{
			Source = sourceKind,
			ProjectId = entry.ProjectId
		};
		UpdateContentTask(entry, "正在获取版本信息", 0.1);
		List<ModVersion> versions = await content.GetVersionsAsync(project, instance.MinecraftVersion, instance.LoaderType, config.CurseForgeApiKey ?? string.Empty);
		ModVersion version = versions.FirstOrDefault(v => v.ReleaseType.Equals("release", StringComparison.OrdinalIgnoreCase)) ?? versions.FirstOrDefault();
		if (version == null)
		{
			throw new InvalidOperationException("该 Mod 没有找到兼容当前实例的版本");
		}

		UpdateContentTask(entry, $"正在安装 {version.DisplayName} {version.VersionNumber}", 0.2);
		ModService modService = new ModService(gameDir);
		ModInstallResult result = await content.InstallWithDependenciesAsync(instance, version, modService, instance.MinecraftVersion, instance.LoaderType,
			curseForgeApiKey: config.CurseForgeApiKey ?? string.Empty,
			progress: new Progress<double>(p => UpdateContentTask(entry, string.Empty, 0.2 + p * 0.7)),
			status: msg => UpdateContentTask(entry, msg),
			ct: CancellationToken.None);
		entry.Title = version.DisplayName;
	}

	private static async Task InstallResourceContentAsync(ContentTaskEntry entry, AppConfig config)
	{
		GameInstance instance = RequireInstance(config, entry.InstanceId);
		string gameDir = ResolveGameDirectory(config, instance);
		ResourceContentKind kind = entry.Category.Equals("shader", StringComparison.OrdinalIgnoreCase)
			? ResourceContentKind.Shader
			: ResourceContentKind.ResourcePack;
		ResourceContentService content = new ResourceContentService(ApiHttp);
		ResourceContentProject project = new ResourceContentProject
		{
			ProjectId = entry.ProjectId,
			Kind = kind
		};
		UpdateContentTask(entry, "正在获取版本信息", 0.1);
		List<ResourceContentVersion> versions = await content.GetVersionsAsync(project, instance.MinecraftVersion);
		ResourceContentVersion version = versions.FirstOrDefault(v => v.VersionNumber != string.Empty) ?? versions.FirstOrDefault();
		if (version == null)
		{
			throw new InvalidOperationException("该内容没有找到可用版本");
		}

		UpdateContentTask(entry, $"正在安装 {version.FileName}", 0.2);
		await content.DownloadAsync(instance, project, version, gameDir,
			progress: new Progress<double>(p => UpdateContentTask(entry, string.Empty, 0.2 + p * 0.7)),
			ct: CancellationToken.None);
		entry.Title = version.FileName;
	}

	private static async Task InstallModpackContentAsync(ContentTaskEntry entry, AppConfig config)
	{
		ModrinthModpackService modrinth = new ModrinthModpackService(ApiHttp);
		ModpackProject project = new ModpackProject
		{
			ProjectId = entry.ProjectId
		};
		UpdateContentTask(entry, "正在获取整合包版本", 0.05);
		List<ModpackVersion> versions = await modrinth.GetVersionsAsync(project);
		ModpackVersion version = versions.FirstOrDefault(v => v.ReleaseType.Equals("release", StringComparison.OrdinalIgnoreCase)) ?? versions.FirstOrDefault();
		if (version == null)
		{
			throw new InvalidOperationException("该整合包没有可用版本");
		}

		UpdateContentTask(entry, $"正在下载 {project.Title} {version.VersionNumber}", 0.1);
		string zipPath = await modrinth.DownloadAsync(project, version);
		try
		{
			string defaultGameDir = string.IsNullOrWhiteSpace(config.GameDirectory) ? PlatformPaths.GetDefaultMinecraftDirectory() : config.GameDirectory;
			InstancePackService packService = new InstancePackService(ApiHttp, defaultGameDir, msg => UpdateContentTask(entry, msg));
			UpdateContentTask(entry, "正在创建实例并安装整合包", 0.15);
			GameInstance newInstance = await packService.ImportModrinthPackAsync(zipPath,
				msg => UpdateContentTask(entry, msg),
				CancellationToken.None);
			AppConfig latest = LoadConfig();
			latest.Instances.Add(newInstance);
			latest.SelectedInstanceId = newInstance.Id;
			SaveConfig(latest);
			entry.Title = newInstance.Name;
			entry.ResultInstanceId = newInstance.Id;
			UpdateContentTask(entry, "整合包实例创建完成", 0.95);
		}
		finally
		{
			ModrinthModpackService.DeleteDownload(zipPath);
		}
	}

	private static async Task HandleGetStatsAsync(HttpListenerResponse response)
	{
		AppConfig config = LoadConfig();
		long totalSeconds = config.Instances.Sum(x => x.TotalPlaySeconds);
		int totalCount = config.Instances.Sum(x => x.PlayCount);
		var perInstance = config.Instances.Select(x => new
		{
			x.Id,
			x.Name,
			x.PlayCount,
			x.TotalPlaySeconds,
			lastLaunch = x.LastLaunchTime
		}).ToList();
		await WriteJsonAsync(response, 200, new
		{
			totalPlaySeconds = totalSeconds,
			totalPlayCount = totalCount,
			totalInstances = config.Instances.Count,
			perInstance
		});
	}

	private static async Task HandleListJavaAsync(HttpListenerResponse response)
	{
		AppConfig config = LoadConfig();
		List<JavaInstallation> installations = await JavaLocator.ScanAsync(null);
		await WriteJsonAsync(response, 200, new
		{
			config.JavaPath,
			installations = installations.Select(j => new { j.JavaPath, j.VersionMajor, j.VersionText, j.Vendor, j.IsValid })
		});
	}

	private static async Task HandleListSourcesAsync(HttpListenerResponse response)
	{
		AppConfig config = LoadConfig();
		IReadOnlyList<DownloadSourceInfo> sources = MirrorHelper.ListSources();
		using CancellationTokenSource cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
		// 并行测速（官方源也测，便于对比）
		foreach (DownloadSourceInfo s in sources)
		{
			s.LatencyMs = await MirrorHelper.MeasureLatencyAsync(ApiHttp, s.BaseUrl, cts.Token);
		}

		await WriteJsonAsync(response, 200, new
		{
			selected = MirrorHelper.SelectedKey,
			sources = sources.Select(s => new
			{
				key = s.Key,
				name = s.Name,
				baseUrl = s.BaseUrl,
				latencyMs = s.LatencyMs,
				available = s.LatencyMs >= 0,
			})
		});
	}

	private static async Task HandleSelectSourceAsync(HttpListenerRequest request, HttpListenerResponse response)
	{
		JsonDocument body = await ReadBodyAsync(request);
		string key = JsonUtil.GetString(body.RootElement, "key")?.Trim() ?? string.Empty;
		DownloadSourceInfo source = MirrorHelper.ListSources().FirstOrDefault(s => s.Key.Equals(key, StringComparison.OrdinalIgnoreCase))
			?? throw new InvalidOperationException("未知下载源：" + key);

		AppConfig config = LoadConfig();
		config.DownloadSource = source.Key;
		config.UseMirror = !source.Key.Equals("official", StringComparison.OrdinalIgnoreCase);
		SaveConfig(config);
		await WriteJsonAsync(response, 200, new { ok = true, selected = source.Key, useMirror = config.UseMirror });
	}

	private static async Task HandleListServersAsync(HttpListenerResponse response)
	{
		AppConfig config = LoadConfig();
		await WriteJsonAsync(response, 200, new { servers = config.FavoriteServers.Select(BuildServerSummary) });
	}

	private static object BuildServerSummary(FavoriteServer s)
	{
		return new
		{
			s.Id,
			s.Name,
			s.Host,
			s.Port,
			s.StatusText,
			s.Motd,
			s.VersionName,
			s.OnlinePlayers,
			s.MaxPlayers,
			s.LatencyMs,
			s.LastCheckedAt,
			favicon = s.FaviconBytes != null ? "data:image/png;base64," + Convert.ToBase64String(s.FaviconBytes) : null
		};
	}

	private static async Task HandleAddServerAsync(HttpListenerRequest request, HttpListenerResponse response)
	{
		JsonDocument body = await ReadBodyAsync(request);
		string name = JsonUtil.GetString(body.RootElement, "name")?.Trim();
		string host = JsonUtil.GetString(body.RootElement, "host")?.Trim();
		int port = 25565;
		string portText = JsonUtil.GetString(body.RootElement, "port");
		if (!int.TryParse(portText, out port) || port <= 0 || port > 65535)
		{
			port = 25565;
		}

		if (string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(host))
		{
			throw new InvalidOperationException("服务器名称与地址不能为空");
		}

		AppConfig config = LoadConfig();
		FavoriteServer server = new FavoriteServer { Name = name, Host = host, Port = port };
		config.FavoriteServers.Add(server);
		SaveConfig(config);
		await WriteJsonAsync(response, 200, new { ok = true, server = BuildServerSummary(server) });
	}

	private static async Task HandlePingServerAsync(HttpListenerResponse response, string serverId)
	{
		AppConfig config = LoadConfig();
		FavoriteServer server = config.FavoriteServers.FirstOrDefault(x => x.Id == serverId)
			?? throw new InvalidOperationException("服务器不存在：" + serverId);
		using CancellationTokenSource cts = new CancellationTokenSource(TimeSpan.FromSeconds(6));
		try
		{
			MinecraftServerStatus status = await ServerPingService.QueryAsync(server.Host, server.Port, cts.Token);
			server.Motd = status.Motd;
			server.VersionName = status.VersionName;
			server.OnlinePlayers = status.OnlinePlayers;
			server.MaxPlayers = status.MaxPlayers;
			server.LatencyMs = status.LatencyMs;
			server.FaviconBytes = status.FaviconBytes;
			server.StatusText = status.OnlinePlayers >= 0 ? "可连接 · " + status.LatencyMs + " ms" : "无法连接";
			server.LastCheckedAt = DateTimeOffset.Now;
		}
		catch
		{
			server.StatusText = "无法连接";
			server.LastCheckedAt = DateTimeOffset.Now;
		}

		SaveConfig(config);
		await WriteJsonAsync(response, 200, new { ok = true, server = BuildServerSummary(server) });
	}

	private static async Task HandleDeleteServerAsync(HttpListenerResponse response, string serverId)
	{
		AppConfig config = LoadConfig();
		config.FavoriteServers.RemoveAll(x => x.Id == serverId);
		SaveConfig(config);
		await WriteJsonAsync(response, 200, new { ok = true });
	}

	/* ================= 静态文件 ================= */

	private static async Task ServeStaticAsync(HttpListenerContext context, string path)
	{
		HttpListenerResponse response = context.Response;
		string relative = path.TrimStart('/');
		if (string.IsNullOrEmpty(relative))
		{
			relative = "index.html";
		}

		string full = Path.GetFullPath(Path.Combine(_uiRoot, relative.Replace('/', Path.DirectorySeparatorChar)));
		if (!IsPathWithinRoot(_uiRoot, full) || !File.Exists(full))
		{
			await WriteJsonAsync(response, 404, new { error = "Not Found: " + path });
			return;
		}

		string contentType = "application/octet-stream";
		string ext = Path.GetExtension(full).ToLowerInvariant();
		switch (ext)
		{
			case ".html":
				contentType = "text/html; charset=utf-8";
				break;
			case ".css":
				contentType = "text/css; charset=utf-8";
				break;
			case ".js":
				contentType = "application/javascript; charset=utf-8";
				break;
			case ".json":
				contentType = "application/json; charset=utf-8";
				break;
			case ".png":
				contentType = "image/png";
				break;
			case ".jpg":
			case ".jpeg":
				contentType = "image/jpeg";
				break;
			case ".svg":
				contentType = "image/svg+xml";
				break;
			case ".ico":
				contentType = "image/x-icon";
				break;
			case ".woff2":
				contentType = "font/woff2";
				break;
		}

		response.ContentType = contentType;
		byte[] bytes = await File.ReadAllBytesAsync(full);
		if (Path.GetFileName(full).Equals("index.html", StringComparison.OrdinalIgnoreCase))
		{
			bytes = Encoding.UTF8.GetBytes(Encoding.UTF8.GetString(bytes).Replace("__PINEGLOW_SESSION_TOKEN__", SessionToken, StringComparison.Ordinal));
		}
		await response.OutputStream.WriteAsync(bytes, 0, bytes.Length);
	}

	/* ================= 工具 ================= */

	internal static bool IsPathWithinRoot(string root, string candidate)
	{
		string relative = Path.GetRelativePath(Path.GetFullPath(root), Path.GetFullPath(candidate));
		return !Path.IsPathRooted(relative) && relative != ".." && !relative.StartsWith(".." + Path.DirectorySeparatorChar, StringComparison.Ordinal);
	}

	internal static string CreateSafeTemporaryUploadPath(string root, string clientFileName)
	{
		string extension = Path.GetExtension(Path.GetFileName(clientFileName));
		string result = Path.Combine(root, Guid.NewGuid().ToString("N") + extension);
		if (!IsPathWithinRoot(root, result)) throw new InvalidOperationException("临时上传路径越界");
		return result;
	}

	internal static bool ExceedsJsonBodyLimit(long contentLength) => contentLength > MaxJsonBodyBytes;

	private static async Task<JsonDocument> ReadBodyAsync(HttpListenerRequest request)
	{
		if (ExceedsJsonBodyLimit(request.ContentLength64)) throw new InvalidOperationException("请求体超过 32 MiB 上限");
		using MemoryStream ms = new MemoryStream();
		byte[] buffer = new byte[81920];
		int read;
		while ((read = await request.InputStream.ReadAsync(buffer, 0, buffer.Length)) > 0)
		{
			if (ms.Length + read > MaxJsonBodyBytes) throw new InvalidOperationException("请求体超过 32 MiB 上限");
			await ms.WriteAsync(buffer, 0, read);
		}
		return JsonDocument.Parse(ms.ToArray());
	}

	private static async Task WriteJsonAsync(HttpListenerResponse response, int status, object payload)
	{
		byte[] bytes = JsonSerializer.SerializeToUtf8Bytes(payload, JsonOpts);
		response.StatusCode = status;
		response.ContentType = "application/json; charset=utf-8";
		response.ContentLength64 = bytes.Length;
		await response.OutputStream.WriteAsync(bytes, 0, bytes.Length);
	}
}
