	private static readonly object ContentGate = new object();
	private static readonly List<ContentTaskEntry> ContentTasks = new List<ContentTaskEntry>();

	// 自更新状态（单任务）
	private static readonly object UpdateGate = new object();
	private static string UpdateState = "idle"; // idle / downloading / completed / failed / applying
	private static double UpdateProgress;
	private static string UpdateVersion = string.Empty;
	private static string UpdatePath = string.Empty;
	private static string UpdateError = string.Empty;
	private static bool UpdateMandatory;

	public static int Port { get; private set; } = DefaultPort;
	public static bool IsRunning => _running;
	internal static string SessionTokenForTests => SessionToken;

	public static void Start(int? portOverride = null)
	{
		if (_running)
		{
			return;
		}

		int port = portOverride ?? DefaultPort;
		string envPort = Environment.GetEnvironmentVariable("PINEGLOW_API_PORT");
		if (portOverride == null && int.TryParse(envPort, out int envParsed))
		{
			port = envParsed;
		}

		_uiRoot = ResolveUiRoot();
		_listener = new HttpListener();
		_listener.Prefixes.Add($"http://127.0.0.1:{port}/");
		_listener.Start();
		Port = port;
		_running = true;
		_ = Task.Run(LoopAsync);
		LauncherLog.Info($"[LocalApi] 监听 127.0.0.1:{port}, ui={_uiRoot}");
		Debug.WriteLine($"[LocalApi] listening on 127.0.0.1:{port}, ui={_uiRoot}");
	}

	public static void Stop()
	{
		// 返修五：无论当前是否运行，都必须释放 ContentIconService.Default。
		// listener 停止/关闭抛异常时，通过 finally 保证图标服务释放；可重复调用。
		try
		{
			if (_running)
			{
				_running = false;
				try
				{
					_listener?.Stop();
					_listener?.Close();
				}
				catch
				{
				}
				_listener = null;
			}
		}
		finally
		{
			// 释放 ContentIconService 默认实例（线程安全、幂等）
			ContentIconService.DisposeDefault();
		}
	}

	private static string ResolveUiRoot()
	{
		string env = Environment.GetEnvironmentVariable("PINEGLOW_UI_DIR");
		if (!string.IsNullOrWhiteSpace(env) && Directory.Exists(env))
		{
			return env;
		}

		string baseDir = Path.Combine(AppContext.BaseDirectory, "UI");
		if (Directory.Exists(baseDir))
		{
			return baseDir;
		}

		string configDir = PlatformPaths.GetConfigDirectory();
		string cfgUi = Path.Combine(configDir, "UI");
		if (Directory.Exists(cfgUi))
		{
			return cfgUi;
		}

		return baseDir;
	}

	private static async Task LoopAsync()
	{
		while (_running)
		{
			try
			{
				HttpListenerContext context = await _listener.GetContextAsync().ConfigureAwait(false);
				_ = Task.Run(() => HandleAsync(context));
			}
			catch (Exception ex)
			{
				LauncherLog.Error("[LocalApi] loop error: " + ex.Message, ex);
				Debug.WriteLine($"[LocalApi] loop error: {ex.Message}");
				if (_running)
				{
					await Task.Delay(200).ConfigureAwait(false);
				}
			}
		}
	}

	private static async Task HandleAsync(HttpListenerContext context)
	{
		HttpListenerRequest request = context.Request;
		HttpListenerResponse response = context.Response;
		try
		{
			if (!ValidateOrigin(request, out string? allowedOrigin))
			{
				await WriteJsonAsync(response, 403, new { error = "不允许的请求来源" });
				return;
			}
			SetCors(response, allowedOrigin);
			if (request.HttpMethod == "OPTIONS")
			{
				response.StatusCode = 204;
				response.Close();
				return;
			}

			string path = request.Url.AbsolutePath;
			if (path.StartsWith("/api/", StringComparison.OrdinalIgnoreCase) || path.Equals("/api", StringComparison.OrdinalIgnoreCase))
			{
				if (!path.Equals("/api/health", StringComparison.OrdinalIgnoreCase) && !HasValidSessionToken(request))
				{
					await WriteJsonAsync(response, 401, new { error = "缺少或无效的本地 API 会话令牌" });
					return;
				}
				await HandleApiAsync(context, path);
				return;
			}

			await ServeStaticAsync(context, path);
		}
		catch (Exception ex)
		{
			LauncherLog.Error("[LocalApi] handler error: " + request.RawUrl + " | " + ex.Message, ex);
			Debug.WriteLine($"[LocalApi] handler error: {ex}");
			await WriteJsonAsync(response, 500, new { error = ex.Message });
		}
		finally
		{
			try
			{
				response.Close();
			}
			catch
			{
			}
		}
	}

	internal static bool IsAllowedOrigin(string? origin, int port)
	{
		if (string.IsNullOrWhiteSpace(origin)) return true;
		return Uri.TryCreate(origin, UriKind.Absolute, out Uri? uri)
			&& uri.Scheme == Uri.UriSchemeHttp
			&& IPAddress.TryParse(uri.Host, out IPAddress? address)
			&& IPAddress.IsLoopback(address)
			&& uri.Port == port;
	}

	private static bool ValidateOrigin(HttpListenerRequest request, out string? allowedOrigin)
	{
		allowedOrigin = request.Headers["Origin"];
		return IsAllowedOrigin(allowedOrigin, Port);
	}

	private static bool HasValidSessionToken(HttpListenerRequest request)
	{
		string? supplied = request.Headers["X-Pineglow-Token"];
		if (string.IsNullOrEmpty(supplied) && request.Url?.AbsolutePath is string absPath
			&& (absPath.EndsWith("/skin-image", StringComparison.OrdinalIgnoreCase)
				// Phase 2：/api/content/icon 由 <img src> 加载，无法携带自定义 header，
				// 与 /skin-image 同样接受 token= 查询参数（会话令牌等价校验）。
				|| absPath.EndsWith("/api/content/icon", StringComparison.OrdinalIgnoreCase)))
		{
			supplied = request.QueryString["token"];
		}
		return IsValidSessionToken(supplied, SessionToken);
	}

	internal static bool IsValidSessionToken(string? supplied, string expected)
	{
		if (supplied is null || supplied.Length != expected.Length) return false;
		return CryptographicOperations.FixedTimeEquals(Encoding.ASCII.GetBytes(supplied), Encoding.ASCII.GetBytes(expected));
	}

	private static void SetCors(HttpListenerResponse response, string? allowedOrigin)
	{
		if (!string.IsNullOrWhiteSpace(allowedOrigin)) response.Headers["Access-Control-Allow-Origin"] = allowedOrigin;
		response.Headers["Access-Control-Allow-Methods"] = "GET, POST, DELETE, OPTIONS";
		response.Headers["Access-Control-Allow-Headers"] = "Content-Type, X-Pineglow-Token";
		response.Headers["Cache-Control"] = "no-store";
	}

	private static async Task HandleApiAsync(HttpListenerContext context, string path)
	{
		HttpListenerRequest request = context.Request;
		HttpListenerResponse response = context.Response;
		string method = request.HttpMethod.ToUpperInvariant();
		string[] seg = path.Trim('/').Split('/').Select(s => Uri.UnescapeDataString(s)).ToArray();
		// seg = ["api", ...]

		try
		{
			if (seg.Length >= 2 && seg[1].Equals("health", StringComparison.OrdinalIgnoreCase) && method == "GET")
			{
				await WriteJsonAsync(response, 200, new { ok = true, pid = Environment.ProcessId, port = Port });
				return;
			}

			if (seg.Length == 2 && seg[1].Equals("state", StringComparison.OrdinalIgnoreCase) && method == "GET")
			{
				await HandleGetStateAsync(response);
				return;
			}

			if (seg.Length == 2 && seg[1].Equals("logs", StringComparison.OrdinalIgnoreCase) && method == "POST")
			{
				HandleOpenLogDirectory(response);
				return;
			}

			if (seg.Length == 2 && seg[1].Equals("instances", StringComparison.OrdinalIgnoreCase))
			{
				if (method == "GET")
				{
					await HandleListInstancesAsync(response);
					return;
				}

				if (method == "POST")
				{
					await HandleCreateInstanceAsync(request, response);
					return;
				}
			}

			if (seg.Length == 3 && seg[1].Equals("instances", StringComparison.OrdinalIgnoreCase) && method == "GET")
			{
				await HandleInstanceDetailAsync(response, seg[2]);
				return;
			}

			if (seg.Length == 3 && seg[1].Equals("instances", StringComparison.OrdinalIgnoreCase) && seg[2].Equals("import", StringComparison.OrdinalIgnoreCase) && method == "POST")
			{
				await HandleImportInstanceAsync(request, response);
				return;
			}

			// MR11：取消进行中的整合包导入。必须精确匹配，避免被 import 分支吞掉。
			if (seg.Length == 4 && seg[1].Equals("instances", StringComparison.OrdinalIgnoreCase) && seg[2].Equals("import", StringComparison.OrdinalIgnoreCase) && seg[3].Equals("cancel", StringComparison.OrdinalIgnoreCase) && method == "POST")
			{
				await HandleCancelImportAsync(request, response);
				return;
			}

			// MR03：把磁盘上已存在的游戏目录重新挂回实例列表（"从列表移除"的逆操作），只写配置、不碰文件。
			if (seg.Length == 3 && seg[1].Equals("instances", StringComparison.OrdinalIgnoreCase) && seg[2].Equals("register", StringComparison.OrdinalIgnoreCase) && method == "POST")
			{
				await HandleRegisterInstanceAsync(request, response);
				return;
			}

			// Phase 3B v3 修复批次：cancel 路由必须先于通用 diagnose。精确 seg.Length 匹配。
			if (seg.Length == 5 && seg[1].Equals("instances", StringComparison.OrdinalIgnoreCase) && seg[3].Equals("diagnose", StringComparison.OrdinalIgnoreCase) && seg[4].Equals("cancel", StringComparison.OrdinalIgnoreCase) && method == "POST")
			{
				await HandleCancelDiagnoseAsync(request, response, seg[2]);
				return;
			}

			// MR08：诊断历史与导出（只读本地报告，不触发任何外部请求）。
			if (seg.Length == 5 && seg[1].Equals("instances", StringComparison.OrdinalIgnoreCase) && seg[3].Equals("diagnose", StringComparison.OrdinalIgnoreCase) && method == "GET")
			{
				if (seg[4].Equals("history", StringComparison.OrdinalIgnoreCase))
				{
					await HandleDiagnoseHistoryAsync(response, seg[2]);
					return;
				}

				if (seg[4].Equals("export", StringComparison.OrdinalIgnoreCase))
				{
					await HandleDiagnoseExportAsync(request, response, seg[2]);
					return;
				}
			}

			// 2026-10-03 P0 收口（W1）：以下 4 组的精确长度守卫原先嵌套在紧邻的「长度 4」通用实例块内，
			// 条件恒假 ⇒ 永不命中 ⇒ 落到方法末尾的 404。现提升到与 cancel 相同的块外位置，匹配条件保持不变。
			if (seg.Length is 5 or 6 or 8 && seg[1].Equals("instances", StringComparison.OrdinalIgnoreCase))
			{
				string instanceId = seg[2];
				string action = seg[3];

				// /api/instances/{id}/saves/{folder}/{backup|delete|open|backups}
				if (seg.Length == 6 && action.Equals("saves", StringComparison.OrdinalIgnoreCase))
				{
					string folderName = seg[4];
					string saveAction = seg[5];
					if (saveAction.Equals("backup", StringComparison.OrdinalIgnoreCase) && method == "POST")
					{
						await HandleCreateSaveBackupAsync(response, instanceId, folderName);
						return;
					}

					if (saveAction.Equals("delete", StringComparison.OrdinalIgnoreCase) && method == "POST")
					{
						await HandleDeleteSaveAsync(response, instanceId, folderName);
						return;
					}

					if (saveAction.Equals("open", StringComparison.OrdinalIgnoreCase) && method == "POST")
					{
						await HandleOpenSaveDirectoryAsync(response, instanceId, folderName);
						return;
					}

					if (saveAction.Equals("backups", StringComparison.OrdinalIgnoreCase) && method == "GET")
					{
						await HandleListSaveBackupsAsync(response, instanceId, folderName);
						return;
					}
				}

				// /api/instances/{id}/saves/{folder}/backups/{backupName}/restore
				if (seg.Length == 8 && action.Equals("saves", StringComparison.OrdinalIgnoreCase) && method == "POST")
				{
					string folderName3 = seg[4];
					string backupName = seg[6];
					if (seg[5].Equals("backups", StringComparison.OrdinalIgnoreCase) && seg[7].Equals("restore", StringComparison.OrdinalIgnoreCase))
					{
						await HandleRestoreSaveBackupAsync(response, instanceId, folderName3, backupName);
						return;
					}
				}

				// /api/instances/{id}/bisect/{start|test|giveup}
				if (seg.Length == 5 && action.Equals("bisect", StringComparison.OrdinalIgnoreCase))
				{
					string bisectAction = seg[4];
					if (bisectAction.Equals("start", StringComparison.OrdinalIgnoreCase) && method == "POST")
					{
						await HandleBisectStartAsync(response, instanceId);
						return;
					}

					if (bisectAction.Equals("test", StringComparison.OrdinalIgnoreCase) && method == "POST")
					{
						await HandleBisectTestAsync(request, response, instanceId);
						return;
					}

					if (bisectAction.Equals("giveup", StringComparison.OrdinalIgnoreCase) && method == "POST")
					{
						await HandleBisectGiveUpAsync(response, instanceId);
						return;
					}

					// MR07：重启后从落盘记录恢复或继续上一有效轮。
					if (bisectAction.Equals("resume", StringComparison.OrdinalIgnoreCase) && method == "POST")
					{
						await HandleBisectResumeAsync(request, response, instanceId);
						return;
					}
				}

				if (seg.Length == 6 && action.Equals("mods", StringComparison.OrdinalIgnoreCase))
				{
					string fileName = seg[4];
					string modAction = seg[5];
					if (modAction.Equals("toggle", StringComparison.OrdinalIgnoreCase) && method == "POST")
					{
						await HandleToggleModAsync(response, instanceId, fileName);
						return;
					}

					if (modAction.Equals("delete", StringComparison.OrdinalIgnoreCase) && method == "POST")
					{
						await HandleDeleteModAsync(response, instanceId, fileName);
						return;
					}

					// MR05：事务化替换/更新（新包先校验，再隔离旧包，失败回滚）
					if (modAction.Equals("replace", StringComparison.OrdinalIgnoreCase) && method == "POST")
					{
						await HandleReplaceModAsync(request, response, instanceId, fileName);
						return;
					}
				}

				// MR04：把某次可恢复删除隔离的文件恢复到原位置。
				// /api/instances/{id}/recovery/{operationId}/restore
				if (seg.Length == 6 && action.Equals("recovery", StringComparison.OrdinalIgnoreCase) && method == "POST")
				{
					if (seg[5].Equals("restore", StringComparison.OrdinalIgnoreCase))
					{
						await HandleRestoreRecoveryAsync(request, response, instanceId, seg[4]);
						return;
					}
				}
			}

			if (seg.Length == 4 && seg[1].Equals("instances", StringComparison.OrdinalIgnoreCase))
			{
				string instanceId = seg[2];
				string action = seg[3];
				if (action.Equals("delete", StringComparison.OrdinalIgnoreCase) && method == "POST")
				{
					await HandleDeleteInstanceAsync(response, instanceId);
					return;
				}

				if (action.Equals("launch", StringComparison.OrdinalIgnoreCase) && method == "POST")
				{
					await HandleLaunchAsync(response, instanceId);
					return;
				}

				if (action.Equals("diagnose", StringComparison.OrdinalIgnoreCase) && method == "POST")
				{
					await HandleDiagnoseInstanceAsync(request, response, instanceId);
					return;
				}

				if (action.Equals("prelaunch-check", StringComparison.OrdinalIgnoreCase) && method == "GET")
				{
					await HandlePrelaunchCheckAsync(response, instanceId);
					return;
				}

				if (seg.Length == 4 && action.Equals("saves", StringComparison.OrdinalIgnoreCase) && method == "GET")
				{
					await HandleListSavesAsync(response, instanceId);
					return;
				}

				if (action.Equals("mods", StringComparison.OrdinalIgnoreCase) && method == "GET")
				{
					await HandleListModsAsync(response, instanceId);
					return;
				}

				if (action.Equals("resourcepacks", StringComparison.OrdinalIgnoreCase) && method == "GET")
				{
					await HandleListResourcePacksAsync(response, instanceId);
					return;
				}

				if (action.Equals("shaderpacks", StringComparison.OrdinalIgnoreCase) && method == "GET")
				{
					await HandleListShaderPacksAsync(response, instanceId);
					return;
				}

				// MR07：查询是否有未完成的二分定位会话（只读，不触碰游戏文件）。
				if (action.Equals("bisect", StringComparison.OrdinalIgnoreCase) && method == "GET")
				{
					await HandleBisectPendingAsync(response, instanceId);
					return;
				}

				// MR04：恢复区列表。只读恢复根与配置，不触碰游戏文件。
				if (action.Equals("recovery", StringComparison.OrdinalIgnoreCase) && method == "GET")
				{
					await HandleListRecoveryAsync(response, instanceId);
					return;
				}

			}

			if (seg.Length == 2 && seg[1].Equals("accounts", StringComparison.OrdinalIgnoreCase) && method == "GET")
			{
				await HandleListAccountsAsync(response);
				return;
			}

			if (seg.Length == 3 && seg[1].Equals("accounts", StringComparison.OrdinalIgnoreCase) && method == "DELETE")
			{
				await HandleDeleteAccountAsync(response, seg[2]);
				return;
			}

			if (seg.Length >= 3 && seg[1].Equals("accounts", StringComparison.OrdinalIgnoreCase) && method == "POST")
			{
				if (seg[2].Equals("offline", StringComparison.OrdinalIgnoreCase))
				{
					await HandleAddOfflineAccountAsync(request, response);
					return;
				}

				if (seg[2].Equals("select", StringComparison.OrdinalIgnoreCase))
				{
					await HandleSelectAccountAsync(request, response);
					return;
				}

				if (seg[2].Equals("microsoft", StringComparison.OrdinalIgnoreCase))
				{
					if (seg.Length == 4 && seg[3].Equals("device", StringComparison.OrdinalIgnoreCase))
					{
						await HandleMicrosoftDeviceStartAsync(response);
						return;
					}
					if (seg.Length == 4 && seg[3].Equals("poll", StringComparison.OrdinalIgnoreCase))
					{
						await HandleMicrosoftDevicePollAsync(response);
						return;
					}
					await HandleMicrosoftLoginAsync(response);
					return;
				}

				if (seg[2].Equals("refresh-skin", StringComparison.OrdinalIgnoreCase))
				{
					await HandleRefreshSkinAsync(request, response);
					return;
				}

				if (seg[2].Equals("authlib", StringComparison.OrdinalIgnoreCase))
				{
					await HandleAuthlibLoginAsync(request, response);
					return;
				}
			}

			if (seg.Length == 3 && seg[1].Equals("accounts", StringComparison.OrdinalIgnoreCase) && seg[2].Equals("skin", StringComparison.OrdinalIgnoreCase) && method == "POST")
			{
				await HandleUploadSkinAsync(request, response);
				return;
			}

			if (seg.Length == 2 && seg[1].Equals("versions", StringComparison.OrdinalIgnoreCase) && method == "GET")
			{
				await HandleListVersionsAsync(response);
				return;
			}

			if (seg.Length == 3 && seg[1].Equals("versions", StringComparison.OrdinalIgnoreCase))
			{
				if (seg[2].Equals("remote", StringComparison.OrdinalIgnoreCase) && method == "GET")
				{
					await HandleListRemoteVersionsAsync(response);
					return;
				}

				if (seg[2].Equals("download", StringComparison.OrdinalIgnoreCase) && method == "POST")
				{
					await HandleDownloadVersionAsync(request, response);
					return;
				}
			}

			if (seg.Length == 2 && seg[1].Equals("news", StringComparison.OrdinalIgnoreCase) && method == "GET")
			{
				await HandleListNewsAsync(request, response);
				return;
			}
			if (seg.Length == 2 && seg[1].Equals("downloads", StringComparison.OrdinalIgnoreCase) && method == "GET")
			{
				await HandleListDownloadsAsync(response);
				return;
			}

			if (seg.Length == 2 && seg[1].Equals("update", StringComparison.OrdinalIgnoreCase) && method == "GET")
			{
				await HandleUpdateStatusAsync(response);
				return;
			}

			if (seg.Length == 3 && seg[1].Equals("update", StringComparison.OrdinalIgnoreCase))
			{
				if (seg[2].Equals("check", StringComparison.OrdinalIgnoreCase) && method == "GET")
				{
					await HandleCheckUpdateAsync(response);
					return;
				}

				if (seg[2].Equals("download", StringComparison.OrdinalIgnoreCase) && method == "POST")
				{
					await HandleStartUpdateDownloadAsync(response);
					return;
				}

				if (seg[2].Equals("apply", StringComparison.OrdinalIgnoreCase) && method == "POST")
				{
					await HandleApplyUpdateAsync(response);
					return;
				}
			}

			if (seg.Length == 2 && seg[1].Equals("config", StringComparison.OrdinalIgnoreCase) && method == "POST")
			{
				await HandleUpdateConfigAsync(request, response);
				return;
			}

			if (seg.Length == 2 && seg[1].Equals("worlds", StringComparison.OrdinalIgnoreCase) && method == "GET")
			{
				await HandleListWorldsAsync(response);
				return;
			}

			if (seg.Length >= 2 && seg[1].Equals("content", StringComparison.OrdinalIgnoreCase) && method == "GET")
			{
				if (seg.Length == 2)
				{
					await HandleSearchContentAsync(request, response);
					return;
				}

				if (seg.Length == 3 && seg[2].Equals("search", StringComparison.OrdinalIgnoreCase))
				{
					await HandleSearchContentAsync(request, response);
					return;
				}

				if (seg.Length == 3 && seg[2].Equals("tasks", StringComparison.OrdinalIgnoreCase))
				{
					await HandleListContentTasksAsync(response);
					return;
				}

				if (seg.Length == 3 && seg[2].Equals("icon", StringComparison.OrdinalIgnoreCase))
				{
					await HandleContentIconAsync(request, response);
					return;
				}
			}

			if (seg.Length == 3 && seg[1].Equals("content", StringComparison.OrdinalIgnoreCase) && seg[2].Equals("install", StringComparison.OrdinalIgnoreCase) && method == "POST")
			{
				await HandleContentInstallAsync(request, response);
				return;
			}

			if (seg.Length == 2 && seg[1].Equals("java", StringComparison.OrdinalIgnoreCase) && method == "GET")
			{
				await HandleListJavaAsync(response);
				return;
			}

			if (seg.Length == 2 && seg[1].Equals("stats", StringComparison.OrdinalIgnoreCase) && method == "GET")
			{
				await HandleGetStatsAsync(response);
				return;
			}

			if (seg.Length == 2 && seg[1].Equals("sources", StringComparison.OrdinalIgnoreCase) && method == "GET")
			{
				await HandleListSourcesAsync(response);
				return;
			}

			if (seg.Length == 3 && seg[1].Equals("sources", StringComparison.OrdinalIgnoreCase) && seg[2].Equals("select", StringComparison.OrdinalIgnoreCase) && method == "POST")
			{
				await HandleSelectSourceAsync(request, response);
				return;
			}

			if (seg.Length == 2 && seg[1].Equals("servers", StringComparison.OrdinalIgnoreCase))
			{
				if (method == "GET")
				{
					await HandleListServersAsync(response);
					return;
				}

				if (method == "POST")
				{
					await HandleAddServerAsync(request, response);
					return;
				}
			}

			if (seg.Length == 4 && seg[1].Equals("servers", StringComparison.OrdinalIgnoreCase) && method == "POST")
			{
				string serverId = seg[2];
				string action = seg[3];
				if (action.Equals("ping", StringComparison.OrdinalIgnoreCase))
				{
					await HandlePingServerAsync(response, serverId);
					return;
				}

				if (action.Equals("delete", StringComparison.OrdinalIgnoreCase))
				{
					await HandleDeleteServerAsync(response, serverId);
					return;
				}
			}

			if (seg.Length == 4 && seg[1].Equals("accounts", StringComparison.OrdinalIgnoreCase) && seg[3].Equals("skin-image", StringComparison.OrdinalIgnoreCase) && method == "GET")
			{
				await HandleAccountSkinImageAsync(response, seg[2]);
				return;
			}

			if (seg.Length == 2 && seg[1].Equals("news-image", StringComparison.OrdinalIgnoreCase) && method == "GET")
			{
				await HandleNewsImageAsync(request, response);
				return;
			}

			// R2-03：/api/news-open POST — 客户端只传 linkId，服务端取回 URL 后二次白名单校验并经受控 opener 打开
			if (seg.Length == 2 && seg[1].Equals("news-open", StringComparison.OrdinalIgnoreCase) && method == "POST")
			{
				await HandleNewsOpenAsync(request, response);
				return;
			}

			await WriteJsonAsync(response, 404, new { error = $"未找到接口：{method} {path}" });
		}
		catch (InvalidOperationException ex)
		{
			await WriteJsonAsync(response, 400, new { error = ex.Message });
		}
		catch (Exception ex)
		{
			Debug.WriteLine($"[LocalApi] api error: {ex}");
			await WriteJsonAsync(response, 500, new { error = ex.Message });
		}
	}

	/* ================= 配置读写（全量落盘，与桌面端共用 config.json） ================= */

	// MR04：恢复区根目录。生产默认在配置目录下的 recovery/（位于游戏目录之外，
	// 游戏目录被删也不会丢隔离副本）；测试用 OverrideRecoveryRootForTest 注入临时目录，
	// 绝不触碰真实 %APPDATA%。scope 释放时自动还原。
	private static string? _recoveryRootOverride;

	private static string ResolveRecoveryRoot() =>
		_recoveryRootOverride ?? Path.Combine(PlatformPaths.GetConfigDirectory(), "recovery");

	private static FileRecoveryService CreateRecoveryService() => new FileRecoveryService(ResolveRecoveryRoot());

	internal static IDisposable OverrideRecoveryRootForTest(string root)
	{
		if (string.IsNullOrWhiteSpace(root)) throw new ArgumentNullException(nameof(root));
		string previous = _recoveryRootOverride;
		_recoveryRootOverride = root;
		return new RecoveryRootOverrideScope(previous);
	}

	private sealed class RecoveryRootOverrideScope : IDisposable
	{
		private readonly string? _previous;
		private bool _disposed;

		public RecoveryRootOverrideScope(string? previous) => _previous = previous;

		public void Dispose()
		{
			if (_disposed) return;
			_disposed = true;
			_recoveryRootOverride = _previous;
		}
	}

	// MR08：诊断报告历史的根目录（本地，游戏目录之外）。测试可重定向。
	private static string? _diagnosticStoreRootOverride;

	private static string ResolveDiagnosticStoreRoot() =>
		_diagnosticStoreRootOverride ?? Path.Combine(PlatformPaths.GetConfigDirectory(), "diagnostics");

	private static DiagnosticReportService CreateDiagnosticStore() => new DiagnosticReportService(ResolveDiagnosticStoreRoot());

	internal static IDisposable OverrideDiagnosticStoreRootForTest(string root)
	{
		if (string.IsNullOrWhiteSpace(root)) throw new ArgumentNullException(nameof(root));
		string previous = _diagnosticStoreRootOverride;
		_diagnosticStoreRootOverride = root;
		return new DiagnosticStoreOverrideScope(previous);
	}

	private sealed class DiagnosticStoreOverrideScope : IDisposable
	{
		private readonly string? _previous;
		private bool _disposed;

		public DiagnosticStoreOverrideScope(string? previous) => _previous = previous;

		public void Dispose()
		{
			if (_disposed) return;
			_disposed = true;
			_diagnosticStoreRootOverride = _previous;
		}
	}

	// MR07：二分定位会话的落盘根（游戏目录之外）。测试同样可重定向。
	private static string? _bisectStoreRootOverride;

	private static string ResolveBisectStoreRoot() =>
		_bisectStoreRootOverride ?? Path.Combine(PlatformPaths.GetConfigDirectory(), "bisect");

	private static BisectRecoveryStore CreateBisectStore() => new BisectRecoveryStore(ResolveBisectStoreRoot());

	internal static IDisposable OverrideBisectStoreRootForTest(string root)
	{
		if (string.IsNullOrWhiteSpace(root)) throw new ArgumentNullException(nameof(root));
		string previous = _bisectStoreRootOverride;
		_bisectStoreRootOverride = root;
		return new BisectStoreOverrideScope(previous);
	}

	private sealed class BisectStoreOverrideScope : IDisposable
	{
		private readonly string? _previous;
		private bool _disposed;

		public BisectStoreOverrideScope(string? previous) => _previous = previous;

		public void Dispose()
		{
			if (_disposed) return;
			_disposed = true;
			_bisectStoreRootOverride = _previous;
		}
	}

	// R2-02 返工（review-fix-1）：最小 internal IConfigStore 测试注入缝。
	// 生产默认仍走 ConfigStore（不改变生产配置路径、不触发 SecretStore/.bak/.prev）。
	// 仅测试可调用 OverrideConfigStoreForTest；scope 释放时自动还原。
	internal interface IConfigStore
	{
		AppConfig Load();
		void Save(AppConfig config);
	}

	private sealed class ProductionConfigStore : IConfigStore
	{
		public AppConfig Load() => ConfigStore.LoadAsync().GetAwaiter().GetResult();
		public void Save(AppConfig config) => ConfigStore.SaveAsync(config).GetAwaiter().GetResult();
	}

	private static IConfigStore _configStoreOverride;
	private static readonly IConfigStore _defaultConfigStore = new ProductionConfigStore();

	internal static IDisposable OverrideConfigStoreForTest(IConfigStore store)
	{
		if (store == null) throw new ArgumentNullException(nameof(store));
		lock (ConfigGate)
		{
			_configStoreOverride = store;
		}
		return new ConfigStoreOverrideScope();
	}

	private sealed class ConfigStoreOverrideScope : IDisposable
	{
		private bool _disposed;
		public void Dispose()
		{
			if (_disposed) return;
			_disposed = true;
			lock (ConfigGate)
			{
				_configStoreOverride = null;
			}
		}
	}

	private static AppConfig LoadConfig()
	{
		lock (ConfigGate)
		{
			IConfigStore store = _configStoreOverride ?? _defaultConfigStore;
			AppConfig config = store.Load();
			MirrorHelper.SelectedKey = string.IsNullOrWhiteSpace(config.DownloadSource) ? "official" : config.DownloadSource;
			return config;
		}
	}

	private static void SaveConfig(AppConfig config)
	{
		lock (ConfigGate)
		{
			MirrorHelper.SelectedKey = string.IsNullOrWhiteSpace(config.DownloadSource) ? "official" : config.DownloadSource;
			RefreshApiHttpProxy(config);
			IConfigStore store = _configStoreOverride ?? _defaultConfigStore;
			store.Save(config);
		}
	}

	private static string ResolveGameDirectory(AppConfig config, GameInstance instance)
	{
		string dir = instance?.GameDirectory;
		if (string.IsNullOrWhiteSpace(dir))
		{
			dir = config.GameDirectory;
		}

		return string.IsNullOrWhiteSpace(dir) ? PlatformPaths.GetDefaultMinecraftDirectory() : dir;
	}

	private static GameInstance RequireInstance(AppConfig config, string instanceId)
	{
		return config.Instances.FirstOrDefault(x => x.Id == instanceId)
			?? throw new InvalidOperationException("实例不存在：" + instanceId);
	}

	/* ================= API handlers ================= */

	private static async Task HandleGetStateAsync(HttpListenerResponse response)
	{
		AppConfig config = LoadConfig();
		List<object> instances = config.Instances.Select(x => BuildInstanceSummary(config, x).GetAwaiter().GetResult()).ToList();
		await WriteJsonAsync(response, 200, new
		{
			version = LauncherService.LauncherVersion,
			pid = Environment.ProcessId,
			config = new
			{
				config.GameDirectory,
				config.JavaPath,
				config.PlayerName,
				config.MaxMemoryMb,
				config.UseAutoMemory,
				config.WindowWidth,
				config.WindowHeight,
				config.ServerHost,
				config.ServerPort,
				config.UseMirror,
				downloadSource = string.IsNullOrWhiteSpace(config.DownloadSource) ? "official" : config.DownloadSource,
				config.ProxyEnabled,
				config.ProxyHost,
				config.ProxyPort,
				config.ProxyUsername,
				proxyPasswordConfigured = !string.IsNullOrEmpty(config.ProxyPassword),
				config.MinimizeOnLaunch,
				config.AutoCloseOnExit,
				// R2-02：新闻图片 fake-ip 兼容开关（默认 false，fail closed）
				config.NewsFakeIpCompat,
				config.SelectedVersion,
				curseForgeApiKeyConfigured = !string.IsNullOrEmpty(config.CurseForgeApiKey),
				config.SelectedInstanceId,
				config.SelectedAccountId,
				config.AccountMode,
				config.AiDiagnosisEnabled,
				selectedAiProviderId = config.SelectedAiProviderId,
				aiProviders = config.AiProviders.Select(p => new
				{
					p.Id,
					p.Name,
					p.BaseUrl,
					p.Model,
					keyConfigured = !string.IsNullOrEmpty(p.ApiKey)
				})
			},
			instances,
			accounts = config.Accounts.Select(BuildAccountSummary),
			java = JavaLocator.ScanAsync(null).GetAwaiter().GetResult()
		});
	}

	private static async Task HandleListInstancesAsync(HttpListenerResponse response)
	{
		AppConfig config = LoadConfig();
		List<object> instances = config.Instances.Select(x => BuildInstanceSummary(config, x).GetAwaiter().GetResult()).ToList();
		await WriteJsonAsync(response, 200, new { instances, selectedInstanceId = config.SelectedInstanceId });
	}

	private static async Task<object> BuildInstanceSummary(AppConfig config, GameInstance instance)
	{
		string gameDir = ResolveGameDirectory(config, instance);
		int savesCount = 0;
		int modsCount = 0;
		int resourcePacksCount = 0;
		int shaderPacksCount = 0;
		try
		{
			savesCount = new SaveService(gameDir).GetSaves(instance).Count;
		}
		catch
		{
		}

		try
		{
			modsCount = (await new ModService(gameDir).GetModsAsync(instance)).Count;
		}
		catch
		{
		}

		try
		{
			resourcePacksCount = new ResourcePackService(gameDir).GetResourcePacks(instance).Count;
		}
		catch
		{
		}

		try
		{
			shaderPacksCount = new ShaderPackService(gameDir).GetPacks(instance).Count;
		}
		catch
		{
		}

		// MR03：同一游戏目录被多个实例共用时，移除确认必须提示"数据仍被其他实例使用"。
		bool sharedGameDirectory = config.Instances.Any(x => !ReferenceEquals(x, instance)
			&& string.Equals(ResolveGameDirectory(config, x), gameDir, StringComparison.OrdinalIgnoreCase));

		return new
		{
			instance.Id,
			instance.Name,
			instance.MinecraftVersion,
			gameDirectory = gameDir,
			sharedGameDirectory,
			instance.JavaPath,
			instance.MaxMemoryMb,
			instance.UseAutoMemory,
			instance.WindowWidth,
			instance.WindowHeight,
			instance.ServerAddress,
			instance.ServerPort,
			instance.AccountMode,
			instance.LoaderType,
			instance.LoaderVersion,
			instance.BaseMinecraftVersion,
			instance.LastLaunchTime,
			instance.TotalPlaySeconds,
			instance.PlayCount,
			instance.Notes,
			instance.CustomJvmArgs,
			instance.CustomGameArgs,
			instance.Modpack,
			savesCount,
			modsCount,
			resourcePacksCount,
			shaderPacksCount,
			versions = VersionResolver.ListLocalVersions(gameDir)
		};
	}

	private static async Task HandleInstanceDetailAsync(HttpListenerResponse response, string instanceId)
	{
		AppConfig config = LoadConfig();
		GameInstance instance = RequireInstance(config, instanceId);
		object summary = await BuildInstanceSummary(config, instance);
		await WriteJsonAsync(response, 200, new { instance = summary, selectedInstanceId = config.SelectedInstanceId });
	}

	private static async Task HandleCreateInstanceAsync(HttpListenerRequest request, HttpListenerResponse response)
	{
		JsonDocument body = await ReadBodyAsync(request);
		string name = JsonUtil.GetString(body.RootElement, "name")?.Trim();
		string version = JsonUtil.GetString(body.RootElement, "version")?.Trim();
		if (string.IsNullOrWhiteSpace(name))
		{
			throw new InvalidOperationException("实例名称不能为空");
		}

		AppConfig config = LoadConfig();
		GameInstance instance = InstanceService.CreateDefault(string.IsNullOrWhiteSpace(version) ? null : version, PlatformPaths.GetDefaultMinecraftDirectory());
		instance.Name = name;
		config.Instances.Add(instance);
		config.SelectedInstanceId = instance.Id;
		SaveConfig(config);
		object summary = await BuildInstanceSummary(config, instance);
		await WriteJsonAsync(response, 200, new { ok = true, instance = summary });
	}

	/// <summary>
	/// MR03：仅把实例"从列表移除" —— 只删除配置记录，**不删除任何游戏文件**。
	/// 游戏目录、存档、Mod、资源包、光影全部原样保留，之后可用 <c>/api/instances/register</c> 挂回。
	/// 活动状态保护：正在进行 Mod 二分定位的实例必须先结束定位，否则会留下无主的 Bisect 会话
	/// （文件半禁用、恢复依据随后丢失，见 MR06/MR07）。
	/// </summary>
	private static async Task HandleDeleteInstanceAsync(HttpListenerResponse response, string instanceId)
	{
		AppConfig config = LoadConfig();
		GameInstance instance = RequireInstance(config, instanceId);

		ModBisectSession? activeBisect = ModBisectService.Get(instanceId);
		if (activeBisect != null && !activeBisect.Finished)
		{
			throw new InvalidOperationException("该实例正在进行 Mod 二分定位，请先「放弃」或结束定位，再把它从列表移除。");
		}

		// MR03 收尾：补上"实例正在运行不得移除"的守卫。
		// 与上面的 Bisect 守卫同一错误通道（400），保持这个 handler 的行为一致。
		if (RunningInstanceRegistry.IsRunning(instanceId, out int runningPid))
		{
			throw new InvalidOperationException(
				$"该实例正在运行（进程 {runningPid}），请先退出游戏，再把它从列表移除。");
		}

		string gameDir = ResolveGameDirectory(config, instance);
		int savesCount = 0;
		try
		{
			savesCount = new SaveService(gameDir).GetSaves(instance).Count;
		}
		catch
		{
		}

		bool sharedDirectory = config.Instances.Any(x => x.Id != instanceId
			&& string.Equals(ResolveGameDirectory(config, x), gameDir, StringComparison.OrdinalIgnoreCase));

		// 只改配置：此处不存在任何 File/Directory 写操作。
		config.Instances.RemoveAll(x => x.Id == instanceId);
		if (config.SelectedInstanceId == instanceId)
		{
			config.SelectedInstanceId = config.Instances.FirstOrDefault()?.Id ?? string.Empty;
		}

		SaveConfig(config);
		await WriteJsonAsync(response, 200, new
		{
			ok = true,
			removedId = instance.Id,
			removedName = instance.Name,
			gameDirectory = gameDir,
			savesCount,
			sharedDirectory,
			keptFiles = true,
			selectedInstanceId = config.SelectedInstanceId
		});
	}

	/// <summary>
	/// MR03：把磁盘上已存在的游戏目录重新挂回实例列表。
	/// 只新增配置记录，**不创建、不移动、不删除任何文件**；已存在的存档与 Mod 原样可见。
	/// </summary>
	private static async Task HandleRegisterInstanceAsync(HttpListenerRequest request, HttpListenerResponse response)
	{
		JsonDocument body = await ReadBodyAsync(request);
		string rawDir = JsonUtil.GetString(body.RootElement, "gameDirectory")?.Trim() ?? string.Empty;
		string name = JsonUtil.GetString(body.RootElement, "name")?.Trim() ?? string.Empty;
		string version = JsonUtil.GetString(body.RootElement, "minecraftVersion")?.Trim() ?? string.Empty;

		if (string.IsNullOrWhiteSpace(rawDir))
		{
			throw new InvalidOperationException("请填写要挂回的游戏目录");
		}

		string fullDir;
		try
		{
			fullDir = Path.GetFullPath(rawDir);
		}
		catch (Exception)
		{
			throw new InvalidOperationException("游戏目录路径无效：" + rawDir);
		}

		if (!Directory.Exists(fullDir))
		{
			throw new InvalidOperationException("目录不存在，无法挂回：" + fullDir);
		}

		AppConfig config = LoadConfig();
		bool duplicate = config.Instances.Any(x => string.Equals(
			SafeFullPath(x.GameDirectory), fullDir, StringComparison.OrdinalIgnoreCase));
		if (duplicate)
		{
			throw new InvalidOperationException("该目录已在实例列表中，无需重复添加：" + fullDir);
		}

		GameInstance instance = InstanceService.CreateDefault(
			string.IsNullOrWhiteSpace(version) ? null : version, fullDir);
		instance.GameDirectory = fullDir;
		if (!string.IsNullOrWhiteSpace(name))
		{
			instance.Name = name;
		}

		// 只改配置：此处不存在任何 File/Directory 写操作。
		config.Instances.Add(instance);
		config.SelectedInstanceId = instance.Id;
		SaveConfig(config);

		object summary = await BuildInstanceSummary(config, instance);
		await WriteJsonAsync(response, 200, new { ok = true, instance = summary, registeredExistingDirectory = true });
	}

	private static string SafeFullPath(string? path)
	{
		if (string.IsNullOrWhiteSpace(path))
		{
			return string.Empty;
		}

		try
		{
			return Path.GetFullPath(path);
		}
		catch
		{
			return path;
		}
	}
	private static async Task HandleImportInstanceAsync(HttpListenerRequest request, HttpListenerResponse response)
	{
		JsonDocument body = await ReadBodyAsync(request);
		string fileName = Path.GetFileName(JsonUtil.GetString(body.RootElement, "fileName")?.Trim() ?? "pack.zip");
		string fileBase64 = JsonUtil.GetString(body.RootElement, "fileBase64")?.Trim() ?? string.Empty;
		// MR11：可选的 operationId —— 传了就能被 POST /api/instances/import/cancel 取消。
		string operationId = JsonUtil.GetString(body.RootElement, "operationId")?.Trim() ?? string.Empty;
		if (operationId.Length > 0 && (operationId.Length < 8 || operationId.Length > 128))
		{
			throw new InvalidOperationException("operationId 长度必须在 8~128 之间");
		}
		if (string.IsNullOrWhiteSpace(fileBase64))
		{
			throw new InvalidOperationException("fileBase64 不能为空");
		}

		byte[] bytes;
		try
		{
			bytes = Convert.FromBase64String(fileBase64);
		}
		catch (FormatException)
		{
			throw new InvalidOperationException("上传内容不是有效的 base64 数据");
		}
		if (bytes.Length > MaxImportBytes) throw new InvalidOperationException("实例包超过 24 MiB 的 JSON 上传上限，请使用流式导入。");

		string tempDir = Path.Combine(Path.GetTempPath(), "pineglow-import-" + Guid.NewGuid().ToString("N"));
		Directory.CreateDirectory(tempDir);
		string zipPath = CreateSafeTemporaryUploadPath(tempDir, fileName);
		CancellationTokenSource? importCts = null;
		try
		{
			await File.WriteAllBytesAsync(zipPath, bytes);
			AppConfig config = LoadConfig();
			string defaultGameDir = string.IsNullOrWhiteSpace(config.GameDirectory) ? PlatformPaths.GetDefaultMinecraftDirectory() : config.GameDirectory;
			InstancePackService packService = new InstancePackService(ApiHttp, defaultGameDir, _ => { });

			CancellationToken ct = CancellationToken.None;
			if (operationId.Length > 0)
			{
				importCts = new CancellationTokenSource();
				// 先取 token 再注册：注册表在 cancel-before-register 分支里会 cancel 并 dispose 这个 CTS
				// （token 回调 Remove 会 Dispose），之后再读 importCts.Token 会抛 ObjectDisposedException。
				// CancellationToken 是结构体，事先取到的副本在源被 dispose 后仍可安全查询取消状态。
				ct = importCts.Token;
				if (!PackOps.Register(ImportOperationScope, operationId, importCts))
				{
					// MR11：注册失败有两种原因，必须区分开。
					// Get 返回 null 说明表里只有墓碑 —— 即"取消先于服务端受理"（用户在上传阶段就点了取消）。
					bool cancelledBeforeReceipt = PackOps.Get(ImportOperationScope, operationId) == null;
					await WriteJsonAsync(response, cancelledBeforeReceipt ? 409 : 400, new
					{
						ok = false,
						cancelled = cancelledBeforeReceipt,
						operationId,
						error = cancelledBeforeReceipt
							? "该导入已被取消（取消发生在服务端受理之前）。"
							: "operationId 已被占用/registry 满"
					});
					return;
				}
			}

			GameInstance newInstance;
			try
			{
				switch (InstancePackService.DetectModpackFormat(zipPath))
				{
					case ModpackArchiveFormat.Modrinth:
						newInstance = await packService.ImportModrinthPackAsync(zipPath, _ => { }, ct);
						break;
					case ModpackArchiveFormat.CurseForge:
						newInstance = await packService.ImportCurseForgePackAsync(zipPath, config.CurseForgeApiKey ?? string.Empty, _ => { }, ct);
						break;
					case ModpackArchiveFormat.Mcm:
						newInstance = packService.ImportMcm(zipPath);
						break;
					default:
						throw new InvalidOperationException("无法识别整合包格式：请上传 Modrinth (.mrpack)、CurseForge 或 MCM 格式的压缩包。");
				}
			}
			catch (OperationCanceledException)
			{
				// MR11：取消必须给出确定性结果，且**绝不能**留下半成品实例（游戏目录由导入器自行清理）。
				await WriteJsonAsync(response, 409, new
				{
					ok = false,
					cancelled = true,
					error = "导入已取消，未生成实例。"
				});
				return;
			}

			AppConfig latest = LoadConfig();
			latest.Instances.Add(newInstance);
			latest.SelectedInstanceId = newInstance.Id;
			SaveConfig(latest);
			await WriteJsonAsync(response, 200, new { ok = true, instanceId = newInstance.Id, name = newInstance.Name });
		}
		finally
		{
			if (operationId.Length > 0)
			{
				// 结束即退场：之后的迟到取消返回"没有可取消的操作"，不会误导用户。
				PackOps.Cancel(ImportOperationScope, operationId);
			}

			importCts?.Dispose();
			if (Directory.Exists(tempDir))
			{
				Directory.Delete(tempDir, recursive: true);
			}
		}
	}

	/// <summary>
	/// MR11：导入取消端点。语义与 AI 诊断的 cancel 一致：
	/// 重复取消幂等；不存在的 operationId 返回确定性结果，不泄露其他操作。
	/// </summary>
	private static async Task HandleCancelImportAsync(HttpListenerRequest request, HttpListenerResponse response)
	{
		string operationId = string.Empty;
		try
		{
			JsonDocument body = await ReadBodyAsync(request);
			operationId = JsonUtil.GetString(body.RootElement, "operationId")?.Trim() ?? string.Empty;
		}
		catch
		{
			// 无 body 时按空 operationId 处理，返回确定性结果
		}

		bool wasActive = operationId.Length > 0 && PackOps.Get(ImportOperationScope, operationId) != null;
		// 注意：Cancel 必须**无条件调用**。它除了取消在途操作，还负责登记 cancel-before-register 墓碑；
		// 写成 "cancelled = wasActive && Cancel(...)" 会因短路求值跳过登记，"取消先到" 的能力就没了（实测踩过）。
		bool cancelResult = operationId.Length > 0 && PackOps.Cancel(ImportOperationScope, operationId);
		bool cancelled = wasActive && cancelResult;
		// 没有在途操作时，取消以墓碑形式记录：该 operationId 之后才被受理会被直接取消。
		// 如实报成 pendingCancel，避免界面误报"已取消进行中的导入"。
		bool pendingCancel = operationId.Length > 0 && !wasActive;
		await WriteJsonAsync(response, 200, new
		{
			ok = true,
			operationId,
			cancelled,
			pendingCancel,
			message = cancelled ? "cancelled" : (pendingCancel ? "recorded_for_later" : "no_active_operation"),
		});
	}

	private static async Task HandlePrelaunchCheckAsync(HttpListenerResponse response, string instanceId)
	{
		AppConfig config = LoadConfig();
		GameInstance instance = RequireInstance(config, instanceId);
		List<string> errors = new List<string>();
		List<string> warnings = new List<string>();

		if (string.IsNullOrWhiteSpace(instance.MinecraftVersion))
		{
			errors.Add("实例未关联游戏版本，请先在设置中安装版本");
		}

		// Java 检查
		try
		{
			string javaPath = ResolveJavaPath(config, instance, instance.MinecraftVersion ?? string.Empty);
			if (!File.Exists(javaPath))
			{
				errors.Add("Java 运行时不存在：" + javaPath);
			}
		}
		catch (Exception ex)
		{
			errors.Add(ex.Message);
		}

		// 游戏目录存在性
		string gameDir = ResolveGameDirectory(config, instance);
		if (!Directory.Exists(gameDir))
		{
			warnings.Add("游戏目录不存在（首次启动将自动创建）：" + gameDir);
		}

		// 磁盘空间
		try
		{
			string root = Path.GetPathRoot(Path.GetFullPath(gameDir));
			if (!string.IsNullOrWhiteSpace(root) && Directory.Exists(root))
			{
				DriveInfo drive = new DriveInfo(root);
				if (drive.IsReady && drive.AvailableFreeSpace < 512L * 1024 * 1024)
				{
					warnings.Add($"磁盘剩余空间不足：{FormatBytes(drive.AvailableFreeSpace)}，建议保留至少 512MB");
				}
			}
		}
		catch
		{
		}

		// 内存检查（TotalAvailableMemoryBytes 为当前进程可用内存预算，跨平台无依赖）
		int maxMemoryMb = instance.MaxMemoryMb > 0 ? instance.MaxMemoryMb : config.MaxMemoryMb;
		long availableMb = 0;
		try
		{
			availableMb = GC.GetGCMemoryInfo().TotalAvailableMemoryBytes / (1024 * 1024);
		}
		catch
		{
		}

		if (availableMb > 0 && maxMemoryMb >= availableMb * 0.9)
		{
			warnings.Add($"分配内存 {maxMemoryMb}MB 接近当前可用内存 {availableMb}MB，可能导致卡顿或启动失败");
		}

		await WriteJsonAsync(response, 200, new
		{
			ok = errors.Count == 0,
			errors,
			warnings,
			maxMemoryMb,
			gameDir
		});
	}

	private static string FormatBytes(long bytes)
	{
		string[] units = new string[4] { "B", "KB", "MB", "GB" };
		double value = bytes;
		int idx = 0;
		while (value >= 1024.0 && idx < units.Length - 1)
		{
			value /= 1024.0;
			idx++;
		}
		return $"{value:0.##} {units[idx]}";
	}

	private static async Task HandleLaunchAsync(HttpListenerResponse response, string instanceId)
	{
		AppConfig config = LoadConfig();
		GameInstance instance = RequireInstance(config, instanceId);
		string gameDir = ResolveGameDirectory(config, instance);
		if (string.IsNullOrWhiteSpace(instance.MinecraftVersion))
		{
			throw new InvalidOperationException("实例未关联游戏版本，请先在设置中安装版本");
		}

		LauncherAccount account = config.Accounts.FirstOrDefault(x => x.Id == config.SelectedAccountId);
		string mode = account?.Type?.Trim().ToLowerInvariant() ?? "offline";
		string playerName = account?.UserName ?? config.PlayerName;
		string playerUuid = string.Empty;
		string accessToken = "0";
		string userType = "legacy";
		string xuid = string.Empty;
		string clientId = config.MicrosoftClientId;
		string customJvmArgs = instance.CustomJvmArgs ?? string.Empty;

		if (mode == "microsoft")
		{
			string refreshToken = account?.RefreshToken;
			if (string.IsNullOrWhiteSpace(refreshToken) && account is not null) refreshToken = SecretStore.Load(SecretStore.AccountToken(account.Id));
			if (string.IsNullOrWhiteSpace(config.MicrosoftClientId) || string.IsNullOrWhiteSpace(refreshToken))
			{
				throw new InvalidOperationException("正版账号刷新凭据不完整，请重新登录");
			}
			using CancellationTokenSource refreshCts = new CancellationTokenSource(TimeSpan.FromSeconds(60));
			MinecraftAccount refreshed = await new MicrosoftAuthService(ApiHttp).LoginWithRefreshTokenAsync(config.MicrosoftClientId, refreshToken, refreshCts.Token);
			playerName = refreshed.UserName;
			playerUuid = refreshed.Uuid;
			accessToken = refreshed.AccessToken;
			userType = "msa";
			xuid = refreshed.Xuid;
		}
		else if (mode == "authlib")
		{
			if (account == null || !account.IsThirdParty || string.IsNullOrWhiteSpace(account.UserName) || string.IsNullOrWhiteSpace(account.Uuid) || string.IsNullOrWhiteSpace(account.AccessToken) || string.IsNullOrWhiteSpace(account.AuthServerUrl))
			{
				throw new InvalidOperationException("第三方账号登录信息不完整，请重新添加该账号");
			}

			string agentPath = await new AuthlibInjectorService(new HttpClient()).EnsureAgentAsync(CancellationToken.None);
			playerName = account.UserName;
			playerUuid = account.Uuid;
			accessToken = account.AccessToken;
			userType = "mojang";
			clientId = string.Empty;
			customJvmArgs = AppendJvmArgument(customJvmArgs, $" -javaagent:\"{agentPath}\"={account.AuthServerUrl}");
		}

		// 代理参数传递给游戏进程
		if (config.ProxyEnabled && !string.IsNullOrWhiteSpace(config.ProxyHost) && config.ProxyPort > 0)
		{
			customJvmArgs = AppendJvmArgument(customJvmArgs, $"-Dhttp.proxyHost={config.ProxyHost} -Dhttp.proxyPort={config.ProxyPort} -Dhttps.proxyHost={config.ProxyHost} -Dhttps.proxyPort={config.ProxyPort}");
		}

		string javaPath = ResolveJavaPath(config, instance, instance.MinecraftVersion);
		LaunchProfile profile = new LaunchProfile
		{
			GameDirectory = gameDir,
			JavaPath = javaPath,
			VersionId = instance.MinecraftVersion,
			PlayerName = playerName,
			MaxMemoryMb = instance.MaxMemoryMb > 0 ? instance.MaxMemoryMb : config.MaxMemoryMb,
			WindowWidth = instance.WindowWidth,
			WindowHeight = instance.WindowHeight,
			ServerHost = instance.ServerAddress?.Trim() ?? string.Empty,
			ServerPort = instance.ServerPort > 0 ? instance.ServerPort.ToString() : "25565",
			AccountMode = mode,
			PlayerUuid = playerUuid,
			AccessToken = accessToken,
			UserType = userType,
			ClientId = clientId,
			Xuid = xuid,
			CustomJvmArgs = customJvmArgs,
			CustomGameArgs = instance.CustomGameArgs ?? string.Empty
		};

		Process process = await new LauncherService(msg => Debug.WriteLine("[launch] " + msg)).LaunchAsync(profile, CancellationToken.None);
		// MR03 收尾：启动成功即登记运行态；退出监听结束时清除（注册表本身也会自愈）。
		RunningInstanceRegistry.MarkRunning(instanceId, process);
		instance.LastLaunchTime = DateTimeOffset.Now;
		instance.PlayCount++;
		SaveConfig(config);
		bool minimizeOnLaunch = config.MinimizeOnLaunch;
		bool autoCloseOnExit = config.AutoCloseOnExit;
		// 挂进程退出事件：累加游玩时长；若开启"退出后自动关闭"，关闭启动器窗口
		_ = Task.Run(async () =>
		{
			try
			{
				DateTimeOffset start = DateTimeOffset.Now;
				await process.WaitForExitAsync();
				AppConfig latest = LoadConfig();
				GameInstance? target = latest.Instances.FirstOrDefault(x => x.Id == instanceId);
				if (target != null)
				{
					target.TotalPlaySeconds += (long)Math.Max(0, (DateTimeOffset.Now - start).TotalSeconds);
					SaveConfig(latest);
				}
				if (autoCloseOnExit)
				{
					Avalonia.Threading.Dispatcher.UIThread.Post(() =>
					{
						try
						{
							Environment.Exit(0);
						}
						catch
						{
						}
					});
				}
			}
			catch
			{
			}
			finally
			{
				// MR03 收尾：无论退出监听是否成功，都要清掉运行态登记。
				RunningInstanceRegistry.MarkExited(instanceId);
			}
		});
		await WriteJsonAsync(response, 200, new { ok = true, pid = process.Id, minimizeOnLaunch });
	}

	// Phase 3B v2 修复批次：AI 诊断操作注册表（per-request operationId → CTS）。
	private static readonly AiOperationRegistry AiOps = new AiOperationRegistry();

	// MR11：整合包导入的取消注册表。复用同一份带 TTL/容量/tombstone 的实现，
	// 用 ImportOperationScope 当作"实例维"的占位符（导入时实例还不存在）。
	private const string ImportOperationScope = "import";

	private static readonly AiOperationRegistry PackOps = new AiOperationRegistry();

	/// <summary>MR11 测试缝：让取消路由可以在没有真实导入在途的情况下被验证。</summary>
	internal static bool RegisterPackOperationForTest(string operationId, CancellationTokenSource cts) =>
		PackOps.Register(ImportOperationScope, operationId, cts);

	private static async Task HandleDiagnoseInstanceAsync(HttpListenerRequest request, HttpListenerResponse response, string instanceId)
	{
		AppConfig config = LoadConfig();
		GameInstance instance = RequireInstance(config, instanceId);
		string gameDir = ResolveGameDirectory(config, instance);

		int exitCode = 0;
		bool confirmAiSend = false;
		bool localOnly = false;
		string operationId = string.Empty;
		string locale = "zh";
		try
		{
			JsonDocument body = await ReadBodyAsync(request);
			if (body.RootElement.TryGetProperty("exitCode", out JsonElement ec) && ec.ValueKind == JsonValueKind.Number)
			{
				exitCode = ec.GetInt32();
			}
			if (body.RootElement.TryGetProperty("confirmAiSend", out JsonElement confirm) && confirm.ValueKind == JsonValueKind.True)
			{
				confirmAiSend = confirm.GetBoolean();
			}
			if (body.RootElement.TryGetProperty("localOnly", out JsonElement local) && local.ValueKind == JsonValueKind.True)
			{
				localOnly = local.GetBoolean();
			}
			if (body.RootElement.TryGetProperty("operationId", out JsonElement op) && op.ValueKind == JsonValueKind.String)
			{
				operationId = op.GetString() ?? string.Empty;
			}
			if (body.RootElement.TryGetProperty("locale", out JsonElement loc) && loc.ValueKind == JsonValueKind.String)
			{
				string? locStr = loc.GetString();
				if (locStr == "zh" || locStr == "en")
				{
					locale = locStr;
				}
			}
			// Phase 3B v3 修复：服务端不再生成 operationId；缺失/非法必须由客户端预生成。
			if (string.IsNullOrEmpty(operationId) || operationId.Length < 8 || operationId.Length > 128)
			{
				await WriteJsonAsync(response, 400, new { ok = false, error = "operationId 缺失或非法；必须由客户端预生成（crypto.randomUUID）" });
				return;
			}
		}
		catch
		{
			// 无 body 或非法 body 时按 400 fail closed；客户端必须预生成 operationId。
			await WriteJsonAsync(response, 400, new { ok = false, error = "body 缺失或非法；必须由客户端预生成 operationId" });
			return;
		}

		// Phase 3B v2 修复 P0-4 / P0-1：每个 AI 诊断的取消通过 operationId 注册到 AiOps；
		// 服务端在 DiagnoseStructuredAsync、HTTP send、响应读取、retry delay 共享同一 linked token。
		// 客户端通过 POST /api/instances/{id}/diagnose/cancel 触发取消。
		// 不再依赖 request.InputStream.CanRead（已被独立验收 § B1 反证）。
		using CancellationTokenSource operationCts = new CancellationTokenSource();
		bool registered = AiOps.Register(instanceId, operationId, operationCts);
		if (!registered)
		{
			// 注册失败（容量满或重复 operationId）：直接返回错误，避免污染 registry
			await WriteJsonAsync(response, 400, new { ok = false, error = "operationId 已被占用/registry 满", operationId });
			return;
		}

		CancellationToken linkedToken = operationCts.Token;
		string tail = CrashAnalyzerService.ReadNewestDiagnosticTail(gameDir);
		CrashAnalysis rule;
		try
		{
			rule = CrashAnalyzerService.Analyze(gameDir, exitCode);
		}
		catch
		{
			rule = new CrashAnalysis(string.Empty, Array.Empty<string>(), null);
		}

		ModHealthReport mods = new ModHealthReport();
		List<string> installedModFiles = new List<string>();
		try
		{
			List<ModFile> modList = await new ModService(gameDir).GetModsAsync(instance);
			mods = ModHealthService.Analyze(instance, modList);
			installedModFiles.AddRange(modList.Select(m => m.FileName));
		}
		catch
		{
			// Mod 健康检查失败时不影响 AI 诊断
		}

		string? javaVersion = null;
		try
		{
			JavaInfo javaInstallation = await JavaLocator.FindAsync();
			javaVersion = javaInstallation?.VersionText ?? javaInstallation?.Path;
		}
		catch
		{
		}

		DiagnosticSnapshot snapshot = new DiagnosticSnapshot
		{
			Context = DiagnosticContextFactory.Create(
				Environment.OSVersion.VersionString,
				LauncherService.LauncherVersion,
				instance,
				javaVersion,
				exitCode,
				string.Empty,
				DateTimeOffset.UtcNow),
			EvidenceLog = tail,
		};

		AiProviderProfile aiProfile = config.AiProviders.FirstOrDefault(p => p.Id == config.SelectedAiProviderId);
		bool configured = config.AiDiagnosisEnabled && aiProfile != null && !string.IsNullOrWhiteSpace(aiProfile.BaseUrl);
		string? aiText = null;
		string? aiFailedMsg = null;
		AiDiagnoseResult? aiResult = null;
		// Phase 3C-2 P0 修复：真实发送元数据。
		// - 服务端配置快照（aiProfile.Name / aiProfile.Model）由 LocalApi 闭包注入，
		//   AiDiagnoseService 不感知；URL 永不进入 providerName。
		// - 仅当 AiDiagnoseService.SendOnceAsync 紧贴 http.SendAsync 之前触发回调时填 sentAtUtc；
		//   localOnly / 未确认 / endpoint 被拒 / 发送前取消 都不填。
		DateTimeOffset? dispatchSentAtUtc = null;
		string resolvedProviderName = aiProfile?.Name ?? string.Empty;
		string resolvedModel = string.IsNullOrWhiteSpace(aiProfile?.Model) ? "deepseek-chat" : aiProfile!.Model!;
		// Gate R2 修复 P0-2：localOnly 必须独立于 configured。未配置 provider、关闭 AI 开关、
		// endpoint 不在 allowlist 等情况下，UI 仍可请求「仅本地分析」并得到本地规则/Mod 健康结果。
		if (localOnly || configured)
		{
			try
			{
				string baseUrl = aiProfile?.BaseUrl ?? string.Empty;
				string apiKey = aiProfile?.ApiKey ?? string.Empty;
				// per-operation 闭包：捕获服务端配置快照的 providerName/model，
				// 仅记录服务端实际发起 SendAsync 的 UTC 时间戳。
				Action<AiDispatchAttempt> onFirstSendAttempt = attempt =>
				{
					dispatchSentAtUtc = attempt.SentAtUtc;
				};
				aiResult = await AiDiagnoseService.DiagnoseStructuredAsync(
					AiHttp, baseUrl, apiKey, resolvedModel,
					snapshot, rule, mods, linkedToken,
					confirmAiSend: confirmAiSend, localOnly: localOnly,
					locale: locale,
					onFirstSendAttempt: onFirstSendAttempt);
				if (!aiResult.Ok)
				{
					aiFailedMsg = aiResult.ErrorCode + ": " + aiResult.Summary;
				}
			}
			catch (Exception ex)
			{
				aiFailedMsg = ex.Message;
			}
		}

		// MR08：把本次诊断记成一份冻结结构的报告（只写本地、脱敏后入库）。
		// 历史写入失败绝不能影响诊断本身，因此单独 try/catch。
		await RecordDiagnosticReportAsync(
			config, instance, operationId, snapshot, rule, mods, aiResult, aiFailedMsg,
			dispatchSentAtUtc, resolvedProviderName, resolvedModel, configured, localOnly,
			operationCts.IsCancellationRequested, tail);

		try
		{
			await WriteJsonAsync(response, 200, new
			{
				ok = true,
				hasTail = !string.IsNullOrEmpty(tail),
				snapshot = new
				{
					version = DiagnosticSnapshot.Version,
					id = snapshot.SnapshotId,
					context = new
					{
						operatingSystem = snapshot.Context.OperatingSystem,
						launcherVersion = snapshot.Context.LauncherVersion,
						minecraftVersion = snapshot.Context.MinecraftVersion,
						loaderType = snapshot.Context.LoaderType,
						loaderVersion = snapshot.Context.LoaderVersion,
						javaVersion = snapshot.Context.JavaVersion,
						maxMemoryMb = snapshot.Context.MaxMemoryMb,
						customJvmArgs = DiagnosticJvmArgsRedactor.Redact(snapshot.Context.CustomJvmArgs),
						exitCode = snapshot.Context.ExitCode,
						logSource = snapshot.Context.LogSource,
						logModifiedAt = snapshot.Context.LogModifiedAt,
						missingInformation = snapshot.Context.MissingInformation
					}
				},
				rule = new { summary = rule.Summary, suggestions = rule.Suggestions },
				mods = new
				{
					mods.EnabledCount,
					mods.DisabledCount,
					mods.OnlineManagedCount,
					issues = mods.Issues.Select(i => new { i.Severity, i.Title, i.Description })
				},
				ai = aiText,
				aiResult = aiResult == null ? null : new
				{
					ok = aiResult.Ok,
					status = aiResult.Status,
					confidence = aiResult.Confidence,
					summary = aiResult.Summary,
					causes = aiResult.Causes,
					actions = aiResult.Actions,
					warnings = aiResult.Warnings,
					missingInformation = aiResult.MissingInformation,
					errorCode = aiResult.ErrorCode
				},
				aiError = aiFailedMsg,
				// Phase 3C-2 P0 修复：aiDispatch 三元组完全来自服务端配置快照。
				// providerName/model 永不接受 URL 或请求 body；sentAtUtc 仅在服务端 SendAsync 入口被触发时填。
				aiDispatch = dispatchSentAtUtc == null ? null : new
				{
					providerName = resolvedProviderName,
					model = resolvedModel,
					sentAtUtc = dispatchSentAtUtc.Value.ToString("o")
				},
				configured,
				suspectMods = installedModFiles.Count == 0
					? AiDiagnoseService.ExtractSuspectModFileNames(aiText)
					: AiDiagnoseService.NormalizeSuspectModFileNames(AiDiagnoseService.ExtractSuspectModFileNames(aiText), installedModFiles)
			});
		}
		finally
		{
			try { operationCts.Cancel(); } catch { }
		}
	}

	/// <summary>
	/// 显式 cancel endpoint：客户端发送 POST /api/instances/{id}/diagnose/cancel，body 含 operationId。
	/// 服务端在 AiOps 注册表中查找并 cancel 对应 CTS。重复取消幂等；不存在的 operationId 也返回确定性结果，不泄露其他实例/operation。
	/// </summary>
	private static async Task HandleCancelDiagnoseAsync(HttpListenerRequest request, HttpListenerResponse response, string instanceId)
	{
		string operationId = string.Empty;
		try
		{
			JsonDocument body = await ReadBodyAsync(request);
			if (body.RootElement.TryGetProperty("operationId", out JsonElement op) && op.ValueKind == JsonValueKind.String)
			{
				operationId = op.GetString() ?? string.Empty;
			}
		}
		catch
		{
			// 无 body 时 operationId 仍为空字符串
		}

		bool cancelled = false;
		if (!string.IsNullOrEmpty(operationId))
		{
			cancelled = AiOps.Cancel(instanceId, operationId);
		}

		await WriteJsonAsync(response, 200, new
		{
			ok = true,
			operationId,
			cancelled,
			message = cancelled ? "cancelled" : "no_active_operation",
		});
	}

	/* ================= MR08：诊断报告（历史 / 导出） ================= */

	/// <summary>
	/// MR08：把一次诊断落成**冻结结构**的报告。只碰本地文件；历史写入失败不影响诊断结果。
	/// ReportId 直接用 operationId —— 同一操作只记录一次。
	/// </summary>
	private static async Task RecordDiagnosticReportAsync(
		AppConfig config, GameInstance instance, string operationId, DiagnosticSnapshot snapshot,
		CrashAnalysis rule, ModHealthReport mods, AiDiagnoseResult? aiResult, string? aiFailedMsg,
		DateTimeOffset? dispatchSentAtUtc, string providerName, string model, bool configured, bool localOnly,
		bool wasCancelled, string rawTail)
	{
		if (string.IsNullOrWhiteSpace(operationId))
		{
			return;
		}

		try
		{
			var counts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
			string San(string? text)
			{
				string redacted = DiagnosticRedactor.Redact(text, out Dictionary<string, int> local);
				foreach (KeyValuePair<string, int> kv in local)
				{
					counts[kv.Key] = counts.TryGetValue(kv.Key, out int prev) ? prev + kv.Value : kv.Value;
				}

				return redacted;
			}

			var report = new DiagnosticReport
			{
				ReportId = operationId,
				InstanceId = instance.Id,
				InstanceName = San(instance.Name),
				CreatedAt = DateTimeOffset.UtcNow,
				// 取消优先：取消时 AiDiagnoseService 往往只留下失败消息，不能记成 failed。
				Status = wasCancelled ? "cancelled"
					: (aiResult != null && !aiResult.Ok) ? "failed"
					: (aiResult == null && !string.IsNullOrWhiteSpace(aiFailedMsg)) ? "failed"
					: (!configured || localOnly) ? "rule_only"
					: "completed",
				Environment = new DiagnosticReportEnvironment
				{
					OperatingSystem = snapshot.Context.OperatingSystem,
					LauncherVersion = snapshot.Context.LauncherVersion,
					MinecraftVersion = snapshot.Context.MinecraftVersion,
					LoaderType = snapshot.Context.LoaderType,
					LoaderVersion = snapshot.Context.LoaderVersion,
					JavaVersion = snapshot.Context.JavaVersion,
					MaxMemoryMb = snapshot.Context.MaxMemoryMb,
					ExitCode = snapshot.Context.ExitCode,
					LogSource = snapshot.Context.LogSource,
					LogModifiedAt = snapshot.Context.LogModifiedAt
				}
			};

			report.RuleSummary = San(rule.Summary);
			report.RuleSuggestions = rule.Suggestions == null
				? new List<string>()
				: rule.Suggestions.Select(San).ToList();

			// fact / inference / unknown 分开呈现：与本项目 Phase 3C-1 的纪律一致。
			report.Facts.Add(San("规则引擎结论：" + rule.Summary));
			report.Facts.Add(San($"退出码 {snapshot.Context.ExitCode}，日志来源 {snapshot.Context.LogSource}"));
			report.Facts.Add($"加载器 {snapshot.Context.LoaderType} {snapshot.Context.LoaderVersion}，Minecraft {snapshot.Context.MinecraftVersion}");
			report.Facts.Add($"Mod：启用 {mods.EnabledCount} / 禁用 {mods.DisabledCount} / 在线管理 {mods.OnlineManagedCount}");
			foreach (var issue in mods.Issues)
			{
				report.Facts.Add(San($"[{issue.Severity}] {issue.Title}：{issue.Description}"));
			}

			if (aiResult != null)
			{
				foreach (AiDiagnoseCause cause in aiResult.Causes)
				{
					string line = San($"{cause.Title}：{cause.Description}（{cause.Kind}，置信度 {cause.Confidence:0.##}）");
					if (string.Equals(cause.Kind, "fact", StringComparison.OrdinalIgnoreCase))
					{
						report.Facts.Add(line);
					}
					else
					{
						report.Inferences.Add(line);
					}
				}

				foreach (string missing in aiResult.MissingInformation) report.Unknowns.Add(San(missing));
				foreach (string warning in aiResult.Warnings) report.Inferences.Add(San("警告：" + warning));

				report.Ai = new DiagnosticReportAi
				{
					Configured = configured,
					ProviderName = San(providerName),
					Model = San(model),
					SentAtUtc = dispatchSentAtUtc,
					Status = aiResult.Status,
					ErrorCode = aiResult.ErrorCode,
					Cancelled = string.Equals(aiResult.Status, "cancelled", StringComparison.OrdinalIgnoreCase),
					Confidence = aiResult.Confidence
				};

				// 只有已注册的安全动作才标 Safe（UI 也只给这些渲染按钮）；未知动作只留文字。
				report.Actions = aiResult.Actions.Select(a => new DiagnosticReportAction
				{
					Id = a.Id,
					Title = San(a.Title),
					Description = San(a.Description),
					Risk = a.Risk,
					Reversible = a.Reversible,
					Safe = string.Equals(a.ActionType, "disable_mod", StringComparison.OrdinalIgnoreCase)
				}).ToList();
			}
			else
			{
				report.Ai = new DiagnosticReportAi
				{
					Configured = configured,
					ProviderName = San(providerName),
					Model = San(model),
					SentAtUtc = dispatchSentAtUtc,
					Status = "not_run",
					Cancelled = false
				};

				if (!string.IsNullOrWhiteSpace(aiFailedMsg))
				{
					report.Unknowns.Add(San("AI 未给出结论：" + aiFailedMsg));
				}
			}

			foreach (string missing in snapshot.Context.MissingInformation) report.Unknowns.Add(San(missing));

			report.Summary = San(Truncate(
				rule.Summary + (aiResult == null || string.IsNullOrWhiteSpace(aiResult.Summary) ? string.Empty : " | " + aiResult.Summary),
				600));

			// 证据摘录默认不留存；只有用户显式开启才写入，且仍然是脱敏后的。
			report.KeptEvidence = config.DiagnosticKeepEvidence;
			report.EvidenceExcerpt = config.DiagnosticKeepEvidence
				? San(DiagnosticLogSanitizer.SelectEvidence(rawTail, 4000))
				: null;

			report.Redaction.Counts = counts;
			report.Redaction.TotalRedactions = counts.Values.Sum();

			await CreateDiagnosticStore().SaveAsync(report);
		}
		catch (Exception ex)
		{
			LauncherLog.Error("[Diagnose] 写入诊断报告失败（不影响诊断结果）：" + ex.Message, ex);
		}
	}

	private static string Truncate(string? text, int max)
	{
		if (string.IsNullOrEmpty(text))
		{
			return string.Empty;
		}

		return text.Length <= max ? text : text.Substring(0, max) + "…";
	}

	/// <summary>MR08：诊断历史列表（只读本地；超量/超期只提示，不自动删除）。</summary>
	private static async Task HandleDiagnoseHistoryAsync(HttpListenerResponse response, string instanceId)
	{
		AppConfig config = LoadConfig();
		RequireInstance(config, instanceId);

		DiagnosticReportHistory history = await CreateDiagnosticStore().ListAsync(instanceId);
		await WriteJsonAsync(response, 200, new
		{
			instanceId,
			limit = history.Limit,
			retentionDays = history.RetentionDays,
			overLimitCount = history.OverLimitCount,
			olderThanRetentionCount = history.OlderThanRetentionCount,
			notice = history.Notice,
			reports = history.Reports.Select(r => new
			{
				reportId = r.ReportId,
				createdAt = r.CreatedAt,
				status = r.Status,
				summary = r.Summary,
				aiConfigured = r.Ai.Configured,
				aiStatus = r.Ai.Status,
				providerName = r.Ai.ProviderName,
				model = r.Ai.Model,
				actionCount = r.Actions.Count,
				keptEvidence = r.KeptEvidence,
				redactionTotal = r.Redaction.TotalRedactions
			})
		});
	}

	/// <summary>MR08：导出一份报告（Markdown / JSON）。原始证据摘录需显式 includeEvidence=1。</summary>
	private static async Task HandleDiagnoseExportAsync(HttpListenerRequest request, HttpListenerResponse response, string instanceId)
	{
		AppConfig config = LoadConfig();
		RequireInstance(config, instanceId);

		string reportId = (request.QueryString["reportId"] ?? string.Empty).Trim();
		string format = (request.QueryString["format"] ?? "md").Trim().ToLowerInvariant();
		bool includeEvidence = (request.QueryString["includeEvidence"] ?? "0") == "1";
		if (string.IsNullOrWhiteSpace(reportId))
		{
			throw new InvalidOperationException("reportId 不能为空");
		}

		DiagnosticReport? report = await CreateDiagnosticStore().LoadAsync(instanceId, reportId);
		if (report == null)
		{
			throw new InvalidOperationException("诊断报告不存在：" + reportId);
		}

		string text = format == "json"
			? DiagnosticReportService.ExportJson(report, includeEvidence)
			: DiagnosticReportService.ExportMarkdown(report, includeEvidence);
		byte[] bytes = Encoding.UTF8.GetBytes(text);
		response.StatusCode = 200;
		response.ContentType = format == "json" ? "application/json; charset=utf-8" : "text/markdown; charset=utf-8";
		response.ContentLength64 = bytes.Length;
		await response.OutputStream.WriteAsync(bytes, 0, bytes.Length);
	}

	private static string ResolveJavaPath(AppConfig config, GameInstance instance, string minecraftVersion)
	{
		if (!string.IsNullOrWhiteSpace(instance.JavaPath))
		{
			return instance.JavaPath;
		}

		if (!string.IsNullOrWhiteSpace(config.JavaPath))
		{
			return config.JavaPath;
		}

		List<JavaInstallation> found = JavaLocator.ScanAsync(null).GetAwaiter().GetResult();
		JavaInstallation match = JavaLocator.MatchForMinecraftVersion(found, minecraftVersion);
		if (match != null)
		{
			return match.JavaPath;
		}

		JavaInfo any = JavaLocator.FindAsync().GetAwaiter().GetResult();
		if (any != null)
		{
			return any.Path;
		}

		throw new InvalidOperationException("未找到可用的 Java 运行时，请先在设置中指定 Java 路径");
	}

	private static string AppendJvmArgument(string existing, string argument)
	{
		return string.IsNullOrWhiteSpace(existing) ? argument.Trim() : existing.Trim() + " " + argument.Trim();
	}

	private static async Task HandleListSavesAsync(HttpListenerResponse response, string instanceId)
	{
		AppConfig config = LoadConfig();
		GameInstance instance = RequireInstance(config, instanceId);
		string gameDir = ResolveGameDirectory(config, instance);
		List<SaveInfo> saves = new SaveService(gameDir).GetSaves(instance);
		await WriteJsonAsync(response, 200, new
		{
			instanceId,
			gameDir,
			saves = saves.Select(s => new
			{
				s.FolderName,
				s.FullPath,
				s.DisplayName,
				s.LastPlayed,
				s.SizeText,
				s.HasIcon,
				icon = s.HasIcon && s.IconBytes != null ? "data:image/png;base64," + Convert.ToBase64String(s.IconBytes) : null
			})
		});
	}

	private static SaveInfo RequireSave(AppConfig config, string instanceId, string folderName)
	{
		GameInstance instance = RequireInstance(config, instanceId);
		string gameDir = ResolveGameDirectory(config, instance);
		return new SaveService(gameDir).GetSaves(instance).FirstOrDefault(x => x.FolderName == folderName)
			?? throw new InvalidOperationException("存档不存在：" + folderName);
	}

